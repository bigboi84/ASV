     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section section--flush-top\" data-el=\"vendors.archive\" data-el-build=\"plugin\">\n  <div class=\"hairline\" style=\"--min:280px\" data-stagger>\n    \n    <div class=\"cell\" style=\"min-height:290px\">\n      <div style=\"display:flex;align-items:center;gap:14px\"><div class=\"vendor-logo\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215710_51f5da1d-3713-4606-a00d-59c73e0e531c.png\" alt=\"AFSV VRC Official logo\" width=\"96\" height=\"96\" loading=\"lazy\"></div><span class=\"product-card__vendor\">In-house</span></div>\n      <h2 class=\"h3\" style=\"font-size:20px\">AFSV VRC Official</h2>\n      <p>Official district kit, equipment and program passes, sold directly by AFSV VRC.</p>\n      <dl class=\"vendor-dl\"><div><dt>Region</dt><dd>Whitby, Ontario</dd></div><div><dt>Sells</dt><dd>Apparel · Equipment · Programs</dd></div></dl>\n      <div class=\"cell__foot\" style=\"justify-content:space-between;padding-top:16px\"><span style=\"font-family:var(--font-display);font-weight:800;font-size:14px;text-transform:none;letter-spacing:0\">4 products</span><a class=\"text-link\" href=\"{{url:/shop/?vendor=AFSV%20VRC%20Official}}\">Visit store<span class=\"sr-only\">: AFSV VRC Official</span> <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"cell\" style=\"min-height:290px\">\n      <div style=\"display:flex;align-items:center;gap:14px\"><div class=\"vendor-logo\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215713_2d76ea6a-534d-44aa-8f0d-e432f83aaeae.png\" alt=\"Quietform Athletics logo\" width=\"96\" height=\"96\" loading=\"lazy\"></div><span class=\"product-card__vendor\">Neuro-inclusive specialist</span></div>\n      <h2 class=\"h3\" style=\"font-size:20px\">Quietform Athletics</h2>\n      <p>Sensory-considered sportswear and equipment developed with the Neurodiversity Access &amp; Opportunity program.</p>\n      <dl class=\"vendor-dl\"><div><dt>Region</dt><dd>Toronto, Ontario</dd></div><div><dt>Sells</dt><dd>Apparel · Inclusion</dd></div></dl>\n      <div class=\"cell__foot\" style=\"justify-content:space-between;padding-top:16px\"><span style=\"font-family:var(--font-display);font-weight:800;font-size:14px;text-transform:none;letter-spacing:0\">2 products</span><a class=\"text-link\" href=\"{{url:/shop/?vendor=Quietform%20Athletics}}\">Visit store<span class=\"sr-only\">: Quietform Athletics</span> <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"cell\" style=\"min-height:290px\">\n      <div style=\"display:flex;align-items:center;gap:14px\"><div class=\"vendor-logo\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215715_90a0d08b-d551-402b-a3ef-019ff759a90f.png\" alt=\"Northline Sport Supply logo\" width=\"96\" height=\"96\" loading=\"lazy\"></div><span class=\"product-card__vendor\">Equipment</span></div>\n      <h2 class=\"h3\" style=\"font-size:20px\">Northline Sport Supply</h2>\n      <p>Training and coaching equipment supplied to development-stream programs.</p>\n      <dl class=\"vendor-dl\"><div><dt>Region</dt><dd>Oshawa, Ontario</dd></div><div><dt>Sells</dt><dd>Equipment</dd></div></dl>\n      <div class=\"cell__foot\" style=\"justify-content:space-between;padding-top:16px\"><span style=\"font-family:var(--font-display);font-weight:800;font-size:14px;text-transform:none;letter-spacing:0\">3 products</span><a class=\"text-link\" href=\"{{url:/shop/?vendor=Northline%20Sport%20Supply}}\">Visit store<span class=\"sr-only\">: Northline Sport Supply</span> <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"cell\" style=\"min-height:290px\">\n      <div style=\"display:flex;align-items:center;gap:14px\"><div class=\"vendor-logo\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215716_6bef49ab-18ee-486d-be5b-89548670f810.png\" alt=\"Harbour Nutrition Co. logo\" width=\"96\" height=\"96\" loading=\"lazy\"></div><span class=\"product-card__vendor\">Nutrition</span></div>\n      <h2 class=\"h3\" style=\"font-size:20px\">Harbour Nutrition Co.</h2>\n      <p>Ontario-made recovery and nutrition products for adult program participants.</p>\n      <dl class=\"vendor-dl\"><div><dt>Region</dt><dd>Ajax, Ontario</dd></div><div><dt>Sells</dt><dd>Nutrition</dd></div></dl>\n      <div class=\"cell__foot\" style=\"justify-content:space-between;padding-top:16px\"><span style=\"font-family:var(--font-display);font-weight:800;font-size:14px;text-transform:none;letter-spacing:0\">1 product</span><a class=\"text-link\" href=\"{{url:/shop/?vendor=Harbour%20Nutrition%20Co.}}\">Visit store<span class=\"sr-only\">: Harbour Nutrition Co.</span> <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n  <div class=\"band--navy mt-l\" style=\"padding:44px 36px;display:grid;gap:32px;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));align-items:center\">\n    <div><h2 class=\"h2 h2--sm mb-s\">Sell with the district.</h2><p style=\"color:#E7E4DC;max-width:50ch\">Vendor applications, commission terms, payouts and verification are configured before the marketplace opens. Nothing is live yet.</p></div>\n    <div><a class=\"btn btn--gold\" href=\"{{url:/marketplace/#vendor-form}}\">Become a vendor<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n  </div>\n</section>"
