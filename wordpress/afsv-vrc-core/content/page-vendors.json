     "settings": {
      "html": "<section class=\"wrap\" style=\"padding-top:48px;padding-bottom:44px\">\n  <p class=\"eyebrow mb-s\">Marketplace — development preview</p>\n  <div class=\"split split--end\"><h1 class=\"h1 split-words\" aria-label=\"Vendors.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Vendors.</span></span></span></h1><p class=\"lead\">A multi-vendor marketplace: each vendor runs its own storefront, listings and fulfilment under AFSV VRC marketplace terms. All four below are sample vendors for build review.</p></div>\n</section>"
