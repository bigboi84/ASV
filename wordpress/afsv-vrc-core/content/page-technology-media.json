     "id": "dbc242d6",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Pathways.</h2><p class=\"body-lg muted\">Eleven pathways, each with its own progression and supervision requirements.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Esports</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Gaming</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Coding</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Digital media</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Content creation</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Broadcasting</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Podcasting</span></div><div class=\"cell\"><span class=\"num\">08</span><span>AI education</span></div><div class=\"cell\"><span class=\"num\">09</span><span>STEM workshops</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Sports technology</span></div><div class=\"cell\"><span class=\"num\">11</span><span>Entrepreneurship</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
