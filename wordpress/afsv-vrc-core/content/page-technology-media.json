    {
     "id": "09eb8017",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">Facility vision — conceptual.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Competition and production space</h3><p style=\"font-size:15.5px\">A room that can run a tournament and produce the coverage of it. Subject to final design and procurement.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Broadcast booth</h3><p style=\"font-size:15.5px\">Commentary and live coverage position for AFSV VRC programs. Conceptual — not built.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Podcast studio</h3><p style=\"font-size:15.5px\">Recording space for participant and community storytelling. Conceptual — not built.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Learning labs</h3><p style=\"font-size:15.5px\">Coding, STEM and AI education rooms. Equipment specification is not finalised.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
