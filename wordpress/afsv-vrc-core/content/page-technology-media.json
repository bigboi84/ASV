rue\">*</span></label>\n  <select id=\"f95\" name=\"interest\" aria-describedby=\"f95-err\" required aria-required=\"true\"><option value=\"\">Select one</option><option value=\"Technology partner\">Technology partner</option><option value=\"Esports organization\">Esports organization</option><option value=\"Media company\">Media company</option><option value=\"Digital sponsor\">Digital sponsor</option><option value=\"Player or creator\">Player or creator</option><option value=\"Other\">Other</option></select>\n  \n  <span class=\"field__error\" id=\"f95-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f96\">Message <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f96\" name=\"message\" aria-describedby=\"f96-err\" rows=\"4\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f96-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f91\"><input type=\"checkbox\" id=\"f91\" name=\"consent\" required aria-describedby=\"f91-err\"><span>I agree to be contacted about the EFN platform.<span class=\"field__error\" id=\"f91-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Submissions will route to the EFN team once confirmed.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Get in touch<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]}]}