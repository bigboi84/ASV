     "id": "d79cb126",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">Esports, Technology, Media &amp; Innovation</p>\n      <h1 class=\"h1 split-words\" aria-label=\"New Pathways to Create, Compete and Build\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">New</span></span> <span class=\"w\"><span style=\"--i:1\">Pathways</span></span> <span class=\"w\"><span style=\"--i:2\">to</span></span> <span class=\"w\"><span style=\"--i:3\">Create,</span></span> <span class=\"w\"><span style=\"--i:4\">Compete</span></span> <span class=\"w\"><span style=\"--i:5\">and</span></span> <span class=\"w\"><span style=\"--i:6\">Build</span></span></span></h1>\n      <p class=\"lead\">Not every participant connects with traditional sport. These pathways are intended to support social connection, skills, confidence, storytelling and career exploration.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"#interest\">Register Program Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/partners/}}\">Become a Technology Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/contact/}}\">Media Collaboration<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_223941_9a0290cd-d2b6-41d9-9325-052dbe6b61b8.mp4\" data-parallax=\"0.06\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215616_90815cca-2349-4ddd-9b38-b264231fdb9a.png\" alt=\"A broadcast production desk with a mixing console in the foreground and a row of competition stations behind, a young adult in headphones working at the desk.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
