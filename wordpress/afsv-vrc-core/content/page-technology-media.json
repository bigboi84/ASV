   "elements": [
    {
     "id": "e9c5200f",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Register program interest.</h2>\n      <p class=\"body-lg\">Separate routes for participants, technology partners and media collaboration.</p>\n      <p class=\"small muted\">Media and broadcast participation requires documented consent. For participants under 18, guardian consent and safeguarding checks apply before any recording.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:technology-media}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f100\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f100\" name=\"name\" aria-describedby=\"f100-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f100-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f101\">Organization <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f101\" name=\"organization\" aria-describedby=\"f101-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f101-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f102\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f102\" name=\"email\" aria-describedby=\"f102-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f102-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f103\">Age range or role<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f103\" name=\"age-range-or-role\" aria-describedby=\"f103-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 13\">Under 13</option><option value=\"13–17\">13–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option><option value=\"Parent or guardian\">Parent or guardian</option><option value=\"Educator\">Educator</option><option value=\"Partner organization\">Partner organization</option><option value=\"Media\">Media</option></select>\n  \n  <span class=\"field__error\" id=\"f103-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f104\">Pathways<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f104\" name=\"pathways\" aria-describedby=\"f104-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Esports\">Esports</option><option value=\"Gaming\">Gaming</option><option value=\"Coding\">Coding</option><option value=\"Digital media\">Digital media</option><option value=\"Content creation\">Content creation</option><option value=\"Broadcasting\">Broadcasting</option><option value=\"Podcasting\">Podcasting</option><option value=\"AI education\">AI education</option><option value=\"STEM workshops\">STEM workshops</option><option value=\"Sports technology\">Sports technology</option><option value=\"Entrepreneurship\">Entrepreneurship</option></select>\n  \n  <span class=\"field__error\" id=\"f104-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f105\">Skill level <span class=\"opt\">(optional)</span></label>\n  <select id=\"f105\" name=\"skill-level\" aria-describedby=\"f105-err\"><option value=\"\">Please select</option><option value=\"Beginner\">Beginner</option><option value=\"Some experience\">Some experience</option><option value=\"Advanced\">Advanced</option><option value=\"Prefer not to say\">Prefer not to say</option></select>\n  \n  <span class=\"field__error\" id=\"f105-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f106\">Interest type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f106\" name=\"interest-type\" aria-describedby=\"f106-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Program participation\">Program participation</option><option value=\"Technology partnership\">Technology partnership</option><option value=\"Media collaboration\">Media collaboration</option></select>\n  \n  <span class=\"field__error\" id=\"f106-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f107\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f107\" name=\"region\" aria-describedby=\"f107-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f107-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f108\">Accessibility needs <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f108\" name=\"accessibility-needs\" aria-describedby=\"f108-err\" rows=\"4\" placeholder=\"Optional\"></textarea>\n  \n  <span class=\"field__error\" id=\"f108-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f109\">Message <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f109\" name=\"message\" aria-describedby=\"f109-err\" rows=\"4\" placeholder=\"Anything else we should know\"></textarea>\n  \n  <span class=\"field__error\" id=\"f109-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f99\"><input type=\"checkbox\" id=\"f99\" name=\"consent\" required aria-describedby=\"f99-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f99-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
