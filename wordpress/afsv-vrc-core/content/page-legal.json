     "id": "2f7ae4fe",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"legal.gates\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">What each policy unlocks.</h2>\n  <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n    <div class=\"cell\" style=\"min-height:220px\"><span class=\"num\">01</span><h3 class=\"h3\">Booking and payment</h3><p style=\"font-size:15.5px\">Booking Terms, Cancellation and Refund Policy, and Waiver must be linked and acceptance capture tested.</p></div><div class=\"cell\" style=\"min-height:220px\"><span class=\"num\">02</span><h3 class=\"h3\">Membership purchase</h3><p style=\"font-size:15.5px\">Membership Terms, Privacy Policy and refund terms approved and linked.</p></div><div class=\"cell\" style=\"min-height:220px\"><span class=\"num\">03</span><h3 class=\"h3\">Marketplace checkout</h3><p style=\"font-size:15.5px\">Marketplace Terms, Vendor Terms and refund policy approved and linked.</p></div><div class=\"cell\" style=\"min-height:220px\"><span class=\"num\">04</span><h3 class=\"h3\">Sensitive data workflows</h3><p style=\"font-size:15.5px\">Privacy Policy and the approved secure process in place before any sensitive information is collected.</p></div>\n  </div>\n</section>"
     },
     "elements": []
    }
