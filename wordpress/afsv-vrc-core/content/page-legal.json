     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">All policy copy is pending authorized legal and executive approval. No legal language has been drafted or inferred. Booking, membership purchase, marketplace checkout, payment and sensitive-data workflows stay switched off until the applicable approved policy is linked and its acceptance capture has been tested.</p></section>"
     },
