     "id": "877a07c3",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">Legal &amp; Policy</p>\n      <h1 class=\"h1 split-words\" aria-label=\"Website Policies and Legal Notices\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Website</span></span> <span class=\"w\"><span style=\"--i:1\">Policies</span></span> <span class=\"w\"><span style=\"--i:2\">and</span></span> <span class=\"w\"><span style=\"--i:3\">Legal</span></span> <span class=\"w\"><span style=\"--i:4\">Notices</span></span></span></h1>\n      <p class=\"lead\">Every policy this site needs, listed with its current approval status. All policy copy is pending authorized legal and executive approval, and none of it is drafted here.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/contact/}}\">Contact Us About These Policies<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/accessibility-privacy/}}\">Accessibility Support<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-parallax=\"0.06\"><img src=\"{{asset:img/quiet-room.jpg}}\" alt=\"A calm, sensory-considered quiet room with acoustic wall panelling, dimmed warm lighting and a low bench with over-ear defenders resting on it.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
