     "id": "4e5df32b",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"legal.slots\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-l reveal\">Required policies.</h2>\n  <div class=\"policy-table\" role=\"table\" aria-label=\"Required policies and status\">\n    <div class=\"policy-table__row\" role=\"row\"><span role=\"columnheader\">No.</span><span role=\"columnheader\">Policy</span><span role=\"columnheader\">Scope</span><span role=\"columnheader\">Status</span></div>\n    <div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">01</span><span class=\"policy-table__name\" role=\"cell\">Privacy Policy</span><span class=\"small\" role=\"cell\">Site-wide</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">02</span><span class=\"policy-table__name\" role=\"cell\">Terms of Use</span><span class=\"small\" role=\"cell\">Site-wide</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">03</span><span class=\"policy-table__name\" role=\"cell\">Accessibility Statement</span><span class=\"small\" role=\"cell\">Site-wide</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">04</span><span class=\"policy-table__name\" role=\"cell\">Cookie Notice and Preferences</span><span class=\"small\" role=\"cell\">Site-wide</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">05</span><span class=\"policy-table__name\" role=\"cell\">Cancellation and Refund Policy</span><span class=\"small\" role=\"cell\">Booking, membership, marketplace</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">06</span><span class=\"policy-table__name\" role=\"cell\">Booking Terms</span><span class=\"small\" role=\"cell\">book.afsvvrc.com</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">07</span><span class=\"policy-table__name\" role=\"cell\">Membership Terms</span><span class=\"small\" role=\"cell\">Membership</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">08</span><span class=\"policy-table__name\" role=\"cell\">Marketplace Terms</span><span class=\"small\" role=\"cell\">Marketplace</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">09</span><span class=\"policy-table__name\" role=\"cell\">Vendor Terms</span><span class=\"small\" role=\"cell\">Marketplace vendors</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">10</span><span class=\"policy-table__name\" role=\"cell\">Waiver and Assumption of Risk</span><span class=\"small\" role=\"cell\">Programs and facilities</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">11</span><span class=\"policy-table__name\" role=\"cell\">Safeguarding and Child Protection</span><span class=\"small\" role=\"cell\">Programs, stories, media</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div><div class=\"policy-table__row\" role=\"row\"><span class=\"num\" role=\"cell\">12</span><span class=\"policy-table__name\" role=\"cell\">Copyright and Trademark Notice</span><span class=\"small\" role=\"cell\">Site-wide</span><span role=\"cell\"><span class=\"pill pill--soft\">Pending approval</span></span></div>\n  </div>\n</section>"
