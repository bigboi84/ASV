{"slug":"news-impact","parent":"","title":"News, Stories & Impact","description":"A controlled publishing framework for AFSV VRC updates, stories, approved milestones and verified impact.","chrome":"default","front":false,"elements":[{"id":"463a62b7","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"ae37ecf1","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li><a href=\"{{url:/about/}}\">About</a></li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">News, Stories &amp; Impact</li></ol></nav>"},"elements":[]}]},{"id":"908bfd3f","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"860ed237","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">News, Stories &amp; Impact</p>\n      <h1 class=\"h1 split-words\" aria-label=\"Progress, People and Community Impact\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Progress,</span></span> <span class=\"w\"><span style=\"--i:1\">People</span></span> <span class=\"w\"><span style=\"--i:2\">and</span></span> <span class=\"w\"><span style=\"--i:3\">Community</span></span> <span class=\"w\"><span style=\"--i:4\">Impact</span></span></span></h1>\n      <p class=\"lead\">A controlled publishing framework for updates, stories, approved milestones and verified impact. Nothing is published without editorial approval, and nothing about a person is published without their documented consent.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"#updates\">Read Updates<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"#story\">Share a Story<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/partners/}}\">Partner With Us<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-parallax=\"0.06\"><img src=\"{{asset:img/life/academy.jpg}}\" alt=\"Concept rendering: racially diverse boys and girls doing passing drills at night inside the dome while parents watch.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"},"elements":[]}]},{"id":"c47c117e","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"a1a5b849","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">Consent is mandatory for stories, photographs, testimonials and identifying information, with enhanced safeguards for minors and vulnerable people. Sharing a story below is an expression of interest and a consent to be contacted — it is not publication consent. Editorial approval and formal media releases happen separately.</p></section>"},"elements":[]}]},{"id":"3f3e35e0","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"news.event","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"11c11a60","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section event-section\" data-el=\"news.event\" data-el-build=\"custom-widget\">\n  <div class=\"section-head reveal\"><p class=\"eyebrow mb-s\">Latest news</p><h2 class=\"h2\">Upcoming event.</h2><p class=\"body-lg muted\">The GAISB AI World Summit 2027, hosted in the Caribbean by AFSV VRC. <a class=\"text-link\" href=\"{{url:/events/}}\">All events <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></p></div>\n  \n<article class=\"event event--gaisb\" data-el=\"news.event-card\" data-el-build=\"custom-widget\">\n  <div class=\"event__date\" aria-hidden=\"true\">\n    <span class=\"event__day\">29</span>\n    <span class=\"event__month\">Apr</span>\n    <span class=\"event__end\">– 1 May 2027</span>\n  </div>\n  <div class=\"event__main\">\n    <p class=\"event__wordmark\"><small>Port of Spain, Trinidad &amp; Tobago · April 29 – May 1, 2027</small></p>\n    <h3 class=\"event__title\"><a href=\"https://gaisb.ai/port-of-spain.html\" target=\"_blank\" rel=\"noopener noreferrer\">GAISB AI World Summit 2027<span class=\"sr-only\"> (opens the summit website in a new tab)</span></a></h3>\n    <p class=\"event__headline\"><span>AI is moving money.</span> The rules are being written now.</p>\n    <ul class=\"event__themes\"><li>Work</li><li>Wealth</li><li>Security</li><li>Nations</li><li>Humanity</li></ul>\n    <p class=\"event__summary\">AI is joining the workforce. Money is going digital. AI agents now connect the two. Three days in Port of Spain for the people shaping what comes next: CEOs and executives, governments and regulators, financial professionals, investors and builders.</p>\n    <p class=\"event__where\"><strong>April 29 – May 1, 2027</strong> · Hyatt Regency Trinidad, Port of Spain, Trinidad &amp; Tobago</p>\n    <div class=\"btn-row btn-row--stack\">\n      <a class=\"btn btn--gold event__cta\" href=\"https://gaisb.ai/port-of-spain.html\" target=\"_blank\" rel=\"noopener noreferrer\">Secure your place<span class=\"sr-only\"> (opens the summit website in a new tab)</span><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></a>\n      <a class=\"btn btn--line-light event__cta2\" href=\"https://gaisb.ai/port-of-spain.html\" target=\"_blank\" rel=\"noopener noreferrer\">See the agenda<span class=\"sr-only\"> (opens in a new tab)</span><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></a>\n    </div>\n    <p class=\"event__host\">Hosted in the Caribbean by AFSV VRC Global Development Group Ltd., Canada.</p>\n  </div>\n  <aside class=\"event__side\">\n    <p class=\"event__side-label\">Summit opens in</p>\n    <div class=\"countdown\" data-countdown=\"2027-04-29T09:00:00-04:00\" role=\"timer\" aria-label=\"Countdown to GAISB AI World Summit 2027\">\n      <div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"days\">--</span><span class=\"countdown__label\">Days</span></div><div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"hours\">--</span><span class=\"countdown__label\">Hours</span></div><div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"mins\">--</span><span class=\"countdown__label\">Minutes</span></div><div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"secs\">--</span><span class=\"countdown__label\">Seconds</span></div>\n    </div>\n    <dl class=\"event__facts\"><div><dt>3 days</dt><dd>of keynotes, roundtables and sessions</dd></div><div><dt>50+</dt><dd>countries expected among delegates</dd></div><div><dt>Jan 31, 2027</dt><dd>speaker submissions close</dd></div></dl>\n  </aside>\n</article>\n</section>"},"elements":[]}]},{"id":"5518ab7e","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"news.types","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"ed148867","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" id=\"updates\" data-el=\"news.types\" data-el-build=\"custom-widget\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Content types.</h2><p class=\"body-lg muted\">Ten types, each with its own review path. The archive is empty until the first entry is approved — no sample stories are published here.</p></div>\n  <div class=\"hairline list-cells\" data-stagger>\n    <div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">01</span><span class=\"pill pill--soft\">Draft</span></div><span>Project updates</