h2 mb-m\">Partner directory.</h2><p class=\"body-lg mb-s measure-sm\">Architecture for approved partner profiles, organised by category. The directory stays empty until each profile is approved and its logo permission is on file.</p><p class=\"small muted\">No profile is auto-published. No logo appears without written permission.</p></div>\n    <div><h3 class=\"eyebrow mb-m\" style=\"color:var(--gold-mid)\">Fields per profile</h3><ul class=\"tags\"><li>Logo</li><li>Name</li><li>Description</li><li>Services</li><li>URL</li><li>Geography</li><li>Relationship</li><li>Inclusion contribution</li></ul></div>\n  </div>\n</section>"},"elements":[]}]},{"id":"6ad08172","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"news.impact","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"3708db76","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"news.impact\" data-el-build=\"custom-widget\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\"><h2 class=\"h2\">Impact dashboard.</h2><p class=\"body-lg\" style=\"color:#E7E4DC\">Future architecture. Every figure below stays blank until it is verified, and projections will be labelled as projections rather than shown as results.</p></div>\n    <div class=\"hairline\" style=\"--min:240px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Individuals and families supported<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Subsidized program hours<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Inclusive sport hours<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Education hours<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Placements<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Internships<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Employers<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Providers<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Partners<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Value of subsidized and in-kind services<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div><div class=\"cell\" style=\"min-height:150px;gap:12px\"><span class=\"metric__value\" aria-hidden=\"true\">—</span><span class=\"metric__label\">Access Fund contributions<span class=\"sr-only\">: not yet verified</span></span><span class=\"metric__state\" aria-hidden=\"true\">Not yet verified</span></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"c8bd8230","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"8b8e8eea","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section \" id=\"story\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Share a story.</h2>\n      <p class=\"body-lg\">If something worth telling has happened, tell us about it and we will come back to you about whether and how it could be published.</p>\n      <p class=\"small muted\">This is consent to be contacted, not consent to publish. Publication requires a separate signed media release, and stories involving minors require guardian consent and safeguarding review. Please do not include other people’s identifying details.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f204\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f204\" name=\"contact-name\" aria-describedby=\"f204-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f204-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f205\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f205\" name=\"email\" aria-describedby=\"f205-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f205-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f206\">Story type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f206\" name=\"story-type\" aria-describedby=\"f206-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Participant story\">Participant story</option><option value=\"Family story\">Family story</option><option value=\"Employer story\">Employer story</option><option value=\"Athlete mentor\">Athlete mentor</option><option value=\"Community partner\">Community partner</option><option value=\"Education success\">Education success</option><option value=\"Employment success\">Employment success</option><option value=\"Project update\">Project update</option></select>\n  \n  <span class=\"field__error\" id=\"f206-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f207\">Your relationship to the story<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f207\" name=\"your-relationship-to-the-story\" aria-describedby=\"f207-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"I am the subject\">I am the subject</option><option value=\"Parent or guardian\">Parent or guardian</option><option value=\"Carer or support worker\">Carer or support worker</option><option value=\"Employer\">Employer</option><option value=\"Partner organization\">Partner organization</option><option value=\"Staff or coach\">Staff or coach</option></select>\n  \n  <span class=\"field__error\" id=\"f207-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f208\">Brief description<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f208\" name=\"brief-description\" aria-describedby=\"f208-err\" required aria-required=\"true\" rows=\"4\" placeholder=\"A few lines — please do not include anyone else’s identifying details\"></textarea>\n  \n  <span class=\"field__error\" id=\"f208-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f203\"><input type=\"checkbox\" id=\"f203\" name=\"consent\" required aria-describedby=\"f203-err\"><span>I agree to be contacted about this story. I understand this is not publication consent.<span class=\"field__error\" id=\"f203-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Send story interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"87a63a83","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"7d5e6bb0","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Partners and sponsors appear here only once approved.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/partners/}}\">Partner with us<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}