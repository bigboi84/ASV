     "id": "033107d3",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" id=\"updates\" data-el=\"news.types\" data-el-build=\"custom-widget\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Content types.</h2><p class=\"body-lg muted\">Ten types, each with its own review path. The archive is empty until the first entry is approved — no sample stories are published here.</p></div>\n  <div class=\"hairline list-cells\" data-stagger>\n    <div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">01</span><span class=\"pill pill--soft\">Draft</span></div><span>Project updates</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">02</span><span class=\"pill pill--soft\">Draft</span></div><span>Participant stories</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">03</span><span class=\"pill pill--soft\">Draft</span></div><span>Family stories</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">04</span><span class=\"pill pill--soft\">Draft</span></div><span>Employer stories</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">05</span><span class=\"pill pill--soft\">Draft</span></div><span>Athlete mentors</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">06</span><span class=\"pill pill--soft\">Draft</span></div><span>Community partners</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">07</span><span class=\"pill pill--soft\">Draft</span></div><span>Education success</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">08</span><span class=\"pill pill--soft\">Draft</span></div><span>Employment success</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">09</span><span class=\"pill pill--soft\">Draft</span></div><span>Approved media releases</span></div><div class=\"cell\"><div class=\"cell__top\"><span class=\"num\">10</span><span class=\"pill pill--soft\">Draft</span></div><span>Events</span></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
