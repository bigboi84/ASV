     "id": "792213a5",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Planned services.</h2><p class=\"body-lg muted\">Twelve areas of planned academic support.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Tutoring</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Literacy</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Mathematics</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Academic coaching</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Study skills</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Executive-function coaching</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Homework support</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Technology-assisted learning</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Career exploration</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Mentorship</span></div><div class=\"cell\"><span class=\"num\">11</span><span>Digital literacy</span></div><div class=\"cell\"><span class=\"num\">12</span><span>Financial literacy</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
  {
