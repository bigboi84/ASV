{"slug":"education","parent":"","title":"Education & Academic Success","description":"AFSV VRC is developing academic support intended to help young people develop academically as well as physically and socially.","chrome":"default","front":false,"elements":[{"id":"551345d9","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"a9cb9af2","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Programs</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Education &amp; Academic Success</li></ol></nav>"},"elements":[]}]},{"id":"3e39cfbf","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"10c39f0e","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/whitby/learn.jpg}}\" alt=\"Concept rendering: students and mentors working together in a warm learning centre with floodlit fields outside.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Education &amp; Academic Success</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Learning That Builds Confidence and Capability\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Learning</span></span> <span class=\"w\"><span style=\"--i:1\">That</span></span> <span class=\"w\"><span style=\"--i:2\">Builds</span></span> <span class=\"w\"><span style=\"--i:3\">Confidence</span></span> <span class=\"w\"><span style=\"--i:4\">and</span></span> <span class=\"w\"><span style=\"--i:5\">Capability</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC is developing academic support intended to help young people develop academically as well as physically and socially.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Keep Up to Date<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/partners/}}\">Become an Education Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/contact/}}\">Educator / Tutor Inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"049df4fe","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"602b0c43","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">No tutoring service, diagnostic assessment, regulated support, named provider, curriculum approval or school partnership is live. Nothing here should be read as an available service.</p></section>"},"elements":[]}]},{"id":"a85271be","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1441eac5","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Planned services.</h2><p class=\"body-lg muted\">Twelve areas of planned academic support.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Tutoring</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Literacy</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Mathematics</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Academic coaching</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Study skills</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Executive-function coaching</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Homework support</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Technology-assisted learning</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Career exploration</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Mentorship</span></div><div class=\"cell\"><span class=\"num\">11</span><span>Digital literacy</span></div><div class=\"cell\"><span class=\"num\">12</span><span>Financial literacy</span></div></div>\n</section>"},"elements":[]}]},{"id":"43fdfc2c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"9f008ea7","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">How support is intended to work.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Alongside training</h3><p style=\"font-size:15.5px\">Study time sits inside the program schedule rather than competing with it, so participants are not choosing between the two.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Shared reporting</h3><p style=\"font-size:15.5px\">Where a school partnership is in place, coaches and educators work from the same progress information — with consent.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">No clinical claims</h3><p style=\"font-size:15.5px\">Academic coaching is not assessment, diagnosis or regulated therapeutic support, and is never described as such.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Data minimisation</h3><p style=\"font-size:15.5px\">Public forms ask for the least information needed. Anything sensitive moves to an approved secure process later.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"15eaf1fc","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-secondary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"eb7c8163","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Audiences.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Five routes, kept separate so families and institutions are not funnelled into one inbox.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Learners and families</span></li><li><span class=\"num\">02</span><span>Educators and tutors</span></li><li><span class=\"num\">03</span><span>Schools and colleges</span></li><li><span class=\"num\">04</span><span>Sponsors</span></li><li><span class=\"num\">05</span><span>Community organizations</span></li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"91d21f66","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"education.mlmsr","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"4c45c3d9","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"education.mlmsr\" data-el-build=\"elementor\">\n  \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">MLMSR Mentorship LLC</p>\n    <h2 class=\"h2\">Proposed education &amp; support programs.</h2>\n    <p class=\"body-lg muted\">Through MLMSR Mentorship LLC, AFSVHCL™ integrates academic support, mentorship and neurodivergent programming into every aspect of the proposed village.</p>\n  </div>\n  \n  <div class=\"kgrid kgrid--3\" data-stagger>\n    <article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M9.4 4.2a3.4 3.4 0 0 0-3.4 3.2 3.2 3.2 0 0 0-1.6 5.6 3.4 3.4 0 0 0 3 4.8 3 3 0 0 0 4.6 1.6V5.6a2.6 2.6 0 0 0-2.6-1.4z\"/><path d=\"M14.6 4.2A3.4 3.4 0 0 1 18 7.4a3.2 3.2 0 0 1 1.6 5.6 3.4 3.4 0 0 1-3 4.8 3 3 0 0 1-4.6 1.6\"/><path d=\"M9 10.2c1 .2 1.8.9 2.1 1.8M15 10.2c-1 .2-1.8.9-2.1 1.8\"/></svg></span>\n      <h3>Autism Spectrum Support</h3>\n      <p>Structured programs integrating physical activity with social skills development and sensory-friendly environments.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"14.6\" cy=\"4.6\" r=\"1.8\"/><path d=\"M8.2 9.6l3.4-2 3 1.8 2 3.2 2.6.6\"/><path d=\"M11.6 7.6l-1.4 5.6 3.2 2.6-.8 5\"/><path d=\"M10.2 13.2l-2.6 3.4-3.6-.4\"/><path d=\"M2.6 21h6M15.6 21h5.8\"/></svg></span>\n      <h3>ADHD Strategies</h3>\n      <p>Focused training environments and mentorship tailored for athletes with ADHD — channelling energy into achievement and growth.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 6.6C9.8 5 6.6 4.6 3.4 5v13.4c3.2-.4 6.4 0 8.6 1.6 2.2-1.6 5.4-2 8.6-1.6V5c-3.2-.4-6.4 0-8.6 1.6z\"/><path d=\"M12 6.6v13.4\"/><path d=\"M15.8 10.4c.6-1 2.4-.8 2.4.6 0 1.2-2.4 2.6-2.4 2.6s-2.4-1.4-2.4-2.6c0-1.4 1.8-1.6 2.4-.6z\"/></svg></span>\n      <h3>Dyslexia &amp; Learning Support</h3>\n      <p>Academic support and alternative learning methods for athletes with reading challenges and learning differences.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"6.4\" r=\"2.4\"/><circle cx=\"5.4\" cy=\"9.4\" r=\"2\"/><circle cx=\"18.6\" cy=\"9.4\" r=\"2\"/><path d=\"M7.6 20.4v-2.6a4.4 4.4 0 0 1 8.8 0v2.6\"/><path d=\"M2.2 18.4v-1a3.2 3.2 0 0 1 4.8-2.8M21.8 18.4v-1a3.2 3.2 0 0 0-4.8-2.8\"/></svg></span>\n      <h3>Family Support Resources</h3>\n      <p>Resources and counselling for families navigating neurodivergent challenges — supporting the whole family.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"8.4\" cy=\"6.2\" r=\"2.6\"/><circle cx=\"16.6\" cy=\"9.4\" r=\"2\"/><path d=\"M3.6 20.4v-3.2a4.8 4.8 0 0 1 9.6 0v3.2\"/><path d=\"M13 15.2a3.6 3.6 0 0 1 7.2 1.2v4\"/><path d=\"M11.2 12.4l2.6.8\"/></svg></span>\n      <h3>Mentorship &amp; Leadership</h3>\n      <p>One-on-one and group mentorship connecting youth athletes with community leaders, coaches and role models.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M9 17.4h6M9.6 20.4h4.8\"/><path d=\"M12 3.2a6 6 0 0 0-3.6 10.8c.6.5.9 1.1.9 1.9v1.5h5.4v-1.5c0-.8.3-1.4.9-1.9A6 6 0 0 0 12 3.2z\"/><path d=\"M12 7.2v3.6l2-1.2\"/></svg></span>\n      <h3>Academic Integration</h3>\n      <p>Proposed classroom and tutoring spaces within the dome — academic success alongside athletic development.</p>\n      \n    </article>\n  </div>\n</section>"},"elements":[]}]},{"id":"f75fa845","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"education.need","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"abbce4e4","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"education.need\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\"><p class=\"eyebrow mb-s\">The need is real</p><h2 class=\"h2\">Why inclusion matters.</h2></div>\n    <div class=\"need\" data-stagger>\n      <div><b>1 in 5</b><h3>Children in Canada are neurodivergent</h3><p>Autism, ADHD, dyslexia and other learning differences affect millions of Canadian families.</p></div>\n      <div><b>Millions</b><h3>Families across Canada need support</h3><p>Neurodivergent youth and families in every province need accessible, integrated programming.</p></div>\n      <div><b>Thousands</b><h3>Youth athletes underserved</h3><p>Young athletes who would benefit from integrated sports and education programming.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"567d8620","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"0f6c605b","elType":"widget","widgetType":"html","settings":{"html":"<section data-form-id=\"education-interest\" class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Keep up to date on learning programs.</h2>\n      <p class=\"body-lg\">For families, learners, educators and institutions. Tell us which route applies.</p>\n      <p class=\"small muted\">We do not ask for diagnoses, assessments or medical records. Accommodation requests are optional.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f72\">Name or caregiver name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f72\" name=\"name-or-caregiver-name\" aria-describedby=\"f72-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f72-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f73\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f73\" name=\"email\" aria-describedby=\"f73-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f73-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f74\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f74\" name=\"phone\" aria-describedby=\"f74-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f74-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f75\">Learner age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f75\" name=\"learner-age-range\" aria-describedby=\"f75-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option></select>\n  \n  <span class=\"field__error\" id=\"f75-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f76\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f76\" name=\"region\" aria-describedby=\"f76-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f76-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f77\">Areas of interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f77\" name=\"areas-of-interest\" aria-describedby=\"f77-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Tutoring\">Tutoring</option><option value=\"Literacy\">Literacy</option><option value=\"Mathematics\">Mathematics</option><option value=\"Academic coaching\">Academic coaching</option><option value=\"Study skills\">Study skills</option><option value=\"Executive-function coaching\">Executive-function coaching</option><option value=\"Homework support\">Homework support</option><option value=\"Technology-assisted learning\">Technology-assisted learning</option><option value=\"Career exploration\">Career exploration</option><option value=\"Mentorship\">Mentorship</option><option value=\"Digital literacy\">Digital literacy</option><option value=\"Financial literacy\">Financial literacy</option></select>\n  \n  <span class=\"field__error\" id=\"f77-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f78\">Preferred format <span class=\"opt\">(optional)</span></label>\n  <select id=\"f78\" name=\"preferred-format\" aria-describedby=\"f78-err\"><option value=\"\">Please select</option><option value=\"In person\">In person</option><option value=\"Virtual\">Virtual</option><option value=\"Either\">Either</option></select>\n  \n  <span class=\"field__error\" id=\"f78-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f79\">Organization, if applicable <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f79\" name=\"organization-if-applicable\" aria-describedby=\"f79-err\" placeholder=\"School, college or community organization\">\n  \n  <span class=\"field__error\" id=\"f79-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f80\">Accommodation request <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f80\" name=\"accommodation-request\" aria-describedby=\"f80-err\" rows=\"4\" placeholder=\"Optional — anything that would help us respond well\"></textarea>\n  \n  <span class=\"field__error\" id=\"f80-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f71\"><input type=\"checkbox\" id=\"f71\" name=\"consent\" required aria-describedby=\"f71-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f71-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"c5b4a210","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.pending-inputs","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"722b829d","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.pending-inputs\" data-el-build=\"elementor\" style=\"padding-bottom:88px\">\n  <div class=\"pending\"><span class=\"eyebrow\">Pending inputs</span>\n    <p>Page copy follows the approved brief. Still outstanding: final photography, approved logos and partner permissions, mailbox routing, legal policies, operational program data, pricing, dates and a named content owner.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"4ada7648","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"36eb84e9","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Schools, colleges and tutors have their own route.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/contact/}}\">Talk about a partnership<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}