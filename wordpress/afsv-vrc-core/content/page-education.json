    {
     "id": "d11c88f4",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Audiences.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Five routes, kept separate so families and institutions are not funnelled into one inbox.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Learners and families</span></li><li><span class=\"num\">02</span><span>Educators and tutors</span></li><li><span class=\"num\">03</span><span>Schools and colleges</span></li><li><span class=\"num\">04</span><span>Sponsors</span></li><li><span class=\"num\">05</span><span>Community organizations</span></li></ul>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
