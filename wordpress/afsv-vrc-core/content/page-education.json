    {
     "id": "8d6e8b01",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Register learning interest.</h2>\n      <p class=\"body-lg\">For families, learners, educators and institutions. Tell us which route applies.</p>\n      <p class=\"small muted\">We do not ask for diagnoses, assessments or medical records. Accommodation requests are optional.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:education}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f80\">Name or caregiver name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f80\" name=\"name-or-caregiver-name\" aria-describedby=\"f80-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f80-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f81\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f81\" name=\"email\" aria-describedby=\"f81-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f81-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f82\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f82\" name=\"phone\" aria-describedby=\"f82-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f82-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f83\">Learner age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f83\" name=\"learner-age-range\" aria-describedby=\"f83-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option></select>\n  \n  <span class=\"field__error\" id=\"f83-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f84\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f84\" name=\"region\" aria-describedby=\"f84-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f84-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f85\">Areas of interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f85\" name=\"areas-of-interest\" aria-describedby=\"f85-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Tutoring\">Tutoring</option><option value=\"Literacy\">Literacy</option><option value=\"Mathematics\">Mathematics</option><option value=\"Academic coaching\">Academic coaching</option><option value=\"Study skills\">Study skills</option><option value=\"Executive-function coaching\">Executive-function coaching</option><option value=\"Homework support\">Homework support</option><option value=\"Technology-assisted learning\">Technology-assisted learning</option><option value=\"Career exploration\">Career exploration</option><option value=\"Mentorship\">Mentorship</option><option value=\"Digital literacy\">Digital literacy</option><option value=\"Financial literacy\">Financial literacy</option></select>\n  \n  <span class=\"field__error\" id=\"f85-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f86\">Preferred format <span class=\"opt\">(optional)</span></label>\n  <select id=\"f86\" name=\"preferred-format\" aria-describedby=\"f86-err\"><option value=\"\">Please select</option><option value=\"In person\">In person</option><option value=\"Virtual\">Virtual</option><option value=\"Either\">Either</option></select>\n  \n  <span class=\"field__error\" id=\"f86-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f87\">Organization, if applicable <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f87\" name=\"organization-if-applicable\" aria-describedby=\"f87-err\" placeholder=\"School, college or community organization\">\n  \n  <span class=\"field__error\" id=\"f87-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f88\">Accommodation request <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f88\" name=\"accommodation-request\" aria-describedby=\"f88-err\" rows=\"4\" placeholder=\"Optional — anything that would help us respond well\"></textarea>\n  \n  <span class=\"field__error\" id=\"f88-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f79\"><input type=\"checkbox\" id=\"f79\" name=\"consent\" required aria-describedby=\"f79-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f79-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
