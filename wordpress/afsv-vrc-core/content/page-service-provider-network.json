   "elements": [
    {
     "id": "07f26128",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Register provider interest.</h2>\n      <p class=\"body-lg\">This is an application to be reviewed, not a listing request.</p>\n      <p class=\"small muted\">Licence and registration fields are conditional on regulated profession. Do not attach client records or identifying participant information.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:service-provider-network}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f146\">Organization<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f146\" name=\"organization\" aria-describedby=\"f146-err\" required aria-required=\"true\" placeholder=\"Practice or organization name\">\n  \n  <span class=\"field__error\" id=\"f146-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f147\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f147\" name=\"contact-name\" aria-describedby=\"f147-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f147-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f148\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f148\" name=\"email\" aria-describedby=\"f148-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f148-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f149\">Telephone<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"tel\" id=\"f149\" name=\"telephone\" aria-describedby=\"f149-err\" required aria-required=\"true\" placeholder=\"Contact number\">\n  \n  <span class=\"field__error\" id=\"f149-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f150\">Website <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f150\" name=\"website\" aria-describedby=\"f150-err\" placeholder=\"https://\">\n  \n  <span class=\"field__error\" id=\"f150-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f151\">Service type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f151\" name=\"service-type\" aria-describedby=\"f151-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Occupational therapy\">Occupational therapy</option><option value=\"Speech and language\">Speech and language</option><option value=\"Behavioural services\">Behavioural services</option><option value=\"Counselling and mental health\">Counselling and mental health</option><option value=\"Executive function\">Executive function</option><option value=\"Academic intervention\">Academic intervention</option><option value=\"Family education\">Family education</option><option value=\"Service navigation\">Service navigation</option><option value=\"Social development\">Social development</option><option value=\"Adaptive and inclusive sport\">Adaptive and inclusive sport</option></select>\n  \n  <span class=\"field__error\" id=\"f151-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f152\">Regulated profession<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f152\" name=\"regulated-profession\" aria-describedby=\"f152-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Yes\">Yes</option><option value=\"No\">No</option><option value=\"Unsure\">Unsure</option></select>\n  \n  <span class=\"field__error\" id=\"f152-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f153\">Licence or registration <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f153\" name=\"licence-or-registration\" aria-describedby=\"f153-err\" placeholder=\"Required if regulated\">\n  \n  <span class=\"field__error\" id=\"f153-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f154\">Qualifications <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f154\" name=\"qualifications\" aria-describedby=\"f154-err\" rows=\"4\" placeholder=\"Relevant qualifications and bodies\"></textarea>\n  \n  <span class=\"field__error\" id=\"f154-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f155\">Age groups served<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f155\" name=\"age-groups-served\" aria-describedby=\"f155-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option><option value=\"All ages\">All ages</option></select>\n  \n  <span class=\"field__error\" id=\"f155-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f156\">Specialization <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f156\" name=\"specialization\" aria-describedby=\"f156-err\" placeholder=\"Primary area of practice\">\n  \n  <span class=\"field__error\" id=\"f156-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f157\">Current capacity<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f157\" name=\"current-capacity\" aria-describedby=\"f157-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Accepting referrals\">Accepting referrals</option><option value=\"Limited capacity\">Limited capacity</option><option value=\"Waitlist only\">Waitlist only</option><option value=\"Not currently\">Not currently</option></select>\n  \n  <span class=\"field__error\" id=\"f157-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f158\">Accessibility experience <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f158\" name=\"accessibility-experience\" aria-describedby=\"f158-err\" rows=\"4\" placeholder=\"Experience working with neurodivergent people\"></textarea>\n  \n  <span class=\"field__error\" id=\"f158-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f159\">Insurance<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f159\" name=\"insurance\" aria-describedby=\"f159-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Professional indemnity in place\">Professional indemnity in place</option><option value=\"In progress\">In progress</option><option value=\"Not in place\">Not in place</option></select>\n  \n  <span class=\"field__error\" id=\"f159-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f160\">Geographic area<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f160\" name=\"geographic-area\" aria-describedby=\"f160-err\" required aria-required=\"true\" placeholder=\"Regions served\">\n  \n  <span class=\"field__error\" id=\"f160-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f161\">Delivery mode<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f161\" name=\"delivery-mode\" aria-describedby=\"f161-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"In person\">In person</option><option value=\"Virtual\">Virtual</option><option value=\"Both\">Both</option></select>\n  \n  <span class=\"field__error\" id=\"f161-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f162\">Discounted or subsidized work <span class=\"opt\">(optional)</span></label>\n  <select id=\"f162\" name=\"discounted-or-subsidized-work\" aria-describedby=\"f162-err\"><option value=\"\">Please select</option><option value=\"Willing\">Willing</option><option value=\"Case by case\">Case by case</option><option value=\"Not able to\">Not able to</option></select>\n  \n  <span class=\"field__error\" id=\"f162-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f163\">Comments <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f163\" name=\"comments\" aria-describedby=\"f163-err\" rows=\"4\" placeholder=\"Anything else the review should consider\"></textarea>\n  \n  <span class=\"field__error\" id=\"f163-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f145\"><input type=\"checkbox\" id=\"f145\" name=\"consent\" required aria-describedby=\"f145-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f145-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
