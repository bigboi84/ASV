     "id": "3d2ae84a",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Potential categories.</h2><p class=\"body-lg muted\">Ten categories under consideration. A category being listed does not mean a provider is available.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Occupational therapy</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Speech and language</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Behavioural services</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Counselling and mental health</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Executive function</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Academic intervention</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Family education</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Service navigation</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Social development</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Adaptive and inclusive sport</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
  {
