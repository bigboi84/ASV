     "settings": {
      "html": "<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">Submission does not approve or publicly list a provider. All providers remain subject to qualification, licence and registration, insurance, safeguarding, privacy, capacity and agreement reviews.</p></section>"
