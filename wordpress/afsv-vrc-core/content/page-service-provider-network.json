     "id": "f7268253",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">Service Provider Network</p>\n      <h1 class=\"h1 split-words\" aria-label=\"Become an AFSV VRC Service Provider\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Become</span></span> <span class=\"w\"><span style=\"--i:1\">an</span></span> <span class=\"w\"><span style=\"--i:2\">AFSV</span></span> <span class=\"w\"><span style=\"--i:3\">VRC</span></span> <span class=\"w\"><span style=\"--i:4\">Service</span></span> <span class=\"w\"><span style=\"--i:5\">Provider</span></span></span></h1>\n      <p class=\"lead\">AFSV VRC intends to build a qualified network supporting sport, learning, development, wellbeing and inclusion.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"#interest\">Register Provider Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_223941_4ee69e2c-0ad2-47e5-a692-51d34feb0b44.mp4\" data-parallax=\"0.06\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_033957_d3468bc8-df31-4e66-ab86-dd97a564e0f3.png\" alt=\"Two professionals in smart casual clothing seated across a low table in a calm, non-clinical consulting room, reviewing printed materials and a tablet together.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
