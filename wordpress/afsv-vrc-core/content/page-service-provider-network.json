{"slug":"service-provider-network","parent":"","title":"Service Provider Network","description":"AFSV VRC intends to build a qualified network supporting sport, learning, development, wellbeing and inclusion.","chrome":"default","front":false,"elements":[{"id":"cd21db7d","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"59618a0e","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Neurodiversity</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Service Provider Network</li></ol></nav>"},"elements":[]}]},{"id":"0efeb08e","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"8856b32a","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/spn.jpg}}\" alt=\"Concept rendering: racially diverse therapists and psychologists working with children and teens in a bright sensory gym.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Service Provider Network</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Become an AFSV VRC Service Provider\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Become</span></span> <span class=\"w\"><span style=\"--i:1\">an</span></span> <span class=\"w\"><span style=\"--i:2\">AFSV</span></span> <span class=\"w\"><span style=\"--i:3\">VRC</span></span> <span class=\"w\"><span style=\"--i:4\">Service</span></span> <span class=\"w\"><span style=\"--i:5\">Provider</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC intends to build a qualified network supporting sport, learning, development, wellbeing and inclusion.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Join the Provider Network<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"f9a45e2c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"a8c144dc","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">Submission does not approve or publicly list a provider. All providers remain subject to qualification, licence and registration, insurance, safeguarding, privacy, capacity and agreement reviews.</p></section>"},"elements":[]}]},{"id":"345a9c99","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1eca7d3a","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Potential categories.</h2><p class=\"body-lg muted\">Ten categories under consideration. A category being listed does not mean a provider is available.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Occupational therapy</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Speech and language</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Behavioural services</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Counselling and mental health</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Executive function</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Academic intervention</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Family education</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Service navigation</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Social development</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Adaptive and inclusive sport</span></div></div>\n</section>"},"elements":[]}]},{"id":"46bdba72","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"796a10c4","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">What review covers.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Qualification and registration</h3><p style=\"font-size:15.5px\">Regulated professions must evidence current licence or registration. Those fields are conditional and only appear where they apply.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Insurance and safeguarding</h3><p style=\"font-size:15.5px\">Professional indemnity, screening and safeguarding arrangements are checked before any participant contact.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Capacity and coverage</h3><p style=\"font-size:15.5px\">Age groups, specialisation, geography and delivery mode, so referrals are only made where a provider can genuinely take them.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Agreement and listing</h3><p style=\"font-size:15.5px\">Listing follows a signed agreement. Until then a submission sits in a review queue with an auditable status.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"033a441b","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"nd.edu-cta","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"bc446422","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"nd.edu-cta\" data-el-build=\"elementor\">\n  <a class=\"educta reveal\" href=\"{{url:/education-partnerships/}}\">\n    <span class=\"educta__k\">For schools, colleges &amp; learning organisations</span>\n    <span class=\"educta__t\">Partner with us in education.</span>\n    <span class=\"educta__go\">Become an education partner <span aria-hidden=\"true\">→</span></span>\n  </a>\n</section>"},"elements":[]}]},{"id":"1a23f1f6","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"fe48c698","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Join the provider network.</h2>\n      <p class=\"body-lg\">This is an application to be reviewed, not a listing request.</p>\n      <p class=\"small muted\">Licence and registration fields are conditional on regulated profession. Do not attach client records or identifying participant information.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f133\">Organization<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f133\" name=\"organization\" aria-describedby=\"f133-err\" required aria-required=\"true\" placeholder=\"Practice or organization name\">\n  \n  <span class=\"field__error\" id=\"f133-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f134\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f134\" name=\"contact-name\" aria-describedby=\"f134-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f134-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f135\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f135\" name=\"email\" aria-describedby=\"f135-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f135-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f136\">Telephone<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"tel\" id=\"f136\" name=\"telephone\" aria-describedby=\"f136-err\" required aria-required=\"true\" placeholder=\"Contact number\">\n  \n  <span class=\"field__error\" id=\"f136-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f137\">Website <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f137\" name=\"website\" aria-describedby=\"f137-err\" placeholder=\"https://\">\n  \n  <span class=\"field__error\" id=\"f137-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f138\">Service type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f138\" name=\"service-type\" aria-describedby=\"f138-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Occupational therapy\">Occupational therapy</option><option value=\"Speech and language\">Speech and language</option><option value=\"Behavioural services\">Behavioural services</option><option value=\"Counselling and mental health\">Counselling and mental health</option><option value=\"Executive function\">Executive function</option><option value=\"Academic intervention\">Academic intervention</option><option value=\"Family education\">Family education</option><option value=\"Service navigation\">Service navigation</option><option value=\"Social development\">Social development</option><option value=\"Adaptive and inclusive sport\">Adaptive and inclusive sport</option></select>\n  \n  <span class=\"field__error\" id=\"f138-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f139\">Regulated profession<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f139\" name=\"regulated-profession\" aria-describedby=\"f139-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Yes\">Yes</option><option value=\"No\">No</option><option value=\"Unsure\">Unsure</option></select>\n  \n  <span class=\"field__error\" id=\"f139-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f140\">Licence or registration <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f140\" name=\"licence-or-registration\" aria-describedby=\"f140-err\" placeholder=\"Required if regulated\">\n  \n  <span class=\"field__error\" id=\"f140-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f141\">Qualifications <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f141\" name=\"qualifications\" aria-describedby=\"f141-err\" rows=\"4\" placeholder=\"Relevant qualifications and bodies\"></textarea>\n  \n  <span class=\"field__error\" id=\"f141-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f142\">Age groups served<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f142\" name=\"age-groups-served\" aria-describedby=\"f142-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option><option value=\"All ages\">All ages</option></select>\n  \n  <span class=\"field__error\" id=\"f142-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f143\">Specialization <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f143\" name=\"specialization\" aria-describedby=\"f143-err\" placeholder=\"Primary area of practice\">\n  \n  <span class=\"field__error\" id=\"f143-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f144\">Current capacity<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f144\" name=\"current-capacity\" aria-describedby=\"f144-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Accepting referrals\">Accepting referrals</option><option value=\"Limited capacity\">Limited capacity</option><option value=\"Waitlist only\">Waitlist only</option><option value=\"Not currently\">Not currently</option></select>\n  \n  <span class=\"field__error\" id=\"f144-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f145\">Accessibility experience <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f145\" name=\"accessibility-experience\" aria-describedby=\"f145-err\" rows=\"4\" placeholder=\"Experience working with neurodivergent people\"></textarea>\n  \n  <span class=\"field__error\" id=\"f145-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f146\">Insurance<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f146\" name=\"insurance\" aria-describedby=\"f146-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Professional indemnity in place\">Professional indemnity in place</option><option value=\"In progress\">In progress</option><option value=\"Not in place\">Not in place</option></select>\n  \n  <span class=\"field__error\" id=\"f146-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f147\">Geographic area<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f147\" name=\"geographic-area\" aria-describedby=\"f147-err\" required aria-required=\"true\" placeholder=\"Regions served\">\n  \n  <span class=\"field__error\" id=\"f147-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f148\">Delivery mode<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f148\" name=\"delivery-mode\" aria-describedby=\"f148-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"In person\">In person</option><option value=\"Virtual\">Virtual</option><option value=\"Both\">Both</option></select>\n  \n  <span class=\"field__error\" id=\"f148-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f149\">Discounted or subsidized work <span class=\"opt\">(optional)</span></label>\n  <select id=\"f149\" name=\"discounted-or-subsidized-work\" aria-describedby=\"f149-err\"><option value=\"\">Please select</option><option value=\"Willing\">Willing</option><option value=\"Case by case\">Case by case</option><option value=\"Not able to\">Not able to</option></select>\n  \n  <span class=\"field__error\" id=\"f149-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f150\">Comments <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f150\" name=\"comments\" aria-describedby=\"f150-err\" rows=\"4\" placeholder=\"Anything else the review should consider\"></textarea>\n  \n  <span class=\"field__error\" id=\"f150-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f132\"><input type=\"checkbox\" id=\"f132\" name=\"consent\" required aria-describedby=\"f132-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f132-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"13d57001","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.pending-inputs","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"2295bbdd","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.pending-inputs\" data-el-build=\"elementor\" style=\"padding-bottom:88px\">\n  <div class=\"pending\"><span class=\"eyebrow\">Pending inputs</span>\n    <p>Page copy follows the approved brief. Still outstanding: final photography, approved logos and partner permissions, mailbox routing, legal policies, operational program data, pricing, dates and a named content owner.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"fd92146b","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"06557130","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Families use the network. Providers apply to join it.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/neurodiversity/}}\">Neurodiversity Access &amp; Opportunity<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}