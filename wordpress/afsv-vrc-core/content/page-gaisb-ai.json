     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">GAISB AI Education &amp; Responsible Innovation</p>\n      <h1 class=\"h1 split-words\" aria-label=\"Advancing Responsible AI Education and Workforce Readiness\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Advancing</span></span> <span class=\"w\"><span style=\"--i:1\">Responsible</span></span> <span class=\"w\"><span style=\"--i:2\">AI</span></span> <span class=\"w\"><span style=\"--i:3\">Education</span></span> <span class=\"w\"><span style=\"--i:4\">and</span></span> <span class=\"w\"><span style=\"--i:5\">Workforce</span></span> <span class=\"w\"><span style=\"--i:6\">Readiness</span></span></span></h1>\n      <p class=\"lead\">Through its strategic relationship with the Global AI Standards Body, AFSV VRC is advancing AI education, certification, workforce readiness and responsible innovation across sport, education and community development in Canada and the Caribbean.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"#interest\">Explore Certification Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/partners/}}\">Become an Education Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"#interest\">Discuss Enterprise AI<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/contact/}}\">Summit &amp; Events<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_223921_814d2a67-f7e4-47e0-af90-9517bc64091d.mp4\" data-parallax=\"0.06\"><img src=\"{{asset:img/ai-education-studio.jpg}}\" alt=\"Three adult learners working at a long desk with large displays showing abstract data visualisations, while an instructor explains a concept in a modern technology education studio.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
