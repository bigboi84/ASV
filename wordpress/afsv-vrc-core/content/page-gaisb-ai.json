     "id": "817ca766",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Priority pathways.</h2><p class=\"body-lg muted\">Eight pathways within the confirmed scope of the relationship.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>AI literacy</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Professional certification</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Educator and youth learning</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Sport technology</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Responsible-AI governance</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Workforce readiness</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Enterprise innovation</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Community capacity building</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
