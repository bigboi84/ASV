     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">This is a strategic relationship with the Global AI Standards Body. No accreditation, exclusivity or course availability is claimed beyond approved language, and no GAISB logo or brand mark is published pending written permission. Programs, territories, certifications, fees and dates appear only once contractually approved.</p></section>"
