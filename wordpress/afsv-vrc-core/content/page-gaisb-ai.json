    {
     "id": "88d0a526",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Certification, education and enterprise inquiries.</h2>\n      <p class=\"body-lg\">Tell us which pathway applies and we will route your inquiry to the right team.</p>\n      <p class=\"small muted\">No certification, fee, territory or date is confirmed by this form. Responses describe approved scope only.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:gaisb-ai}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f111\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f111\" name=\"name\" aria-describedby=\"f111-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f111-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f112\">Organization<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f112\" name=\"organization\" aria-describedby=\"f112-err\" required aria-required=\"true\" placeholder=\"Organization name\">\n  \n  <span class=\"field__error\" id=\"f112-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f113\">Role<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f113\" name=\"role\" aria-describedby=\"f113-err\" required aria-required=\"true\" placeholder=\"Your role\">\n  \n  <span class=\"field__error\" id=\"f113-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f114\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f114\" name=\"email\" aria-describedby=\"f114-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f114-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f115\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f115\" name=\"phone\" aria-describedby=\"f115-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f115-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f116\">Country<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f116\" name=\"country\" aria-describedby=\"f116-err\" required aria-required=\"true\" placeholder=\"Country\">\n  \n  <span class=\"field__error\" id=\"f116-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f117\">Pathway<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f117\" name=\"pathway\" aria-describedby=\"f117-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"AI literacy\">AI literacy</option><option value=\"Professional certification\">Professional certification</option><option value=\"Educator and youth learning\">Educator and youth learning</option><option value=\"Sport technology\">Sport technology</option><option value=\"Responsible-AI governance\">Responsible-AI governance</option><option value=\"Workforce readiness\">Workforce readiness</option><option value=\"Enterprise innovation\">Enterprise innovation</option><option value=\"Community capacity building\">Community capacity building</option></select>\n  \n  <span class=\"field__error\" id=\"f117-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f118\">Learner or team size <span class=\"opt\">(optional)</span></label>\n  <select id=\"f118\" name=\"learner-or-team-size\" aria-describedby=\"f118-err\"><option value=\"\">Please select</option><option value=\"1–10\">1–10</option><option value=\"11–50\">11–50</option><option value=\"51–200\">51–200</option><option value=\"200+\">200+</option><option value=\"Not yet known\">Not yet known</option></select>\n  \n  <span class=\"field__error\" id=\"f118-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f119\">Timeframe <span class=\"opt\">(optional)</span></label>\n  <select id=\"f119\" name=\"timeframe\" aria-describedby=\"f119-err\"><option value=\"\">Please select</option><option value=\"As soon as available\">As soon as available</option><option value=\"Next 3 months\">Next 3 months</option><option value=\"Next 6 months\">Next 6 months</option><option value=\"Exploratory\">Exploratory</option></select>\n  \n  <span class=\"field__error\" id=\"f119-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f120\">Message <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f120\" name=\"message\" aria-describedby=\"f120-err\" rows=\"4\" placeholder=\"What you are trying to achieve\"></textarea>\n  \n  <span class=\"field__error\" id=\"f120-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f110\"><input type=\"checkbox\" id=\"f110\" name=\"consent\" required aria-describedby=\"f110-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f110-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
