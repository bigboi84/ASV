   "elements": [
    {
     "id": "58115e4b",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">AI supports the pillars. It does not replace them.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Athlete development</h3><p style=\"font-size:15.5px\">Analysis and planning tools support coaching decisions. The coach makes the decision.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Inclusive learning</h3><p style=\"font-size:15.5px\">Assistive and adaptive tools widen access to material. They do not substitute for a teacher or a support worker.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Neurodivergent support</h3><p style=\"font-size:15.5px\">Tools chosen for accessibility and predictability, reviewed with the people who use them.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Operations</h3><p style=\"font-size:15.5px\">Scheduling, reporting and administration, so staff time goes to participants rather than paperwork.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">05</span><h3 class=\"h3\">Media and career preparation</h3><p style=\"font-size:15.5px\">Production and career-readiness skills that reflect how the work is actually done now.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
