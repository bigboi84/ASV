      "html": "<section class=\"wrap section\" data-el=\"marketplace.categories\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-l reveal\">Launch categories.</h2>\n  <div class=\"hairline\" style=\"--min:220px\" data-stagger>\n    <div class=\"cell\" style=\"min-height:180px\"><div class=\"cell__top\"><span class=\"num\">01</span><span class=\"pill pill--soft\">Coming soon</span></div><h3 class=\"h3\" style=\"font-size:19px\">AFSV VRC apparel and fanwear</h3></div><div class=\"cell\" style=\"min-height:180px\"><div class=\"cell__top\"><span class=\"num\">02</span><span class=\"pill pill--soft\">Coming soon</span></div><h3 class=\"h3\" style=\"font-size:19px\">Training and performance</h3></div><div class=\"cell\" style=\"min-height:180px\"><div class=\"cell__top\"><span class=\"num\">03</span><span class=\"pill pill--soft\">Coming soon</span></div><h3 class=\"h3\" style=\"font-size:19px\">Education and life-skills resources</h3></div><div class=\"cell\" style=\"min-height:180px\"><div class=\"cell__top\"><span class=\"num\">04</span><span class=\"pill pill--soft\">Coming soon</span></div><h3 class=\"h3\" style=\"font-size:19px\">Partner and sponsor offers</h3></div><div class=\"cell\" style=\"min-height:180px\"><div class=\"cell__top\"><span class=\"num\">05</span><span class=\"pill pill--soft\">Coming soon</span></div><h3 class=\"h3\" style=\"font-size:19px\">Community and vendor products</h3></div>\n  </div>\n</section>"
