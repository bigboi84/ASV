     "id": "ab589957",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"marketplace.featured\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\">\n      <h2 class=\"h2\">A first look at the range.</h2>\n      <p class=\"body-lg muted\">Sample listings from the commerce preview. Names, prices and imagery are for build review and are not on sale.</p>\n    </div>\n    <div class=\"product-grid\" data-stagger>\n<a class=\"product-card\" href=\"{{url:/product/training-tee}}\" data-cat=\"Apparel\" data-vendor=\"AFSV VRC Official\" data-price=\"42\" data-name=\"AFSV VRC Training Tee\">\n  <div class=\"product-card__img\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215633_c1fb9e55-64ba-44a0-9ae8-9e1233b8ac98.png\" alt=\"Product shot — folded training tee, front\" width=\"800\" height=\"800\" loading=\"lazy\"></div>\n  <div class=\"product-card__body\">\n    <span class=\"product-card__vendor\">AFSV VRC Official</span>\n    <h3>AFSV VRC Training Tee</h3>\n    <p>Breathable training layer in district colours.</p>\n    <div class=\"product-card__foot\"><span class=\"price\">$42.00</span><span class=\"cell__foot\" style=\"padding:0\">View <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span></div>\n  </div>\n</a>\n<a class=\"product-card\" href=\"{{url:/product/performance-hoodie}}\" data-cat=\"Apparel\" data-vendor=\"AFSV VRC Official\" data-price=\"88\" data-name=\"Performance Hoodie\">\n  <div class=\"product-card__img\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215635_7ec82064-84ee-409a-8bb7-2423fd4965ea.png\" alt=\"Product shot — hoodie on hanger, front\" width=\"800\" height=\"800\" loading=\"lazy\"></div>\n  <div class=\"product-card__body\">\n    <span class=\"product-card__vendor\">AFSV VRC Official</span>\n    <h3>Performance Hoodie</h3>\n    <p>Mid-weight warmup and travel layer.</p>\n    <div class=\"product-card__foot\"><span class=\"price\">$88.00</span><span class=\"cell__foot\" style=\"padding:0\">View <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span></div>\n  </div>\n</a>\n<a class=\"product-card\" href=\"{{url:/product/sensory-warmup-jacket}}\" data-cat=\"Apparel\" data-vendor=\"Quietform Athletics\" data-price=\"124\" data-name=\"Sensory-Friendly Warmup Jacket\">\n  <div class=\"product-card__img\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215637_22beed6d-1692-4e0c-94ae-bf2aed8d61da.png\" alt=\"Product shot — warmup jacket, tag-free interior\" width=\"800\" height=\"800\" loading=\"lazy\"><span class=\"badge\">Neuro-inclusive</span></div>\n  <div class=\"product-card__body\">\n    <span class=\"product-card__vendor\">Quietform Athletics</span>\n    <h3>Sensory-Friendly Warmup Jacket</h3>\n    <p>Tag-free, seam-reduced, quiet fabric.</p>\n    <div class=\"product-card__foot\"><span class=\"price\">$124.00</span><span class=\"cell__foot\" style=\"padding:0\">View <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span></div>\n  </div>\n</a></div>\n    <p class=\"mt-m\"><a class=\"text-link\" href=\"{{url:/shop/}}\">Browse all 10 sample products <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></p>\n  </div>\n</section>"
