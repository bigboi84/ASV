     "id": "f6665c74",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section section--flush-top\" id=\"vendor-form\" data-el=\"marketplace.vendor-form\" data-el-build=\"plugin\" style=\"padding-top:32px\">\n  <div class=\"panel panel--dark\">\n    <span class=\"pill mb-m\">Interest only — not approval</span>\n    <h2 class=\"h2 h2--sm mb-s\">Become a marketplace vendor</h2>\n    <p class=\"body-lg mb-l measure\">Submitting this form registers your interest. It does not create a vendor account or constitute onboarding.</p>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:marketplace}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f37\">Legal or brand name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f37\" name=\"legal-or-brand-name\" autocomplete=\"organization\" aria-describedby=\"f37-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f37-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f38\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f38\" name=\"contact-name\" autocomplete=\"name\" aria-describedby=\"f38-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f38-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f39\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f39\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f39-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f39-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f40\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f40\" name=\"phone\" autocomplete=\"tel\" aria-describedby=\"f40-err\">\n  \n  <span class=\"field__error\" id=\"f40-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f41\">Website <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f41\" name=\"website\" autocomplete=\"url\" aria-describedby=\"f41-err\" placeholder=\"https://\">\n  \n  <span class=\"field__error\" id=\"f41-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f42\">Category<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f42\" name=\"category\" aria-describedby=\"f42-err\" required aria-required=\"true\"><option value=\"\">Select a category</option><option value=\"Apparel and fanwear\">Apparel and fanwear</option><option value=\"Training and performance\">Training and performance</option><option value=\"Education and life-skills resources\">Education and life-skills resources</option><option value=\"Partner and sponsor offers\">Partner and sponsor offers</option><option value=\"Community and vendor products\">Community and vendor products</option></select>\n  \n  <span class=\"field__error\" id=\"f42-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f43\">Regions served <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f43\" name=\"regions-served\" aria-describedby=\"f43-err\">\n  \n  <span class=\"field__error\" id=\"f43-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f44\">Insurance status <span class=\"opt\">(optional)</span></label>\n  <select id=\"f44\" name=\"insurance-status\" aria-describedby=\"f44-err\"><option value=\"\">Select a status</option><option value=\"Current cover in place\">Current cover in place</option><option value=\"Application in progress\">Application in progress</option><option value=\"Not yet arranged\">Not yet arranged</option></select>\n  \n  <span class=\"field__error\" id=\"f44-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f45\">Product or service description<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f45\" name=\"product-or-service-description\" aria-describedby=\"f45-err\" required aria-required=\"true\" rows=\"3\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f45-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f46\">Fulfilment capability <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f46\" name=\"fulfilment-capability\" aria-describedby=\"f46-err\" rows=\"2\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f46-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f47\">Comments <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f47\" name=\"comments\" aria-describedby=\"f47-err\" rows=\"2\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f47-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f36\"><input type=\"checkbox\" id=\"f36\" name=\"consent\" required aria-describedby=\"f36-err\"><span>I agree to be contacted about marketplace vendor opportunities and understand this submission is not an approval.<span class=\"field__error\" id=\"f36-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Vendor submissions will route to a manual review queue; no vendor account is created automatically.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Register vendor interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  }
 ],
 "description": "Wear the Movement. Build the Future. The AFSV VRC Marketplace will bring together branded apparel, sport and training products, education resources and community goods."
}