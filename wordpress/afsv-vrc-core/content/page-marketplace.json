     "id": "e43c2e92",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap\" id=\"buyer-form\" data-el=\"marketplace.buyer-form\" data-el-build=\"plugin\" style=\"padding-top:64px\">\n  <div class=\"panel\">\n    <h2 class=\"h2 h2--sm mb-s\">Join the launch list</h2>\n    <p class=\"body-lg mb-l\">For shoppers. We will let you know when the marketplace opens.</p>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:marketplace}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f32\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f32\" name=\"name\" autocomplete=\"name\" aria-describedby=\"f32-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f32-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f33\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f33\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f33-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f33-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f34\">Country<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f34\" name=\"country\" autocomplete=\"country-name\" aria-describedby=\"f34-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f34-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f35\">Interests <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f35\" name=\"interests\" aria-describedby=\"f35-err\">\n  \n  <span class=\"field__error\" id=\"f35-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f31\"><input type=\"checkbox\" id=\"f31\" name=\"consent\" required aria-describedby=\"f31-err\"><span>I agree to receive marketplace launch updates from AFSV VRC.<span class=\"field__error\" id=\"f31-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Launch-list submissions will route once commerce approvals are complete.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Join the Launch List<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
