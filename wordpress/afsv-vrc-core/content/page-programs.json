   "elements": [
    {
     "id": "c3a1f70a",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Register program interest.</h2>\n      <p class=\"body-lg\">Tell us who the participant is and what they are interested in. We collect only what is needed for a first conversation.</p>\n      <p class=\"small muted\">Do not include diagnoses or medical records. Accessibility needs are optional and free-text.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:programs}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f69\">Participant or caregiver name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f69\" name=\"participant-or-caregiver-name\" aria-describedby=\"f69-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f69-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f70\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f70\" name=\"email\" aria-describedby=\"f70-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f70-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f71\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f71\" name=\"phone\" aria-describedby=\"f71-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f71-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f72\">Participant age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f72\" name=\"participant-age-range\" aria-describedby=\"f72-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option></select>\n  \n  <span class=\"field__error\" id=\"f72-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f73\">Sport or program<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f73\" name=\"sport-or-program\" aria-describedby=\"f73-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Multi-sport development\">Multi-sport development</option><option value=\"Soccer\">Soccer</option><option value=\"Cricket\">Cricket</option><option value=\"Basketball\">Basketball</option><option value=\"Track and sprint\">Track and sprint</option><option value=\"Strength and conditioning\">Strength and conditioning</option><option value=\"Camps and clinics\">Camps and clinics</option><option value=\"Adaptive and sensory-friendly sport\">Adaptive and sensory-friendly sport</option><option value=\"Athlete mentorship\">Athlete mentorship</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f73-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f74\">Experience level <span class=\"opt\">(optional)</span></label>\n  <select id=\"f74\" name=\"experience-level\" aria-describedby=\"f74-err\"><option value=\"\">Please select</option><option value=\"New to the sport\">New to the sport</option><option value=\"Some experience\">Some experience</option><option value=\"Competitive\">Competitive</option><option value=\"Prefer not to say\">Prefer not to say</option></select>\n  \n  <span class=\"field__error\" id=\"f74-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f75\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f75\" name=\"region\" aria-describedby=\"f75-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f75-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f76\">Preferred format <span class=\"opt\">(optional)</span></label>\n  <select id=\"f76\" name=\"preferred-format\" aria-describedby=\"f76-err\"><option value=\"\">Please select</option><option value=\"Weekday\">Weekday</option><option value=\"Weekend\">Weekend</option><option value=\"Holiday programming\">Holiday programming</option><option value=\"Either\">Either</option></select>\n  \n  <span class=\"field__error\" id=\"f76-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f77\">Preferred timeframe <span class=\"opt\">(optional)</span></label>\n  <select id=\"f77\" name=\"preferred-timeframe\" aria-describedby=\"f77-err\"><option value=\"\">Please select</option><option value=\"As soon as available\">As soon as available</option><option value=\"Next 3 months\">Next 3 months</option><option value=\"Next 6 months\">Next 6 months</option><option value=\"Just keeping in touch\">Just keeping in touch</option></select>\n  \n  <span class=\"field__error\" id=\"f77-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f78\">Accessibility needs <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f78\" name=\"accessibility-needs\" aria-describedby=\"f78-err\" rows=\"4\" placeholder=\"Anything that would help us plan a session well\"></textarea>\n  \n  <span class=\"field__error\" id=\"f78-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f68\"><input type=\"checkbox\" id=\"f68\" name=\"consent\" required aria-describedby=\"f68-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f68-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
