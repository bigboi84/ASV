    {
     "id": "8540fba9",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Program categories.</h2><p class=\"body-lg muted\">Ten categories planned for the first program cycle. Each will carry its own status label until confirmed.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Multi-sport development</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Soccer</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Cricket</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Basketball</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Track and sprint</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Strength and conditioning</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Camps and clinics</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Coach education</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Adaptive and sensory-friendly sport</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Athlete mentorship</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
  {
