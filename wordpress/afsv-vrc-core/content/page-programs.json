     "id": "13329925",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">Programs &amp; Athlete Development</p>\n      <h1 class=\"h1 split-words\" aria-label=\"Develop the Athlete. Strengthen the Whole Person.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Develop</span></span> <span class=\"w\"><span style=\"--i:1\">the</span></span> <span class=\"w\"><span style=\"--i:2\">Athlete.</span></span> <span class=\"w\"><span style=\"--i:3\">Strengthen</span></span> <span class=\"w\"><span style=\"--i:4\">the</span></span> <span class=\"w\"><span style=\"--i:5\">Whole</span></span> <span class=\"w\"><span style=\"--i:6\">Person.</span></span></span></h1>\n      <p class=\"lead\">AFSV VRC is developing inclusive pathways intended to support participation, skill development, performance, confidence and opportunity.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"#interest\">Explore Program Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/contact/}}\">Coach / Provider Inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"#interest\">Get Updates<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_223941_00db60c4-3ed5-47c3-8bb3-1a8498ff50ff.mp4\" data-parallax=\"0.06\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_215610_89595cab-2486-4027-97ba-f600820a034b.png\" alt=\"A coach crouching to talk with two teenage athletes during a session in an indoor fieldhouse, other participants of mixed ages and abilities training behind them, one using a sport wheelchair.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
