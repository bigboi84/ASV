{"slug":"programs","parent":"","title":"Programs & Athlete Development","description":"AFSV VRC is developing inclusive pathways intended to support participation, skill development, performance, confidence and opportunity.","chrome":"default","front":false,"elements":[{"id":"ae67086f","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"19353357","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Programs</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Programs &amp; Athlete Development</li></ol></nav>"},"elements":[]}]},{"id":"05be25e6","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"7d6e4834","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/academy.jpg}}\" alt=\"Concept rendering: racially diverse boys and girls doing passing drills at night inside the dome while parents watch.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Programs &amp; Athlete Development</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Develop the Athlete. Strengthen the Whole Person.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Develop</span></span> <span class=\"w\"><span style=\"--i:1\">the</span></span> <span class=\"w\"><span style=\"--i:2\">Athlete.</span></span> <span class=\"w\"><span style=\"--i:3\">Strengthen</span></span> <span class=\"w\"><span style=\"--i:4\">the</span></span> <span class=\"w\"><span style=\"--i:5\">Whole</span></span> <span class=\"w\"><span style=\"--i:6\">Person.</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC is developing inclusive pathways intended to support participation, skill development, performance, confidence and opportunity.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Explore Program Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/contact/}}\">Coach / Provider Inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Get Updates<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"a947edf8","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"07b68405","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">Program details coming soon. Schedules, coaching assignments, prices and capacity are not confirmed and are not published on this page.</p></section>"},"elements":[]}]},{"id":"81a4e9fa","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"f2e4c806","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Program categories.</h2><p class=\"body-lg muted\">Ten categories planned for the first program cycle. Each will carry its own status label until confirmed.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Multi-sport development</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Soccer</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Cricket</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Basketball</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Track and sprint</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Strength and conditioning</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Camps and clinics</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Coach education</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Adaptive and sensory-friendly sport</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Athlete mentorship</span></div></div>\n</section>"},"elements":[]}]},{"id":"0ac86a04","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"6084ab8a","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">What each program record holds.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Structured records</h3><p style=\"font-size:15.5px\">Approved title, status, age group, ability level, format, schedule, location, capacity, prerequisites, accessibility, coach or provider, price, media and registration route.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Status labels</h3><p style=\"font-size:15.5px\">Every program carries a visible status. Until it is approved the record shows “Program details coming soon” and collects interest only.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Adaptive pathway</h3><p style=\"font-size:15.5px\">Adaptive and sensory-friendly sport is a named category in its own right, not an accommodation applied to another program.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Registration later</h3><p style=\"font-size:15.5px\">Registration and payment stay switched off until inventory, schedules, pricing, waivers and refund terms are approved.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"9294ef7f","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"programs.areas","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1059e868","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"programs.areas\" data-el-build=\"elementor\">\n  \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">Proposed program areas</p>\n    <h2 class=\"h2\">A multi-sport development ecosystem.</h2>\n    \n  </div>\n  \n  <div class=\"kgrid kgrid--3\" data-stagger>\n    <article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M12 8.2l3.2 2.3-1.2 3.8h-4l-1.2-3.8z\"/><path d=\"M12 3.4v4.8M15.2 10.5l4.3-1.6M14 14.3l2.7 3.8M10 14.3l-2.7 3.8M8.8 10.5L4.5 8.9\"/></svg></span>\n      <h3>Soccer Development Academy</h3>\n      <p>Year-round technical training, tactical development and competitive programming for youth and elite players.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"14.6\" cy=\"4.6\" r=\"1.8\"/><path d=\"M8.2 9.6l3.4-2 3 1.8 2 3.2 2.6.6\"/><path d=\"M11.6 7.6l-1.4 5.6 3.2 2.6-.8 5\"/><path d=\"M10.2 13.2l-2.6 3.4-3.6-.4\"/><path d=\"M2.6 21h6M15.6 21h5.8\"/></svg></span>\n      <h3>Track &amp; Field Programs</h3>\n      <p>Sprint, endurance and field event training with sports science support and performance monitoring.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14.6 3.6l2.4 2.4-8.2 8.2-2.4-2.4z\"/><path d=\"M6.4 11.8l-2.6 2.6a1.4 1.4 0 0 0 0 2l.4.4a1.4 1.4 0 0 0 2 0l2.6-2.6\"/><circle cx=\"17.2\" cy=\"17.4\" r=\"2.6\"/><path d=\"M15.6 15.6c.9.4 2 1.6 2.4 2.6\"/></svg></span>\n      <h3>Cricket Training Centre</h3>\n      <p>Indoor cricket training for batting, bowling and fielding — rare in Canadian sports infrastructure.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M3.4 12h17.2M12 3.4v17.2\"/><path d=\"M6 5.8c2.6 2.8 2.6 9.6 0 12.4M18 5.8c-2.6 2.8-2.6 9.6 0 12.4\"/></svg></span>\n      <h3>Basketball Development</h3>\n      <p>Skill development, team training and competitive programming for youth and adult players.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6.6 7.6h10.8a3.6 3.6 0 0 1 3.5 2.8l1 4.6a2.4 2.4 0 0 1-4 2.2l-2.1-2.2H8.2L6.1 17.2a2.4 2.4 0 0 1-4-2.2l1-4.6a3.6 3.6 0 0 1 3.5-2.8z\"/><path d=\"M7.4 10.2v3M5.9 11.7h3\"/><circle cx=\"15.6\" cy=\"11\" r=\".9\"/><circle cx=\"17.6\" cy=\"12.8\" r=\".9\"/></svg></span>\n      <h3>Esports Performance</h3>\n      <p>Competitive gaming training, team development and tournament preparation through the EFN platform.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3.4 20.4h17.2\"/><path d=\"M5.6 20.4v-4.6M10 20.4v-7.4M14.4 20.4v-5.6M18.8 20.4V9.4\"/><path d=\"M4.6 11.6l5-4.4 4 2.8 6.2-5.6\"/><path d=\"M16.4 4.4h3.4v3.4\"/></svg></span>\n      <h3>Sports Science &amp; Recovery</h3>\n      <p>Biomechanics, physiotherapy, nutrition guidance and recovery integrated into all athlete programs.</p>\n      \n    </article>\n  </div>\n</section>"},"elements":[]}]},{"id":"96898bee","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"programs.kit","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"bc602391","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"programs.kit\" data-el-build=\"elementor\">\n  <div class=\"kitband reveal\">\n    <span class=\"kitband__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8.6 3.6L4 6l1.6 4.2 2-.8V20.4h8.8V9.4l2 .8L20 6l-4.6-2.4a3.4 3.4 0 0 1-6.8 0z\"/></svg></span>\n    <div><p class=\"eyebrow mb-s\">AFSVHCL athlete performance kit</p><h2 class=\"h3\">Every athlete, fully kitted.</h2><p class=\"muted\">Featuring AFSVHCL branding, the athlete’s national identity and corporate sponsor integration.</p></div>\n    <ul><li>Training jersey</li><li>Training shorts</li><li>Tracksuit</li><li>Running shoes</li><li>Winter jacket</li><li>Sports bag</li></ul>\n    <span class=\"pill pill--gold\">Planned</span>\n  </div>\n</section>"},"elements":[]}]},{"id":"6fc7c845","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.affiliate","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"0bf89693","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"page.affiliate\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow mb-s\">Affiliate Academy Network</p>\n      <h2 class=\"h2\">Partnering with existing clubs &amp; academies.</h2>\n      <p class=\"body-lg\">AFSVHCL™ is not a competitor to existing clubs — it is the infrastructure and services layer that makes every club, academy and institution better.</p>\n    </div>\n    <div class=\"aff\" data-stagger>\n      <article class=\"aff__card\"><h3>Community Affiliate</h3><p>Dome access and basic programming.</p><a class=\"aff__go\" href=\"{{url:/become-a-member/?interest=partnership}}\">Keep up to date &rarr;</a></article><article class=\"aff__card aff__card--hot\"><h3>Performance Affiliate</h3><p>Full sports science, media and neurodivergent support.</p><a class=\"aff__go\" href=\"{{url:/become-a-member/?interest=partnership}}\">Keep up to date &rarr;</a></article><article class=\"aff__card\"><h3>Elite Academy Partner</h3><p>Co-branded programs, recruitment and sponsorship.</p><a class=\"aff__go\" href=\"{{url:/become-a-member/?interest=partnership}}\">Keep up to date &rarr;</a></article>\n    </div>\n    <p class=\"aff__fine\">Affiliate details will be shared with clubs and academies as the network opens. Expressions of interest do not constitute binding commitments.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"e95cdc53","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"646d985b","elType":"widget","widgetType":"html","settings":{"html":"<section data-form-id=\"programs-interest\" class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Keep up to date on programs.</h2>\n      <p class=\"body-lg\">Tell us who the participant is and what they are interested in. We collect only what is needed for a first conversation.</p>\n      <p class=\"small muted\">Do not include diagnoses or medical records. Accessibility needs are optional and free-text.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f61\">Participant or caregiver name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f61\" name=\"participant-or-caregiver-name\" aria-describedby=\"f61-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f61-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f62\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f62\" name=\"email\" aria-describedby=\"f62-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f62-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f63\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f63\" name=\"phone\" aria-describedby=\"f63-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f63-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f64\">Participant age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f64\" name=\"participant-age-range\" aria-describedby=\"f64-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option></select>\n  \n  <span class=\"field__error\" id=\"f64-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f65\">Sport or program<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f65\" name=\"sport-or-program\" aria-describedby=\"f65-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Multi-sport development\">Multi-sport development</option><option value=\"Soccer\">Soccer</option><option value=\"Cricket\">Cricket</option><option value=\"Basketball\">Basketball</option><option value=\"Track and sprint\">Track and sprint</option><option value=\"Strength and conditioning\">Strength and conditioning</option><option value=\"Camps and clinics\">Camps and clinics</option><option value=\"Adaptive and sensory-friendly sport\">Adaptive and sensory-friendly sport</option><option value=\"Athlete mentorship\">Athlete mentorship</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f65-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f66\">Experience level <span class=\"opt\">(optional)</span></label>\n  <select id=\"f66\" name=\"experience-level\" aria-describedby=\"f66-err\"><option value=\"\">Please select</option><option value=\"New to the sport\">New to the sport</option><option value=\"Some experience\">Some experience</option><option value=\"Competitive\">Competitive</option><option value=\"Prefer not to say\">Prefer not to say</option></select>\n  \n  <span class=\"field__error\" id=\"f66-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f67\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f67\" name=\"region\" aria-describedby=\"f67-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f67-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f68\">Preferred format <span class=\"opt\">(optional)</span></label>\n  <select id=\"f68\" name=\"preferred-format\" aria-describedby=\"f68-err\"><option value=\"\">Please select</option><option value=\"Weekday\">Weekday</option><option value=\"Weekend\">Weekend</option><option value=\"Holiday programming\">Holiday programming</option><option value=\"Either\">Either</option></select>\n  \n  <span class=\"field__error\" id=\"f68-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f69\">Preferred timeframe <span class=\"opt\">(optional)</span></label>\n  <select id=\"f69\" name=\"preferred-timeframe\" aria-describedby=\"f69-err\"><option value=\"\">Please select</option><option value=\"As soon as available\">As soon as available</option><option value=\"Next 3 months\">Next 3 months</option><option value=\"Next 6 months\">Next 6 months</option><option value=\"Just keeping in touch\">Just keeping in touch</option></select>\n  \n  <span class=\"field__error\" id=\"f69-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f70\">Accessibility needs <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f70\" name=\"accessibility-needs\" aria-describedby=\"f70-err\" rows=\"4\" placeholder=\"Anything that would help us plan a session well\"></textarea>\n  \n  <span class=\"field__error\" id=\"f70-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f60\"><input type=\"checkbox\" id=\"f60\" name=\"consent\" required aria-describedby=\"f60-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f60-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"ada3b728","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.pending-inputs","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"81d60a25","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.pending-inputs\" data-el-build=\"elementor\" style=\"padding-bottom:88px\">\n  <div class=\"pending\"><span class=\"eyebrow\">Pending inputs</span>\n    <p>Page copy follows the approved brief. Still outstanding: final photography, approved logos and partner permissions, mailbox routing, legal policies, operational program data, pricing, dates and a named content owner.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"98c89ac9","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"eac80a2b","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Coaches and providers register through a separate route.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/contact/}}\">Coach or provider inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}