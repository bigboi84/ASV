{"slug":"whitby-smart-sports-village","parent":"","title":"Whitby Smart Sports Village","description":"A proposed year-round, technology-enabled destination in Whitby, Ontario bringing multi-sport participation, athlete development, education, inclusive supports, media and community under one roof.","chrome":"default","front":false,"elements":[{"id":"5d72fcad","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"4cc58b80","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Smart Sports Village</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Whitby Smart Sports Village</li></ol></nav>"},"elements":[]}]},{"id":"5a850b5f","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"0ce7d71f","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap page-head\" data-el=\"whitby.hero\" data-el-build=\"elementor\" style=\"padding-bottom:0\">\n  <span class=\"pill mb-m\">Proposed development</span>\n  <h1 class=\"h1 split-words\" style=\"max-width:22ch\" aria-label=\"The Whitby Smart Sports Village: a connected place to train, learn and belong.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">The</span></span> <span class=\"w\"><span style=\"--i:1\">Whitby</span></span> <span class=\"w\"><span style=\"--i:2\">Smart</span></span> <span class=\"w\"><span style=\"--i:3\">Sports</span></span> <span class=\"w\"><span style=\"--i:4\">Village:</span></span> <span class=\"w\"><span style=\"--i:5\">a</span></span> <span class=\"w\"><span style=\"--i:6\">connected</span></span> <span class=\"w\"><span style=\"--i:7\">place</span></span> <span class=\"w\"><span style=\"--i:8\">to</span></span> <span class=\"w\"><span style=\"--i:9\">train,</span></span> <span class=\"w\"><span style=\"--i:10\">learn</span></span> <span class=\"w\"><span style=\"--i:11\">and</span></span> <span class=\"w\"><span style=\"--i:12\">belong.</span></span></span></h1>\n  <p class=\"lead measure mb-l\">AFSV VRC is advancing a proposed Smart Sports Village pilot in Whitby, Ontario: a year-round, technology-enabled destination bringing multi-sport participation, athlete development, education, inclusive supports, media and community experiences under one roof.</p>\n  <figure class=\"figure figure--16x9 figure--motion wipe\"><div class=\"pmedia\" data-parallax=\"0.05\"><img src=\"{{asset:img/whitby-dome.jpg}}\" alt=\"Conceptual rendering: a large white inflatable sports dome carrying the AFSV VRC crest, with a glass-fronted entrance pavilion, landscaped plaza, accessible parking and people arriving, and a lake on the horizon. Not an existing facility.\" width=\"1600\" height=\"900\" fetchpriority=\"high\"></div>\n    <figcaption class=\"caption-bar\">Conceptual Rendering — Not an Existing Facility</figcaption>\n  </figure>\n</section>"},"elements":[]}]},{"id":"b5c30f1f","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.concept","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"bee2e821","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"whitby.concept\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-l reveal\">Concept at a glance.</h2>\n  <div class=\"hairline\" style=\"--min:300px\" data-stagger>\n    \n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Scale</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Approximately 150,000 sq ft in proposed Phase 1, subject to site, design, approvals and financing.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Sport</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Flexible soccer, cricket, basketball, sprint and configurable sport space.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Performance</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Performance, strength and conditioning, recovery, biomechanics and analytics.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Learning</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Learning, tutoring, mentoring, sensory support and life skills.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Media</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Esports, broadcasting, podcasting and content creation.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Community</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Events, partner activation, concessions, retail and fan experiences.</p>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"4f3130fe","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.overview","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"839bdb16","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"whitby.overview\" data-el-build=\"elementor\">\n  <div class=\"overview\">\n    <div class=\"reveal\">\n      <p class=\"eyebrow mb-s\">Project overview</p>\n      <h2 class=\"h2 mb-m\">The foundation for a national network.</h2>\n      <p class=\"lead mb-m\">The Smart Sports Village is the proposed flagship pilot of AFSVHCL™ — designed as the model for a national network of integrated sports and education campuses across Canada.</p>\n      <p class=\"muted\">The proposed dome would integrate elite athletic development, applied learning, neurodivergent support pathways, esports and digital media, and measurable community impact — all under one roof, year-round. It is proposed for a 12–15 acre Smart Sports &amp; Education Campus in partnership with municipal and post-secondary institutions, subject to financing, approvals and feasibility analysis.</p>\n    </div>\n    \n  <div class=\"xstats\" data-stagger>\n    <div class=\"xstat\">\n      <b><span data-count=\"150\">150</span><small>K sq ft</small></b>\n      <span>Dome</span>\n      \n    </div><div class=\"xstat\">\n      <b>12–15<small> acres</small></b>\n      <span>Sports &amp; education campus</span>\n      \n    </div><div class=\"xstat\">\n      <b><span data-count=\"10\">10</span></b>\n      <span>Domes — 5-year vision</span>\n      \n    </div>\n  </div>\n  \n  </div>\n</section>"},"elements":[]}]},{"id":"8594d13b","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.site-plan","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"42ec2331","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wh-plan\" data-el=\"whitby.site-plan\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow mb-s\">Site plan</p>\n      <h2 class=\"h2\">One village. Endless opportunities. A global impact.</h2>\n      <p class=\"body-lg muted\">Building the future of youth sports, education and community development in Whitby, Ontario.</p>\n    </div>\n    <figure class=\"figure figure--16x9 wh-plan__figure wipe\">\n      <img src=\"{{asset:img/whitby/site-aerial.jpg}}\" alt=\"Conceptual night aerial of the proposed village: the white multi-sport dome with lit A, F, S, V roof panels, outdoor basketball courts, a cluster of training, esports and learning buildings around a plaza with a globe sculpture, floodlit soccer and cricket fields, a red running track and a pond with a fountain. Not an existing facility.\" width=\"1920\" height=\"1080\" loading=\"lazy\">\n      <figcaption class=\"caption-bar\">Conceptual Rendering — Not an Existing Facility</figcaption>\n    </figure>\n    <ul class=\"wh-pillars\" aria-label=\"Village focus\"><li>Sports excellence</li><li>Education &amp; mentorship</li><li>Inclusion</li><li>Innovation</li><li>Global community</li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"8c75b20e","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.facilities","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"e2600758","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"whitby.facilities\" data-el-build=\"custom-widget\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow mb-s\">Proposed facilities</p>\n      <h2 class=\"h2\">Everything an athlete, student and family needs.</h2>\n    </div>\n    <div class=\"wh-fac\" data-stagger>\n      \n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/dome.jpg}}\" alt=\"Conceptual rendering of the proposed multi-sport inflatable dome. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">01</span></div>\n          <h3 class=\"h3\">Multi-Sport Inflatable Dome</h3>\n          <p class=\"muted\">A proposed 150,000 sq ft dome for year-round training under one roof.</p>\n          <ul><li>Full-size, competition-quality soccer field</li><li>Indoor track</li><li>Cricket nets</li><li>Multi-sport courts</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/soccer.jpg}}\" alt=\"Conceptual rendering of the proposed soccer fields. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">02</span></div>\n          <h3 class=\"h3\">Soccer Fields</h3>\n          <p class=\"muted\">Outdoor pitches for training and match play.</p>\n          <ul><li>Outdoor training fields</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/cricket.jpg}}\" alt=\"Conceptual rendering of the proposed cricket facility. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">03</span></div>\n          <h3 class=\"h3\">Cricket Facility</h3>\n          <p class=\"muted\">Dedicated nets and turf for the cricket pathway.</p>\n          <ul><li>Practice nets</li><li>Turf training pitches</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/track.jpg}}\" alt=\"Conceptual rendering of the proposed track &amp; field. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">04</span></div>\n          <h3 class=\"h3\">Track &amp; Field</h3>\n          <p class=\"muted\">A full athletics venue for sprint, jump and throw.</p>\n          <ul><li>400m track</li><li>Sprint lanes</li><li>Long jump / triple jump</li><li>Shot put / discus</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/basketball.jpg}}\" alt=\"Conceptual rendering of the proposed basketball courts. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">05</span></div>\n          <h3 class=\"h3\">Basketball Courts</h3>\n          <p class=\"muted\">Indoor and outdoor courts for play and development.</p>\n          <ul><li>Indoor &amp; outdoor courts</li><li>Skill development programs</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/hp.jpg}}\" alt=\"Conceptual rendering of the proposed high performance training centre. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">06</span></div>\n          <h3 class=\"h3\">High Performance Training Centre</h3>\n          <p class=\"muted\">Elite training for peak performance.</p>\n          <ul><li>Strength &amp; conditioning</li><li>Sports science lab</li><li>Recovery &amp; rehab</li><li>Athlete development programs</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/esports.jpg}}\" alt=\"Conceptual rendering of the proposed esports competition studio. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">07</span></div>\n          <h3 class=\"h3\">Esports Competition Studio</h3>\n          <p class=\"muted\">Compete. Stream. Connect. The future is digital.</p>\n          <ul><li>80–120 gaming stations (proposed)</li><li>Tournament stage</li><li>Streaming control centre</li><li>Content creation lab</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/learn.jpg}}\" alt=\"Conceptual rendering of the proposed learning &amp; mentorship centre. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">08</span></div>\n          <h3 class=\"h3\">Learning &amp; Mentorship Centre</h3>\n          <p class=\"muted\">Education today. Leaders tomorrow.</p>\n          <ul><li>Classrooms</li><li>Tutoring &amp; mentorship</li><li>Special needs support programs</li><li>Life skills development</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/media.jpg}}\" alt=\"Conceptual rendering of the proposed media &amp; broadcasting studio. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">09</span></div>\n          <h3 class=\"h3\">Media &amp; Broadcasting Studio</h3>\n          <p class=\"muted\">Where athlete stories are told.</p>\n          <ul><li>Podcast &amp; livestream studios</li><li>Sports Village Podcast Network</li><li>Athlete media content hub</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/spectators.jpg}}\" alt=\"Conceptual rendering of the proposed spectator seating &amp; events. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">10</span></div>\n          <h3 class=\"h3\">Spectator Seating &amp; Events</h3>\n          <p class=\"muted\">A community venue for big nights.</p>\n          <ul><li>Competitions &amp; showcases</li><li>Public programming</li><li>Community events</li></ul>\n        </div>\n      </article>\n      <article class=\"wh-fac__card\">\n        <figure><img src=\"{{asset:img/whitby/lounge.jpg}}\" alt=\"Conceptual rendering of the proposed community lounge. Not an existing facility.\" width=\"1200\" height=\"800\" loading=\"lazy\"></figure>\n        <div class=\"wh-fac__body\">\n          <div class=\"wh-fac__top\"><span class=\"num\">11</span></div>\n          <h3 class=\"h3\">Community Lounge</h3>\n          <p class=\"muted\">A space for families, partners and communities.</p>\n          <ul><li>Family &amp; partner hospitality</li><li>Community gatherings</li></ul>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"bd147bfc","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.roadmap","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"997a2230","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy roadmap\" data-el=\"whitby.roadmap\" data-el-build=\"elementor\" data-roadmap>\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\"><p class=\"eyebrow mb-s\">Development roadmap</p><h2 class=\"h2\">From pilot to national network.</h2><p class=\"body-lg\">Timelines are targets, subject to financing, approvals and feasibility.</p></div>\n    <ol class=\"roadmap__line\">\n      <li class=\"roadmap__step\" style=\"--i:0\"><span class=\"roadmap__dot\">1</span><span class=\"roadmap__year\">2026–2028</span><h3>Pilot project</h3><p>Secure financing, land and approvals, and construct the first Smart Sports Village dome in Ontario.</p></li><li class=\"roadmap__step\" style=\"--i:1\"><span class=\"roadmap__dot\">2</span><span class=\"roadmap__year\">2028–2029</span><h3>Regional expansion</h3><p>Expand across the region with additional facilities, programs and institutional partnerships.</p></li><li class=\"roadmap__step\" style=\"--i:2\"><span class=\"roadmap__dot\">3</span><span class=\"roadmap__year\">2029–2031</span><h3>National network</h3><p>A planned network of 10 domes across Canada.</p></li><li class=\"roadmap__step\" style=\"--i:3\"><span class=\"roadmap__dot\">4</span><span class=\"roadmap__year\">2031+</span><h3>International</h3><p>Caribbean and international expansion connecting diaspora communities through sport and education.</p></li>\n    </ol>\n  </div>\n</section>"},"elements":[]}]},{"id":"0448012c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.highlights","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"50fd82b0","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"whitby.highlights\" data-el-build=\"elementor\">\n  <div class=\"wrap section wh-hl\">\n    <div class=\"reveal\">\n      <p class=\"eyebrow mb-s\">Facility highlights</p>\n      <h2 class=\"h2 mb-m\">Built for every stage of the journey.</h2>\n      <ul class=\"wh-ticks wh-ticks--grid\"><li>Year-round training</li><li>State-of-the-art infrastructure</li><li>Multi-sport development</li><li>Education &amp; mentorship</li><li>Special needs inclusion</li><li>Esports &amp; innovation</li><li>Community engagement</li><li>Sustainable &amp; green design</li></ul>\n    </div>\n    <div class=\"wh-hl__card reveal\">\n      <p class=\"eyebrow mb-s\">Key features</p>\n      <ul class=\"wh-ticks\"><li>Serving athletes of all ages</li><li>Inclusive programs for every ability</li><li>Pathways to scholarships &amp; careers</li><li>Building stronger communities</li><li>Connecting the Caribbean diaspora</li><li>Creating a legacy for generations</li></ul>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"51870027","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.ecosystem","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"e4ab4a23","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"whitby.ecosystem\" data-el-build=\"elementor\">\n  <div class=\"wh-eco\">\n    <div class=\"reveal\">\n      <p class=\"eyebrow mb-s\">AFSVHCL ecosystem</p>\n      <h2 class=\"h2 mb-m\">Three divisions, one village.</h2>\n      <ol class=\"wh-eco__list\"><li><b>AFSV VRC Development Group Ltd.</b><span>Infrastructure development</span></li><li><b>MLMSR Mentorship LLC</b><span>Education &amp; special needs support</span></li><li><b>EFN — Esports &amp; Fans Network</b><span>Digital &amp; esports division</span></li></ol>\n    </div>\n    <blockquote class=\"wh-quote reveal\">\n      <p>Empowering youth. Strengthening communities. Building a legacy.</p>\n      <footer><b>Martin Lashley</b><span>Founder &amp; Chairman, AFSV VRC</span></footer>\n    </blockquote>\n  </div>\n</section>"},"elements":[]}]},{"id":"ce33427c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.smart","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"bd6cc587","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"whitby.smart\" data-el-build=\"elementor\">\n  <div class=\"wrap section split split--center\">\n    <div class=\"reveal\">\n      <p class=\"eyebrow mb-s\">Smart by design</p>\n      <h2 class=\"h2 mb-m\">Technology as infrastructure, not decoration.</h2>\n      <p class=\"lead\">Digital access, secure connectivity, facility sensors, automation, data-informed programming, modern signage and emerging technology—subject to privacy, security, design and procurement.</p>\n    </div>\n    <figure class=\"figure figure--16x9 figure--motion wipe\" data-video-scope><div class=\"pmedia\" data-parallax=\"0.08\"><img src=\"{{asset:img/life/cutaway.jpg}}\" alt=\"Concept rendering: a cutaway of the proposed dome at blue hour showing the floodlit pitch, running track, courts, a learning mezzanine and an esports studio, with crowds inside. Not an existing facility.\" width=\"1344\" height=\"752\" loading=\"lazy\"></div>\n      <figcaption class=\"caption-bar\">Conceptual Rendering — Not an Existing Facility</figcaption>\n    </figure>\n  </div>\n</section>"},"elements":[]}]},{"id":"f1113053","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.partnerships","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"5a2fe47d","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"whitby.partnerships\" data-el-build=\"elementor\">\n  <div class=\"split\">\n    <div class=\"reveal\">\n      <h2 class=\"h2 mb-m\">Partnership pathways.</h2>\n      <p class=\"body-lg muted mb-m\">Seven routes into the pilot, from municipal partners to retail and concessions.</p>\n      <div class=\"btn-row btn-row--stack\">\n        <a class=\"btn btn--navy\" href=\"#whitby-partner-form\">Become a Development Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n        <a class=\"btn btn--line-dark\" href=\"#whitby-partner-form\">Request the Project Brief<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n      </div>\n    </div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Municipal and public sector</span></li><li><span class=\"num\">02</span><span>Colleges and schools</span></li><li><span class=\"num\">03</span><span>Clubs and academies</span></li><li><span class=\"num\">04</span><span>Performance and inclusion providers</span></li><li><span class=\"num\">05</span><span>Technology and responsible AI</span></li><li><span class=\"num\">06</span><span>Sponsors and investors</span></li><li><span class=\"num\">07</span><span>Retail, concessions and marketplace</span></li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"a29f2037","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.disclaimer","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"76ef33eb","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"whitby.disclaimer\" data-el-build=\"elementor\">\n  <div class=\"callout\" role=\"note\"><span class=\"eyebrow\">Important</span><p style=\"font-size:15.5px;line-height:1.66\">The Whitby Smart Sports Village is a proposed development. Images, dimensions, uses, timelines, partnerships and features shown are conceptual and subject to feasibility, approvals, financing, final design and operating agreements.</p></div>\n</section>"},"elements":[]}]},{"id":"79ebc803","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"whitby.partner-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"b9824dc5","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section \" id=\"whitby-partner-form\" data-el=\"whitby.partner-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Request the project brief.</h2>\n      <p class=\"body-lg\">Tell us how your organisation would work with the pilot and we will share the current project materials.</p>\n      <p class=\"small muted\">Development preview — no documents are distributed from this form until the project brief is approved for release.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f6\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f6\" name=\"name\" autocomplete=\"name\" aria-describedby=\"f6-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f6-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f7\">Organisation<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f7\" name=\"organisation\" autocomplete=\"organization\" aria-describedby=\"f7-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f7-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f8\">Role<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f8\" name=\"role\" autocomplete=\"organization-title\" aria-describedby=\"f8-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f8-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f9\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f9\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f9-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f9-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f10\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f10\" name=\"phone\" autocomplete=\"tel\" aria-describedby=\"f10-err\">\n  \n  <span class=\"field__error\" id=\"f10-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f11\">Partnership type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f11\" name=\"partnership-type\" aria-describedby=\"f11-err\" required aria-required=\"true\"><option value=\"\">Select a type</option><option value=\"Municipal and public sector\">Municipal and public sector</option><option value=\"Colleges and schools\">Colleges and schools</option><option value=\"Clubs and academies\">Clubs and academies</option><option value=\"Performance and inclusion providers\">Performance and inclusion providers</option><option value=\"Technology and responsible AI\">Technology and responsible AI</option><option value=\"Sponsors and investors\">Sponsors and investors</option><option value=\"Retail, concessions and marketplace\">Retail, concessions and marketplace</option></select>\n  \n  <span class=\"field__error\" id=\"f11-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f12\">Message<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f12\" name=\"message\" aria-describedby=\"f12-err\" required aria-required=\"true\" rows=\"4\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f12-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f5\"><input type=\"checkbox\" id=\"f5\" name=\"consent\" required aria-describedby=\"f5-err\"><span>I agree to be contacted about partnership opportunities with AFSV VRC.<span class=\"field__error\" id=\"f5-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Submissions will route to the partnerships inbox once confirmed.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit request<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]}]}