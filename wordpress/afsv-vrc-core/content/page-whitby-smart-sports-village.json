     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"whitby.concept\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-l reveal\">Concept at a glance.</h2>\n  <div class=\"hairline\" style=\"--min:300px\" data-stagger>\n    \n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Scale</span><span class=\"pill\" style=\"font-size:9.5px;padding:4px 8px\">Proposed</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Approximately 150,000 sq ft in proposed Phase 1, subject to site, design, approvals and financing.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Sport</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Flexible soccer, cricket, basketball, sprint and configurable sport space.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Performance</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Performance, strength and conditioning, recovery, biomechanics and analytics.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Learning</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Learning, tutoring, mentoring, sensory support and life skills.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Media</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Esports, broadcasting, podcasting and content creation.</p>\n    </div>\n    <div class=\"cell\" style=\"min-height:190px\">\n      <div class=\"cell__top\"><span class=\"eyebrow\" style=\"font-size:11px;letter-spacing:.16em\">Community</span></div>\n      <p style=\"font-family:var(--font-display);font-weight:600;font-size:17px;line-height:1.44\">Events, partner activation, concessions, retail and fan experiences.</p>\n    </div>\n  </div>\n</section>"
     },
