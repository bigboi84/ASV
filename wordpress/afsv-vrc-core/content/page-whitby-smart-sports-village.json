     "id": "b0790c8d",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"whitby-partner-form\" data-el=\"whitby.partner-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Request the project brief.</h2>\n      <p class=\"body-lg\">Tell us how your organisation would work with the pilot and we will share the current project materials.</p>\n      <p class=\"small muted\">Development preview — no documents are distributed from this form until the project brief is approved for release.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:whitby-smart-sports-village}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f2\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f2\" name=\"name\" autocomplete=\"name\" aria-describedby=\"f2-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f2-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f3\">Organisation<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f3\" name=\"organisation\" autocomplete=\"organization\" aria-describedby=\"f3-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f3-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f4\">Role<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f4\" name=\"role\" autocomplete=\"organization-title\" aria-describedby=\"f4-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f4-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f5\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f5\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f5-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f5-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f6\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f6\" name=\"phone\" autocomplete=\"tel\" aria-describedby=\"f6-err\">\n  \n  <span class=\"field__error\" id=\"f6-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f7\">Partnership type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f7\" name=\"partnership-type\" aria-describedby=\"f7-err\" required aria-required=\"true\"><option value=\"\">Select a type</option><option value=\"Municipal and public sector\">Municipal and public sector</option><option value=\"Colleges and schools\">Colleges and schools</option><option value=\"Clubs and academies\">Clubs and academies</option><option value=\"Performance and inclusion providers\">Performance and inclusion providers</option><option value=\"Technology and responsible AI\">Technology and responsible AI</option><option value=\"Sponsors and investors\">Sponsors and investors</option><option value=\"Retail, concessions and marketplace\">Retail, concessions and marketplace</option></select>\n  \n  <span class=\"field__error\" id=\"f7-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f8\">Message<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f8\" name=\"message\" aria-describedby=\"f8-err\" required aria-required=\"true\" rows=\"4\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f8-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f1\"><input type=\"checkbox\" id=\"f1\" name=\"consent\" required aria-describedby=\"f1-err\"><span>I agree to be contacted about partnership opportunities with AFSV VRC.<span class=\"field__error\" id=\"f1-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Submissions will route to the partnerships inbox once confirmed.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit request<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
