     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"whitby.partnerships\" data-el-build=\"elementor\">\n  <div class=\"split\">\n    <div class=\"reveal\">\n      <h2 class=\"h2 mb-m\">Partnership pathways.</h2>\n      <p class=\"body-lg muted mb-m\">Seven routes into the pilot, from municipal partners to retail and concessions.</p>\n      <div class=\"btn-row btn-row--stack\">\n        <a class=\"btn btn--navy\" href=\"#whitby-partner-form\">Become a Development Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n        <a class=\"btn btn--line-dark\" href=\"#whitby-partner-form\">Request the Project Brief<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n      </div>\n    </div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Municipal and public sector</span></li><li><span class=\"num\">02</span><span>Colleges and schools</span></li><li><span class=\"num\">03</span><span>Clubs and academies</span></li><li><span class=\"num\">04</span><span>Performance and inclusion providers</span></li><li><span class=\"num\">05</span><span>Technology and responsible AI</span></li><li><span class=\"num\">06</span><span>Sponsors and investors</span></li><li><span class=\"num\">07</span><span>Retail, concessions and marketplace</span></li></ul>\n  </div>\n</section>"
     },
