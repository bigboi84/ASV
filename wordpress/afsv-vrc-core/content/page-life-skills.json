    {
     "id": "0494a3c7",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Program themes.</h2><p class=\"body-lg muted\">Thirteen themes, delivered in short blocks rather than as a single course.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Communication</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Personal organization</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Time management</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Financial literacy and budgeting</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Transportation</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Workplace readiness</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Self-advocacy</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Social interaction</span></div><div class=\"cell\"><span class=\"num\">09</span><span>Digital safety</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Personal responsibility</span></div><div class=\"cell\"><span class=\"num\">11</span><span>Goal setting</span></div><div class=\"cell\"><span class=\"num\">12</span><span>Leadership</span></div><div class=\"cell\"><span class=\"num\">13</span><span>Entrepreneurship</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
