    {
     "id": "80f5c65f",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Register interest.</h2>\n      <p class=\"body-lg\">For participants, families, and anyone offering to mentor or deliver.</p>\n      <p class=\"small muted\">Safeguarding screening applies to every mentor and delivery partner before contact with participants.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:life-skills}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f90\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f90\" name=\"name\" aria-describedby=\"f90-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f90-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f91\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f91\" name=\"email\" aria-describedby=\"f91-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f91-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f92\">Participant age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f92\" name=\"participant-age-range\" aria-describedby=\"f92-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option><option value=\"Not applicable\">Not applicable</option></select>\n  \n  <span class=\"field__error\" id=\"f92-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f93\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f93\" name=\"region\" aria-describedby=\"f93-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f93-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f94\">Topics of interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f94\" name=\"topics-of-interest\" aria-describedby=\"f94-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Communication\">Communication</option><option value=\"Personal organization\">Personal organization</option><option value=\"Time management\">Time management</option><option value=\"Financial literacy and budgeting\">Financial literacy and budgeting</option><option value=\"Transportation\">Transportation</option><option value=\"Workplace readiness\">Workplace readiness</option><option value=\"Self-advocacy\">Self-advocacy</option><option value=\"Social interaction\">Social interaction</option><option value=\"Digital safety\">Digital safety</option><option value=\"Goal setting\">Goal setting</option><option value=\"Leadership\">Leadership</option><option value=\"Entrepreneurship\">Entrepreneurship</option></select>\n  \n  <span class=\"field__error\" id=\"f94-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f95\">Preferred format <span class=\"opt\">(optional)</span></label>\n  <select id=\"f95\" name=\"preferred-format\" aria-describedby=\"f95-err\"><option value=\"\">Please select</option><option value=\"Workshop\">Workshop</option><option value=\"Mentoring\">Mentoring</option><option value=\"Integrated into training\">Integrated into training</option><option value=\"Either\">Either</option></select>\n  \n  <span class=\"field__error\" id=\"f95-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f96\">Preferred timeframe <span class=\"opt\">(optional)</span></label>\n  <select id=\"f96\" name=\"preferred-timeframe\" aria-describedby=\"f96-err\"><option value=\"\">Please select</option><option value=\"As soon as available\">As soon as available</option><option value=\"Next 3 months\">Next 3 months</option><option value=\"Next 6 months\">Next 6 months</option><option value=\"Just keeping in touch\">Just keeping in touch</option></select>\n  \n  <span class=\"field__error\" id=\"f96-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f97\">Mentor or delivery partner interest <span class=\"opt\">(optional)</span></label>\n  <select id=\"f97\" name=\"mentor-or-delivery-partner-interest\" aria-describedby=\"f97-err\"><option value=\"\">Please select</option><option value=\"No — participant or family\">No — participant or family</option><option value=\"Yes — mentor\">Yes — mentor</option><option value=\"Yes — delivery partner\">Yes — delivery partner</option><option value=\"Yes — sponsor\">Yes — sponsor</option></select>\n  \n  <span class=\"field__error\" id=\"f97-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f98\">Accommodation <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f98\" name=\"accommodation\" aria-describedby=\"f98-err\" rows=\"4\" placeholder=\"Optional\"></textarea>\n  \n  <span class=\"field__error\" id=\"f98-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f89\"><input type=\"checkbox\" id=\"f89\" name=\"consent\" required aria-describedby=\"f89-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f89-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
