   "elements": [
    {
     "id": "dfcbb56a",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">Delivery concept.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Workshops</h3><p style=\"font-size:15.5px\">Short facilitated sessions on a single theme, sized to fit inside an existing program block. Subject to approved facilitators and schedules.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Mentoring</h3><p style=\"font-size:15.5px\">One-to-one and small-group mentoring, with mentors screened before any participant contact.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Integrated modules</h3><p style=\"font-size:15.5px\">Themes built into athlete-development sessions so the learning is not separated from the training.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Family resources</h3><p style=\"font-size:15.5px\">Material families can use at home, written in plain language.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">05</span><h3 class=\"h3\">Partner-led learning</h3><p style=\"font-size:15.5px\">Sessions delivered by employer, education and community partners under the same safeguarding requirements.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
