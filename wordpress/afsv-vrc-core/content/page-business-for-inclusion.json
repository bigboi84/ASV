     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section section--flush-bottom\" data-el=\"page.list-tertiary\" data-el-build=\"elementor\">\n  <h2 class=\"h2 h2--sm mb-m reveal\">In-kind expertise we are seeking.</h2>\n  <ul class=\"tags\"><li>Legal</li><li>Accounting</li><li>Insurance</li><li>Technology</li><li>Cybersecurity</li><li>Marketing</li><li>Construction</li><li>Engineering</li><li>Architecture</li><li>Accessibility</li><li>HR</li><li>Recruitment</li><li>Transportation</li><li>Food</li><li>Equipment</li><li>Apparel</li><li>Media</li><li>Events</li></ul>\n</section>"
