     "settings": {
      "html": "<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Outcome-oriented opportunities.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Sponsorship framed around what it changes for a participant.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Sponsor a Child</span></li><li><span class=\"num\">02</span><span>Sponsor a Family</span></li><li><span class=\"num\">03</span><span>Inclusive Sport Sponsor</span></li><li><span class=\"num\">04</span><span>Academic Success Sponsor</span></li><li><span class=\"num\">05</span><span>Sensory Space Sponsor</span></li><li><span class=\"num\">06</span><span>Technology Access Sponsor</span></li><li><span class=\"num\">07</span><span>Employment Opportunity Sponsor</span></li><li><span class=\"num\">08</span><span>Founding Accessibility Partner</span></li></ul>\n  </div>\n</section>"
