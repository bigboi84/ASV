    {
     "id": "376c05f0",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">What a partnership involves.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Employer readiness</h3><p style=\"font-size:15.5px\">A review of recruitment practice, interview format and workplace environment before any candidate is introduced.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Role design</h3><p style=\"font-size:15.5px\">Roles written around the work that needs doing and the strengths of the candidate, not a generic job description.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Configurable contribution</h3><p style=\"font-size:15.5px\">Values and packages are set by an administrator, so nothing is hardcoded and nothing is published before approval.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Reviewed, not listed</h3><p style=\"font-size:15.5px\">A submission starts a review. It does not create a public listing, a logo placement or an announced partnership.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
