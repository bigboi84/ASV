    {
     "id": "145042fa",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Business and employer inquiries.</h2>\n      <p class=\"body-lg\">One form, routed by pathway. Investor and sponsorship inquiries reach different teams.</p>\n      <p class=\"small muted\">No sponsorship value is agreed by this form, and no partnership is published without written approval.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:business-for-inclusion}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f131\">Organization<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f131\" name=\"organization\" aria-describedby=\"f131-err\" required aria-required=\"true\" placeholder=\"Legal or trading name\">\n  \n  <span class=\"field__error\" id=\"f131-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f132\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f132\" name=\"contact-name\" aria-describedby=\"f132-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f132-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f133\">Title<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f133\" name=\"title\" aria-describedby=\"f133-err\" required aria-required=\"true\" placeholder=\"Your role\">\n  \n  <span class=\"field__error\" id=\"f133-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f134\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f134\" name=\"email\" aria-describedby=\"f134-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f134-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f135\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f135\" name=\"phone\" aria-describedby=\"f135-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f135-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f136\">Website <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f136\" name=\"website\" aria-describedby=\"f136-err\" placeholder=\"https://\">\n  \n  <span class=\"field__error\" id=\"f136-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f137\">Business size<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f137\" name=\"business-size\" aria-describedby=\"f137-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"1–10\">1–10</option><option value=\"11–50\">11–50</option><option value=\"51–250\">51–250</option><option value=\"251–1000\">251–1000</option><option value=\"1000+\">1000+</option></select>\n  \n  <span class=\"field__error\" id=\"f137-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f138\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f138\" name=\"region\" aria-describedby=\"f138-err\" required aria-required=\"true\" placeholder=\"City, region or national\">\n  \n  <span class=\"field__error\" id=\"f138-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f139\">Pathways<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f139\" name=\"pathways\" aria-describedby=\"f139-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Funding Partner\">Funding Partner</option><option value=\"Service Partner\">Service Partner</option><option value=\"In-Kind Partner\">In-Kind Partner</option><option value=\"Employment Partner\">Employment Partner</option><option value=\"Commercial Partner\">Commercial Partner</option><option value=\"Program Sponsor\">Program Sponsor</option><option value=\"Accessibility Partner\">Accessibility Partner</option></select>\n  \n  <span class=\"field__error\" id=\"f139-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f140\">Contribution interest <span class=\"opt\">(optional)</span></label>\n  <select id=\"f140\" name=\"contribution-interest\" aria-describedby=\"f140-err\"><option value=\"\">Please select</option><option value=\"Sponsor a Child\">Sponsor a Child</option><option value=\"Sponsor a Family\">Sponsor a Family</option><option value=\"Inclusive Sport Sponsor\">Inclusive Sport Sponsor</option><option value=\"Academic Success Sponsor\">Academic Success Sponsor</option><option value=\"Sensory Space Sponsor\">Sensory Space Sponsor</option><option value=\"Technology Access Sponsor\">Technology Access Sponsor</option><option value=\"Employment Opportunity Sponsor\">Employment Opportunity Sponsor</option><option value=\"Founding Accessibility Partner\">Founding Accessibility Partner</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f140-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f141\">Employment opportunities <span class=\"opt\">(optional)</span></label>\n  <select id=\"f141\" name=\"employment-opportunities\" aria-describedby=\"f141-err\"><option value=\"\">Please select</option><option value=\"Yes — roles available now\">Yes — roles available now</option><option value=\"Yes — in future\">Yes — in future</option><option value=\"Exploring\">Exploring</option><option value=\"No\">No</option></select>\n  \n  <span class=\"field__error\" id=\"f141-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f142\">In-kind services <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f142\" name=\"in-kind-services\" aria-describedby=\"f142-err\" rows=\"4\" placeholder=\"What your organisation could contribute\"></textarea>\n  \n  <span class=\"field__error\" id=\"f142-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f143\">Preferred contact <span class=\"opt\">(optional)</span></label>\n  <select id=\"f143\" name=\"preferred-contact\" aria-describedby=\"f143-err\"><option value=\"\">Please select</option><option value=\"Email\">Email</option><option value=\"Phone\">Phone</option></select>\n  \n  <span class=\"field__error\" id=\"f143-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f144\">Comments <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f144\" name=\"comments\" aria-describedby=\"f144-err\" rows=\"4\" placeholder=\"Anything else we should know\"></textarea>\n  \n  <span class=\"field__error\" id=\"f144-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f130\"><input type=\"checkbox\" id=\"f130\" name=\"consent\" required aria-describedby=\"f130-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f130-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
