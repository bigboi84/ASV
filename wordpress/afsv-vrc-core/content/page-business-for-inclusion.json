Transportation</li><li>Food</li><li>Equipment</li><li>Apparel</li><li>Media</li><li>Events</li></ul>\n</section>"},"elements":[]}]},{"id":"00b63417","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"nd.edu-cta","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"82818845","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"nd.edu-cta\" data-el-build=\"elementor\">\n  <a class=\"educta reveal\" href=\"{{url:/education-partnerships/}}\">\n    <span class=\"educta__k\">For schools, colleges &amp; learning organisations</span>\n    <span class=\"educta__t\">Partner with us in education.</span>\n    <span class=\"educta__go\">Become an education partner <span aria-hidden=\"true\">→</span></span>\n  </a>\n</section>"},"elements":[]}]},{"id":"60b88505","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"0ea0d369","elType":"widget","widgetType":"html","settings":{"html":"<section data-form-id=\"business-for-inclusion-interest\" class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Business and employer inquiries.</h2>\n      <p class=\"body-lg\">One form, routed by pathway. Investor and sponsorship inquiries reach different teams.</p>\n      <p class=\"small muted\">No sponsorship value is agreed by this form, and no partnership is published without written approval.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f119\">Organization<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f119\" name=\"organization\" aria-describedby=\"f119-err\" required aria-required=\"true\" placeholder=\"Legal or trading name\">\n  \n  <span class=\"field__error\" id=\"f119-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f120\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f120\" name=\"contact-name\" aria-describedby=\"f120-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f120-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f121\">Title<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f121\" name=\"title\" aria-describedby=\"f121-err\" required aria-required=\"true\" placeholder=\"Your role\">\n  \n  <span class=\"field__error\" id=\"f121-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f122\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f122\" name=\"email\" aria-describedby=\"f122-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f122-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f123\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f123\" name=\"phone\" aria-describedby=\"f123-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f123-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f124\">Website <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f124\" name=\"website\" aria-describedby=\"f124-err\" placeholder=\"https://\">\n  \n  <span class=\"field__error\" id=\"f124-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f125\">Business size<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f125\" name=\"business-size\" aria-describedby=\"f125-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"1–10\">1–10</option><option value=\"11–50\">11–50</option><option value=\"51–250\">51–250</option><option value=\"251–1000\">251–1000</option><option value=\"1000+\">1000+</option></select>\n  \n  <span class=\"field__error\" id=\"f125-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f126\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f126\" name=\"region\" aria-describedby=\"f126-err\" required aria-required=\"true\" placeholder=\"City, region or national\">\n  \n  <span class=\"field__error\" id=\"f126-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f127\">Pathways<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f127\" name=\"pathways\" aria-describedby=\"f127-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Funding Partner\">Funding Partner</option><option value=\"Service Partner\">Service Partner</option><option value=\"In-Kind Partner\">In-Kind Partner</option><option value=\"Employment Partner\">Employment Partner</option><option value=\"Commercial Partner\">Commercial Partner</option><option value=\"Program Sponsor\">Program Sponsor</option><option value=\"Accessibility Partner\">Accessibility Partner</option></select>\n  \n  <span class=\"field__error\" id=\"f127-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f128\">Contribution interest <span class=\"opt\">(optional)</span></label>\n  <select id=\"f128\" name=\"contribution-interest\" aria-describedby=\"f128-err\"><option value=\"\">Please select</option><option value=\"Sponsor a Child\">Sponsor a Child</option><option value=\"Sponsor a Family\">Sponsor a Family</option><option value=\"Inclusive Sport Sponsor\">Inclusive Sport Sponsor</option><option value=\"Academic Success Sponsor\">Academic Success Sponsor</option><option value=\"Sensory Space Sponsor\">Sensory Space Sponsor</option><option value=\"Technology Access Sponsor\">Technology Access Sponsor</option><option value=\"Employment Opportunity Sponsor\">Employment Opportunity Sponsor</option><option value=\"Founding Accessibility Partner\">Founding Accessibility Partner</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f128-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f129\">Employment opportunities <span class=\"opt\">(optional)</span></label>\n  <select id=\"f129\" name=\"employment-opportunities\" aria-describedby=\"f129-err\"><option value=\"\">Please select</option><option value=\"Yes — roles available now\">Yes — roles available now</option><option value=\"Yes — in future\">Yes — in future</option><option value=\"Exploring\">Exploring</option><option value=\"No\">No</option></select>\n  \n  <span class=\"field__error\" id=\"f129-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f130\">In-kind services <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f130\" name=\"in-kind-services\" aria-describedby=\"f130-err\" rows=\"4\" placeholder=\"What your organisation could contribute\"></textarea>\n  \n  <span class=\"field__error\" id=\"f130-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f131\">Preferred contact <span class=\"opt\">(optional)</span></label>\n  <select id=\"f131\" name=\"preferred-contact\" aria-describedby=\"f131-err\"><option value=\"\">Please select</option><option value=\"Email\">Email</option><option value=\"Phone\">Phone</option></select>\n  \n  <span class=\"field__error\" id=\"f131-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f132\">Comments <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f132\" name=\"comments\" aria-describedby=\"f132-err\" rows=\"4\" placeholder=\"Anything else we should know\"></textarea>\n  \n  <span class=\"field__error\" id=\"f132-err\" aria-live=\"polite\"></span>\n</div></div>\n  <p class=\"small muted form__privacy\">Please do not include diagnoses, medical records or financial documents in this form. If follow-up needs that information, our team will arrange a secure channel.</p>\n  <label class=\"check\" for=\"f118\"><input type=\"checkbox\" id=\"f118\" name=\"consent\" required aria-describedby=\"f118-err\"><span>I agree to AFSV VRC contacting me about this inquiry.<span class=\"field__error\" id=\"f118-err\"></span></span></label>\n\n  <label class=\"check\" for=\"f118m\"><input type=\"checkbox\" id=\"f118m\" name=\"marketing\" value=\"yes\"><span>Optional: send me occasional updates from AFSV VRC by email. I can unsubscribe at any time.</span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Your details have been received. We will be in touch with updates as plans are approved.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"5ade0003","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"dbf89917","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Sponsorship values are set per agreement, never published in advance.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/partners/}}\">Request partnership information<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}