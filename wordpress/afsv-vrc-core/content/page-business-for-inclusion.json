     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Participation pathways.</h2><p class=\"body-lg muted\">Seven ways a business can take part.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Funding Partner</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Service Partner</span></div><div class=\"cell\"><span class=\"num\">03</span><span>In-Kind Partner</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Employment Partner</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Commercial Partner</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Program Sponsor</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Accessibility Partner</span></div></div>\n</section>"
     },
