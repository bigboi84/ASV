{"slug":"business-for-inclusion","parent":"","title":"Business for Inclusion","description":"AFSV VRC is developing a network of businesses committed to creating opportunities for neurodivergent individuals and families.","chrome":"default","front":false,"elements":[{"id":"2ff26f8c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"4188cb60","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Neurodiversity</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Business for Inclusion</li></ol></nav>"},"elements":[]}]},{"id":"e3e42089","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"3dc690bb","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/bfi.jpg}}\" alt=\"Concept rendering: racially diverse neurodivergent young employees working confidently in the village cafe and team store with a supportive manager.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Business for Inclusion</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Your Business Can Help Remove Barriers\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Your</span></span> <span class=\"w\"><span style=\"--i:1\">Business</span></span> <span class=\"w\"><span style=\"--i:2\">Can</span></span> <span class=\"w\"><span style=\"--i:3\">Help</span></span> <span class=\"w\"><span style=\"--i:4\">Remove</span></span> <span class=\"w\"><span style=\"--i:5\">Barriers</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC is developing a network of businesses committed to creating opportunities for neurodivergent individuals and families.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Become a Corporate Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Sponsor a Program<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Become a Neuroinclusive Employer<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Contribute Services<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"fd1d0ba8","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"777c466e","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">Sponsorship values and packages are administrator-configurable and are not published. Submissions feed an internal review workflow and are never auto-published.</p></section>"},"elements":[]}]},{"id":"8fa19829","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"811ca76a","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Participation pathways.</h2><p class=\"body-lg muted\">Seven ways a business can take part.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Funding Partner</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Service Partner</span></div><div class=\"cell\"><span class=\"num\">03</span><span>In-Kind Partner</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Employment Partner</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Commercial Partner</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Program Sponsor</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Accessibility Partner</span></div></div>\n</section>"},"elements":[]}]},{"id":"9bfa2dd4","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"05a8a301","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">What a partnership involves.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Employer readiness</h3><p style=\"font-size:15.5px\">A review of recruitment practice, interview format and workplace environment before any candidate is introduced.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Role design</h3><p style=\"font-size:15.5px\">Roles written around the work that needs doing and the strengths of the candidate, not a generic job description.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Configurable contribution</h3><p style=\"font-size:15.5px\">Values and packages are set by an administrator, so nothing is hardcoded and nothing is published before approval.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Reviewed, not listed</h3><p style=\"font-size:15.5px\">A submission starts a review. It does not create a public listing, a logo placement or an announced partnership.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"2db395f4","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-secondary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"d167624f","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Outcome-oriented opportunities.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Sponsorship framed around what it changes for a participant.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Sponsor a Child</span></li><li><span class=\"num\">02</span><span>Sponsor a Family</span></li><li><span class=\"num\">03</span><span>Inclusive Sport Sponsor</span></li><li><span class=\"num\">04</span><span>Academic Success Sponsor</span></li><li><span class=\"num\">05</span><span>Sensory Space Sponsor</span></li><li><span class=\"num\">06</span><span>Technology Access Sponsor</span></li><li><span class=\"num\">07</span><span>Employment Opportunity Sponsor</span></li><li><span class=\"num\">08</span><span>Founding Accessibility Partner</span></li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"856b4123","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-tertiary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"a82b101c","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-bottom\" data-el=\"page.list-tertiary\" data-el-build=\"elementor\">\n  <h2 class=\"h2 h2--sm mb-m reveal\">In-kind expertise we are seeking.</h2>\n  <ul class=\"tags\"><li>Legal</li><li>Accounting</li><li>Insurance</li><li>Technology</li><li>Cybersecurity</li><li>Marketing</li><li>Construction</li><li>Engineering</li><li>Architecture</li><li>Accessibility</li><li>HR</li><li>Recruitment</li><li>Transportation</li><li>Food</li><li>Equipment</li><li>Apparel</li><li>Media</li><li>Events</li></ul>\n</section>"},"elements":[]}]},{"id":"77c3c394","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"nd.edu-cta","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"46bbb12d","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"nd.edu-cta\" data-el-build=\"elementor\">\n  <a class=\"educta reveal\" href=\"{{url:/education-partnerships/}}\">\n    <span class=\"educta__k\">For schools, colleges &amp; learning organisations</span>\n    <span class=\"educta__t\">Partner with us in education.</span>\n    <span class=\"educta__go\">Become an education partner <span aria-hidden=\"true\">→</span></span>\n  </a>\n</section>"},"elements":[]}]},{"id":"b423a7f7","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"19762f65","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Business and employer inquiries.</h2>\n      <p class=\"body-lg\">One form, routed by pathway. Investor and sponsorship inquiries reach different teams.</p>\n      <p class=\"small muted\">No sponsorship value is agreed by this form, and no partnership is published without written approval.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f118\">Organization<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f118\" name=\"organization\" aria-describedby=\"f118-err\" required aria-required=\"true\" placeholder=\"Legal or trading name\">\n  \n  <span class=\"field__error\" id=\"f118-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f119\">Contact name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f119\" name=\"contact-name\" aria-describedby=\"f119-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f119-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f120\">Title<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f120\" name=\"title\" aria-describedby=\"f120-err\" required aria-required=\"true\" placeholder=\"Your role\">\n  \n  <span class=\"field__error\" id=\"f120-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f121\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f121\" name=\"email\" aria-describedby=\"f121-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f121-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f122\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f122\" name=\"phone\" aria-describedby=\"f122-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f122-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f123\">Website <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f123\" name=\"website\" aria-describedby=\"f123-err\" placeholder=\"https://\">\n  \n  <span class=\"field__error\" id=\"f123-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f124\">Business size<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f124\" name=\"business-size\" aria-describedby=\"f124-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"1–10\">1–10</option><option value=\"11–50\">11–50</option><option value=\"51–250\">51–250</option><option value=\"251–1000\">251–1000</option><option value=\"1000+\">1000+</option></select>\n  \n  <span class=\"field__error\" id=\"f124-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f125\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f125\" name=\"region\" aria-describedby=\"f125-err\" required aria-required=\"true\" placeholder=\"City, region or national\">\n  \n  <span class=\"field__error\" id=\"f125-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f126\">Pathways<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f126\" name=\"pathways\" aria-describedby=\"f126-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Funding Partner\">Funding Partner</option><option value=\"Service Partner\">Service Partner</option><option value=\"In-Kind Partner\">In-Kind Partner</option><option value=\"Employment Partner\">Employment Partner</option><option value=\"Commercial Partner\">Commercial Partner</option><option value=\"Program Sponsor\">Program Sponsor</option><option value=\"Accessibility Partner\">Accessibility Partner</option></select>\n  \n  <span class=\"field__error\" id=\"f126-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f127\">Contribution interest <span class=\"opt\">(optional)</span></label>\n  <select id=\"f127\" name=\"contribution-interest\" aria-describedby=\"f127-err\"><option value=\"\">Please select</option><option value=\"Sponsor a Child\">Sponsor a Child</option><option value=\"Sponsor a Family\">Sponsor a Family</option><option value=\"Inclusive Sport Sponsor\">Inclusive Sport Sponsor</option><option value=\"Academic Success Sponsor\">Academic Success Sponsor</option><option value=\"Sensory Space Sponsor\">Sensory Space Sponsor</option><option value=\"Technology Access Sponsor\">Technology Access Sponsor</option><option value=\"Employment Opportunity Sponsor\">Employment Opportunity Sponsor</option><option value=\"Founding Accessibility Partner\">Founding Accessibility Partner</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f127-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f128\">Employment opportunities <span class=\"opt\">(optional)</span></label>\n  <select id=\"f128\" name=\"employment-opportunities\" aria-describedby=\"f128-err\"><option value=\"\">Please select</option><option value=\"Yes — roles available now\">Yes — roles available now</option><option value=\"Yes — in future\">Yes — in future</option><option value=\"Exploring\">Exploring</option><option value=\"No\">No</option></select>\n  \n  <span class=\"field__error\" id=\"f128-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f129\">In-kind services <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f129\" name=\"in-kind-services\" aria-describedby=\"f129-err\" rows=\"4\" placeholder=\"What your organisation could contribute\"></textarea>\n  \n  <span class=\"field__error\" id=\"f129-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f130\">Preferred contact <span class=\"opt\">(optional)</span></label>\n  <select id=\"f130\" name=\"preferred-contact\" aria-describedby=\"f130-err\"><option value=\"\">Please select</option><option value=\"Email\">Email</option><option value=\"Phone\">Phone</option></select>\n  \n  <span class=\"field__error\" id=\"f130-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f131\">Comments <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f131\" name=\"comments\" aria-describedby=\"f131-err\" rows=\"4\" placeholder=\"Anything else we should know\"></textarea>\n  \n  <span class=\"field__error\" id=\"f131-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f117\"><input type=\"checkbox\" id=\"f117\" name=\"consent\" required aria-describedby=\"f117-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f117-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"b68aa0c8","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.pending-inputs","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked"