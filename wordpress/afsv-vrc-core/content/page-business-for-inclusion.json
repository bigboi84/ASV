/span> <span class=\"w\"><span style=\"--i:2\">Can</span></span> <span class=\"w\"><span style=\"--i:3\">Help</span></span> <span class=\"w\"><span style=\"--i:4\">Remove</span></span> <span class=\"w\"><span style=\"--i:5\">Barriers</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC is developing a network of businesses committed to creating opportunities for neurodivergent individuals and families.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Become a Corporate Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Sponsor a Program<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Become a Neuroinclusive Employer<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Contribute Services<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"9c6d5f1d","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"bf41c088","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">Sponsorship values and packages will be shared directly with interested organisations. Every inquiry is reviewed by our team.</p></section>"},"elements":[]}]},{"id":"7c6df61a","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1c36efa2","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Participation pathways.</h2><p class=\"body-lg muted\">Seven ways a business can take part.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Funding Partner</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Service Partner</span></div><div class=\"cell\"><span class=\"num\">03</span><span>In-Kind Partner</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Employment Partner</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Commercial Partner</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Program Sponsor</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Accessibility Partner</span></div></div>\n</section>"},"elements":[]}]},{"id":"81ce90e0","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"811ed1ec","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">What a partnership involves.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Employer readiness</h3><p style=\"font-size:15.5px\">A review of recruitment practice, interview format and workplace environment before any candidate is introduced.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Role design</h3><p style=\"font-size:15.5px\">Roles written around the work that needs doing and the strengths of the candidate, not a generic job description.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Tailored contribution</h3><p style=\"font-size:15.5px\">Contribution levels and packages are agreed with each partner and shared once approved.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Reviewed, not listed</h3><p style=\"font-size:15.5px\">A submission starts a review. It does not create a public listing, a logo placement or an announced partnership.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"6c46648d","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-secondary","padding":{"unit":"px","top":"0","right":"0",