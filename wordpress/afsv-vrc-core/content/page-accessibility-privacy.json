   "elements": [
    {
     "id": "420cbe75",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"access.commitments\" data-el-build=\"elementor\">\n  <div class=\"hairline\" style=\"--min:290px\" data-stagger>\n    <div class=\"cell\" style=\"padding:40px 32px 44px;gap:18px\"><span class=\"num\">01</span><h2 style=\"font-weight:800;font-size:clamp(22px,2vw,28px)\">Accessibility</h2><p style=\"font-size:15.5px\">Target: WCAG 2.2 AA across the site.</p><ul class=\"dash-list\"><li>Keyboard navigation</li><li>Screen-reader compatibility</li><li>Alt text</li><li>Captioned video and transcripts</li><li>Tested contrast</li><li>Readable typography</li><li>Clear navigation</li><li>Descriptive buttons</li><li>Accessible forms</li><li>Logical headings</li><li>Reduced flashing and motion</li><li>Mobile accessibility</li><li>Plain language and clear errors</li></ul></div><div class=\"cell\" style=\"padding:40px 32px 44px;gap:18px\"><span class=\"num\">02</span><h2 style=\"font-weight:800;font-size:clamp(22px,2vw,28px)\">Privacy</h2><p style=\"font-size:15.5px\">Collect only what is necessary, and say why.</p><ul class=\"dash-list\"><li>Collect only necessary data</li><li>Clear notice and purpose</li><li>Explicit communications consent</li><li>Role-based access</li><li>Secure storage and transmission</li><li>Retention and deletion rules</li><li>Breach-response process</li><li>Approved analytics and cookie controls</li></ul></div><div class=\"cell\" style=\"padding:40px 32px 44px;gap:18px\"><span class=\"num\">03</span><h2 style=\"font-weight:800;font-size:clamp(22px,2vw,28px)\">Safeguarding</h2><p style=\"font-size:15.5px\">For children and vulnerable individuals.</p><ul class=\"dash-list\"><li>Consent and guardian controls</li><li>Staff and provider screening requirements</li><li>Reporting and escalation route</li><li>Photography and testimonial authorization</li><li>Restricted data access</li></ul></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
