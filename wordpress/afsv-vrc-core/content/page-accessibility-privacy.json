    {
     "id": "1d89c38d",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"support\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Accessibility and privacy contact.</h2>\n      <p class=\"body-lg\">Tell us what you ran into and how you would like us to reply. We treat accessibility reports as defects, not feedback.</p>\n      <p class=\"small muted\">We do not ask for proof of disability or any medical documentation. Safeguarding concerns are routed to a named owner and are not handled by general support.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:accessibility-privacy}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f181\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f181\" name=\"name\" aria-describedby=\"f181-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f181-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f182\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f182\" name=\"email\" aria-describedby=\"f182-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f182-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"issue-type\">Issue type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"issue-type\" name=\"issue-type\" aria-describedby=\"issue-type-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Accessibility support request\">Accessibility support request</option><option value=\"Report an accessibility issue\">Report an accessibility issue</option><option value=\"Privacy inquiry\">Privacy inquiry</option><option value=\"Safeguarding concern\">Safeguarding concern</option><option value=\"Something else\">Something else</option></select>\n  \n  <span class=\"field__error\" id=\"issue-type-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f183\">Page or service<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f183\" name=\"page-or-service\" aria-describedby=\"f183-err\" required aria-required=\"true\" placeholder=\"Where you ran into it\">\n  \n  <span class=\"field__error\" id=\"f183-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f184\">Preferred response<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f184\" name=\"preferred-response\" aria-describedby=\"f184-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Email\">Email</option><option value=\"Phone\">Phone</option><option value=\"Either\">Either</option></select>\n  \n  <span class=\"field__error\" id=\"f184-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f185\">Description<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f185\" name=\"description\" aria-describedby=\"f185-err\" required aria-required=\"true\" rows=\"4\" placeholder=\"What happened, and what you expected\"></textarea>\n  \n  <span class=\"field__error\" id=\"f185-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f186\">Accommodation for our reply <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f186\" name=\"accommodation-for-our-reply\" aria-describedby=\"f186-err\" rows=\"4\" placeholder=\"Optional\"></textarea>\n  \n  <span class=\"field__error\" id=\"f186-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f180\"><input type=\"checkbox\" id=\"f180\" name=\"consent\" required aria-describedby=\"f180-err\"><span>I agree to be contacted about this inquiry.<span class=\"field__error\" id=\"f180-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Send inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
