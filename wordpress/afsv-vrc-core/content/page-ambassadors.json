lite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f199\">Ambassador type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f199\" name=\"ambassador-type\" aria-describedby=\"f199-err\" required aria-required=\"true\"><option value=\"\">Select a type</option><option value=\"Brand Ambassadors\">Brand Ambassadors</option><option value=\"Social Media Influencers\">Social Media Influencers</option><option value=\"Athlete Ambassadors\">Athlete Ambassadors</option><option value=\"Community Champions\">Community Champions</option></select>\n  \n  <span class=\"field__error\" id=\"f199-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f200\">City <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f200\" name=\"city\" autocomplete=\"address-level2\" aria-describedby=\"f200-err\">\n  \n  <span class=\"field__error\" id=\"f200-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f201\">Social or portfolio link <span class=\"opt\">(optional)</span></label>\n  <input type=\"url\" id=\"f201\" name=\"social-or-portfolio-link\" aria-describedby=\"f201-err\">\n  \n  <span class=\"field__error\" id=\"f201-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f202\">Tell us about yourself <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f202\" name=\"tell-us-about-yourself\" aria-describedby=\"f202-err\" rows=\"4\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f202-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f196\"><input type=\"checkbox\" id=\"f196\" name=\"consent\" required aria-describedby=\"f196-err\"><span>I agree to be contacted about the AFSVHCL™ ambassador initiative.<span class=\"field__error\" id=\"f196-err\"></span></span></label>\n  <div class=\"form-