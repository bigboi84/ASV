{"slug":"become-a-member","parent":"","title":"Become a Member","description":"Become an AFSV VRC member. Membership opens soon — pre-register and we’ll email you the moment it goes live.","chrome":"default","front":false,"elements":[{"id":"9ea3b64a","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1b93985a","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li><a href=\"{{url:/membership/}}\">Membership</a></li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Become a Member</li></ol></nav>"},"elements":[]}]},{"id":"2edf92cf","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"ef0ef72d","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/lounge.jpg}}\" alt=\"Concept rendering: a racially diverse group of members, families and athletes relaxing in the village lounge overlooking the fields at dusk.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">AFSV VRC membership</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Become an AFSV VRC member.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Become</span></span> <span class=\"w\"><span style=\"--i:1\">an</span></span> <span class=\"w\"><span style=\"--i:2\">AFSV</span></span> <span class=\"w\"><span style=\"--i:3\">VRC</span></span> <span class=\"w\"><span style=\"--i:4\">member.</span></span></span></h1>\n      </div>\n      <span class=\"xhero__badge\">Pre-registration open</span>\n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">Membership opens soon. Pre-register in under a minute and we’ll email you the moment it goes live — no payment, no commitment.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#join\">Keep me up to date<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"1364a4f0","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"member.steps","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"327a1228","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"member.steps\" data-el-build=\"elementor\">\n  \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">How it works</p>\n    <h2 class=\"h2\">Three simple steps.</h2>\n    \n  </div>\n  \n  <ol class=\"psteps\" data-stagger>\n    <li class=\"psteps__item\"><span class=\"psteps__n\">01</span><h3>Pre-register</h3><p>Tell us your name, your email and what you’re most interested in. It takes less than a minute.</p></li><li class=\"psteps__item\"><span class=\"psteps__n\">02</span><h3>We keep you up to date</h3><p>You’ll hear from us as the village, programs and membership take shape — only the news that matters to you.</p></li><li class=\"psteps__item\"><span class=\"psteps__n\">03</span><h3>Join when it opens</h3><p>Pre-registered members are the first to know when membership goes live, with early access to join.</p></li>\n  </ol>\n</section>"},"elements":[]}]},{"id":"d0d6768b","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"member.form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"119aff1b","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" id=\"join\" data-el=\"member.form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Keep me up to date.</h2>\n      <p class=\"body-lg\">Pick what you’re interested in and we’ll make sure you hear about it first.</p>\n      <p class=\"small muted\">Have a question first? <a class=\"text-link\" href=\"{{url:/contact/}}\">Contact us</a>.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f162\">First name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f162\" name=\"first-name\" autocomplete=\"given-name\" aria-describedby=\"f162-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f162-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f163\">Last name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f163\" name=\"last-name\" autocomplete=\"family-name\" aria-describedby=\"f163-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f163-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f164\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f164\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f164-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f164-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f165\">I am interested in<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f165\" name=\"i-am-interested-in\" aria-describedby=\"f165-err\" required aria-required=\"true\"><option value=\"\">Choose one</option><option value=\"membership\">AFSV VRC membership</option><option value=\"business-membership\">Business membership</option><option value=\"sports-village\">Whitby Smart Sports Village</option><option value=\"programs\">Programs &amp; athlete development</option><option value=\"education\">Education &amp; academic success</option><option value=\"life-skills\">Life skills</option><option value=\"neurodiversity\">Neurodiversity support &amp; programs</option><option value=\"education-partnership\">Education partnership (neurodiversity)</option><option value=\"ambassador\">Becoming an ambassador</option><option value=\"partnership\">Partnership &amp; sponsorship</option><option value=\"diaspora\">Global Diaspora Network</option><option value=\"gaisb\">GAISB AI education</option><option value=\"marketplace\">Marketplace — shopping</option><option value=\"vendor\">Marketplace — selling my products</option><option value=\"other\">Something else</option></select>\n  \n  <span class=\"field__error\" id=\"f165-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f166\">Country<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f166\" name=\"country\" autocomplete=\"country-name\" aria-describedby=\"f166-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f166-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f167\">City <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f167\" name=\"city\" autocomplete=\"address-level2\" aria-describedby=\"f167-err\">\n  \n  <span class=\"field__error\" id=\"f167-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f161\"><input type=\"checkbox\" id=\"f161\" name=\"consent\" required aria-describedby=\"f161-err\"><span>Keep me up to date by email about AFSV VRC. I can unsubscribe at any time.<span class=\"field__error\" id=\"f161-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. When connected, you’ll be added to the pre-registration list and emailed when membership opens.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Keep me up to date<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"c71a6be2","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"member.benefits","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"234ec7d2","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"member.benefits\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">What membership is planned to include</p>\n    <h2 class=\"h2\">More than a membership.</h2>\n    \n  </div>\n    \n  <div class=\"kgrid kgrid--4\" data-stagger>\n    <article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"6.4\" r=\"2.4\"/><circle cx=\"5.4\" cy=\"9.4\" r=\"2\"/><circle cx=\"18.6\" cy=\"9.4\" r=\"2\"/><path d=\"M7.6 20.4v-2.6a4.4 4.4 0 0 1 8.8 0v2.6\"/><path d=\"M2.2 18.4v-1a3.2 3.2 0 0 1 4.8-2.8M21.8 18.4v-1a3.2 3.2 0 0 0-4.8-2.8\"/></svg></span>\n      <h3>Community</h3>\n      <p>Events, local chapters, volunteering and a global network built around youth development and inclusion.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3.6 12.4V4.4a.8.8 0 0 1 .8-.8h8l8 8-8.8 8.8z\"/><circle cx=\"8.2\" cy=\"8.2\" r=\"1.6\"/></svg></span>\n      <h3>Marketplace perks</h3>\n      <p>Member pricing, early access to new drops and member-only sales in the AFSV VRC Marketplace.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 6.6C9.8 5 6.6 4.6 3.4 5v13.4c3.2-.4 6.4 0 8.6 1.6 2.2-1.6 5.4-2 8.6-1.6V5c-3.2-.4-6.4 0-8.6 1.6z\"/><path d=\"M12 6.6v13.4\"/><path d=\"M15.8 10.4c.6-1 2.4-.8 2.4.6 0 1.2-2.4 2.6-2.4 2.6s-2.4-1.4-2.4-2.6c0-1.4 1.8-1.6 2.4-.6z\"/></svg></span>\n      <h3>Learning hub</h3>\n      <p>Parent webinars, career readiness, wellness and sport-development resources.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3.4l2.6 5.4 5.8.8-4.2 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z\"/></svg></span>\n      <h3>Impact you can see</h3>\n      <p>Part of every membership supports the Neurodivergent Inclusion Fund, reported every year.</p>\n      \n    </article>\n  </div>\n  </div>\n</section>"},"elements":[]}]}]}