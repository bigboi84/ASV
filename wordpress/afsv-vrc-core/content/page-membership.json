     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"membership.pathways\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\">Proposed pathways.</h2>\n    <div class=\"hairline\" style=\"--min:220px\" data-stagger>\n      \n      <div class=\"cell\" style=\"min-height:196px\">\n        <div class=\"cell__top\"><span class=\"num\">01</span><span class=\"pill pill--soft\">Proposed</span></div>\n        <h3 class=\"h3\" style=\"font-size:20px;margin-bottom:auto\">Athlete</h3>\n        <p class=\"small muted\">Benefits and pricing pending approval.</p>\n      </div>\n      <div class=\"cell\" style=\"min-height:196px\">\n        <div class=\"cell__top\"><span class=\"num\">02</span><span class=\"pill pill--soft\">Proposed</span></div>\n        <h3 class=\"h3\" style=\"font-size:20px;margin-bottom:auto\">Family</h3>\n        <p class=\"small muted\">Benefits and pricing pending approval.</p>\n      </div>\n      <div class=\"cell\" style=\"min-height:196px\">\n        <div class=\"cell__top\"><span class=\"num\">03</span><span class=\"pill pill--soft\">Proposed</span></div>\n        <h3 class=\"h3\" style=\"font-size:20px;margin-bottom:auto\">Supporter</h3>\n        <p class=\"small muted\">Benefits and pricing pending approval.</p>\n      </div>\n      <div class=\"cell\" style=\"min-height:196px\">\n        <div class=\"cell__top\"><span class=\"num\">04</span><span class=\"pill pill--soft\">Proposed</span></div>\n        <h3 class=\"h3\" style=\"font-size:20px;margin-bottom:auto\">Educator &amp; Coach</h3>\n        <p class=\"small muted\">Benefits and pricing pending approval.</p>\n      </div>\n      <div class=\"cell\" style=\"min-height:196px\">\n        <div class=\"cell__top\"><span class=\"num\">05</span><span class=\"pill pill--soft\">Proposed</span></div>\n        <h3 class=\"h3\" style=\"font-size:20px;margin-bottom:auto\">Corporate &amp; Community Partner</h3>\n        <p class=\"small muted\">Benefits and pricing pending approval.</p>\n      </div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
