     "settings": {
      "html": "<section class=\"wrap page-head\" data-el=\"membership.hero\" data-el-build=\"elementor\">\n  <div class=\"split split--center\">\n    <div>\n      <span class=\"pill mb-m\">Registration of interest only</span>\n      <h1 class=\"h1 split-words\" aria-label=\"Join the AFSV VRC community.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Join</span></span> <span class=\"w\"><span style=\"--i:1\">the</span></span> <span class=\"w\"><span style=\"--i:2\">AFSV</span></span> <span class=\"w\"><span style=\"--i:3\">VRC</span></span> <span class=\"w\"><span style=\"--i:4\">community.</span></span></span></h1>\n      <p class=\"lead measure mb-l\">Membership will connect athletes, families, supporters, educators, partners and community members to AFSV VRC programs, experiences and opportunities. Register your interest to receive approved launch updates and help shape the experience.</p>\n      <a class=\"btn btn--navy\" href=\"#membership-form\">Register Your Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    </div>\n    <figure class=\"figure figure--4x3 figure--motion wipe\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_223921_9668f2f9-4d2a-49b0-8ca8-50664f8257b8.mp4\" data-parallax=\"0.08\"><img src=\"{{asset:img/membership-community.jpg}}\" alt=\"A diverse group of adults talking together outside a sports facility entrance after a session, holding kit bags and water bottles in late afternoon light.\" width=\"1344\" height=\"752\" loading=\"lazy\"></div></figure>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
