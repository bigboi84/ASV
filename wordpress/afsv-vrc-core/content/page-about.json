     "id": "172a071d",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"about.model\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-l reveal\">What makes the model different.</h2>\n  <div class=\"model\" data-stagger>\n    \n    <div class=\"model__item\">\n      <svg class=\"model__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"7\" r=\"3.2\"/><path d=\"M5 20c.6-3.8 3.4-6 7-6s6.4 2.2 7 6\"/><path d=\"M12 14v3\"/></svg>\n      <span class=\"num\">01</span>\n      <h3>Whole-person development</h3>\n    </div>\n    <div class=\"model__item\">\n      <svg class=\"model__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h16M12 4v16\"/><circle cx=\"12\" cy=\"12\" r=\"8.5\"/></svg>\n      <span class=\"num\">02</span>\n      <h3>Inclusive by design</h3>\n    </div>\n    <div class=\"model__item\">\n      <svg class=\"model__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 20h18M6 20V9l6-5 6 5v11\"/><path d=\"M10 20v-5h4v5\"/></svg>\n      <span class=\"num\">03</span>\n      <h3>Smart infrastructure</h3>\n    </div>\n    <div class=\"model__item\">\n      <svg class=\"model__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"8\" cy=\"12\" r=\"4\"/><circle cx=\"16\" cy=\"12\" r=\"4\"/></svg>\n      <span class=\"num\">04</span>\n      <h3>Partnership-led delivery</h3>\n    </div>\n    <div class=\"model__item\">\n      <svg class=\"model__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 18l5-6 4 3 7-9\"/><path d=\"M15 6h5v5\"/></svg>\n      <span class=\"num\">05</span>\n      <h3>Scalable impact</h3>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
