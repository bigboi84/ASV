    {
     "id": "2ddae50e",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"about.story\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\"><h2 class=\"h2\">From a belief to a network.</h2><p class=\"body-lg muted\">How the AFSV VRC model grows, from its founding idea to the proposed Whitby pilot and the planned network beyond it.</p></div>\n    <ol class=\"timeline\" data-timeline>\n      \n      <li class=\"timeline__step\" style=\"--i:0\">\n        <span class=\"timeline__dot\" aria-hidden=\"true\"></span>\n        <span class=\"timeline__k\">The belief</span>\n        <h3 class=\"timeline__t\">Sport can transform communities</h3>\n        <p>when it is combined with education, technology and opportunity.</p>\n      </li>\n      <li class=\"timeline__step\" style=\"--i:1\">\n        <span class=\"timeline__dot\" aria-hidden=\"true\"></span>\n        <span class=\"timeline__k\">The ecosystem</span>\n        <h3 class=\"timeline__t\">AFSVHCL™</h3>\n        <p>An integrated platform combining sports science, education programs, esports engagement and community participation.</p>\n      </li>\n      <li class=\"timeline__step\" style=\"--i:2\">\n        <span class=\"timeline__dot\" aria-hidden=\"true\"></span>\n        <span class=\"timeline__k\">The pilot <span class=\"pill\">Proposed</span></span>\n        <h3 class=\"timeline__t\">Whitby Smart Sports Village</h3>\n        <p>A proposed year-round, technology-enabled destination in Whitby, Ontario.</p>\n      </li>\n      <li class=\"timeline__step\" style=\"--i:3\">\n        <span class=\"timeline__dot\" aria-hidden=\"true\"></span>\n        <span class=\"timeline__k\">The network <span class=\"pill\">Planned</span></span>\n        <h3 class=\"timeline__t\">Canada, the Caribbean and beyond</h3>\n        <p>A national network of multi-sport dome facilities and scalable initiatives in global markets.</p>\n      </li>\n    </ol>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
