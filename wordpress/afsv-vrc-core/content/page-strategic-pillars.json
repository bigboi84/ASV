{"slug":"strategic-pillars","parent":"","title":"Strategic Pillars","description":"Four pillars, one purpose: sports development, education and academic success, neurodivergent support and inclusive education, and life skills.","chrome":"default","front":false,"elements":[{"id":"6a8b66e0","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"8909e99c","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li><a href=\"{{url:/about/}}\">About</a></li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Strategic Pillars</li></ol></nav>"},"elements":[]}]},{"id":"781e8cc4","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"pillars.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"9e2b0b5a","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap page-head\" data-el=\"pillars.hero\" data-el-build=\"elementor\">\n  <p class=\"eyebrow\">Strategic Pillars</p>\n  <h1 class=\"h1 split-words\" style=\"max-width:20ch;margin-bottom:44px\" aria-label=\"Four pillars. One purpose: helping people thrive.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Four</span></span> <span class=\"w\"><span style=\"--i:1\">pillars.</span></span> <span class=\"w\"><span style=\"--i:2\">One</span></span> <span class=\"w\"><span style=\"--i:3\">purpose:</span></span> <span class=\"w\"><span style=\"--i:4\">helping</span></span> <span class=\"w\"><span style=\"--i:5\">people</span></span> <span class=\"w\"><span style=\"--i:6\">thrive.</span></span></span></h1>\n  <figure class=\"figure figure--21x9 figure--motion wipe\" data-video-scope><div class=\"pmedia\" data-parallax=\"0.08\"><img src=\"{{asset:img/life/hall.jpg}}\" alt=\"Concept rendering: racially diverse youth athletes training basketball, sprints and futsal in a busy multi-sport hall at night, with coaches cheering them on.\" width=\"1344\" height=\"752\" loading=\"lazy\"></div></figure>\n</section>"},"elements":[]}]},{"id":"c69b4382","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"pillars.grid","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"ca8f9137","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"pillars.grid\" data-el-build=\"elementor\">\n  <div class=\"hairline\" style=\"--min:330px\" data-stagger>\n    \n    <a class=\"cell cell--link\" href=\"{{url:/programs/}}\" style=\"padding:42px 36px 44px;gap:20px\">\n      <span class=\"num\">01</span>\n      <h2 style=\"font-weight:700;font-size:clamp(21px,1.8vw,26px);line-height:1.2\">Sports Development</h2>\n      <p style=\"font-size:15.5px\">Create structured pathways that help participants discover, develop and maximize athletic potential through coaching, training, competition, performance support and exposure.</p>\n      \n      <span class=\"cell__foot\">Programs &amp; Athlete Development <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span>\n    </a>\n    <a class=\"cell cell--link\" href=\"{{url:/education/}}\" style=\"padding:42px 36px 44px;gap:20px\">\n      <span class=\"num\">02</span>\n      <h2 style=\"font-weight:700;font-size:clamp(21px,1.8vw,26px);line-height:1.2\">Education &amp; Academic Success</h2>\n      <p style=\"font-size:15.5px\">Support learners with tutoring, mentoring, academic enrichment, career awareness and environments connecting classroom achievement with confidence.</p>\n      \n      <span class=\"cell__foot\">Education &amp; Academic Success <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span>\n    </a>\n    <a class=\"cell cell--link\" href=\"{{url:/neurodiversity/}}\" style=\"padding:42px 36px 44px;gap:20px\">\n      <span class=\"num\">03</span>\n      <h2 style=\"font-weight:700;font-size:clamp(21px,1.8vw,26px);line-height:1.2\">Neurodivergent Support &amp; Inclusive Education</h2>\n      <p style=\"font-size:15.5px\">Develop welcoming spaces, informed programming and practical supports for people with autism, ADHD, dyslexia and other learning, developmental or sensory differences.</p>\n      <p class=\"note\" style=\"padding:13px 15px;font-size:13.5px\">Regulated/clinical services remain subject to qualified providers and approvals.</p>\n      <span class=\"cell__foot\">Neurodiversity Access &amp; Opportunity <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span>\n    </a>\n    <a class=\"cell cell--link\" href=\"{{url:/life-skills/}}\" style=\"padding:42px 36px 44px;gap:20px\">\n      <span class=\"num\">04</span>\n      <h2 style=\"font-weight:700;font-size:clamp(21px,1.8vw,26px);line-height:1.2\">Life Skills</h2>\n      <p style=\"font-size:15.5px\">Equip young people and families with tools for leadership, communication, financial literacy, entrepreneurship, career preparation, wellbeing and responsible decision-making.</p>\n      \n      <span class=\"cell__foot\">Life Skills <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></span>\n    </a>\n  </div>\n</section>"},"elements":[]}]},{"id":"a6293fb9","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"pillars.together","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"2d814dfe","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"pillars.together\" data-el-build=\"elementor\">\n  <div class=\"wrap section split split--center\">\n    <h2 class=\"h2 reveal\">How they work together.</h2>\n    <div class=\"reveal\">\n      <p class=\"lead mb-l\">Every program should connect athletic participation with at least one broader development outcome.</p>\n      <a class=\"btn btn--gold\" href=\"{{url:/programs/}}\">Explore Programs and Partnerships<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}