     "id": "f25d6540",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Potential sponsored outcomes.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Framed by what the funding changes, not by a price.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Participant and family access</span></li><li><span class=\"num\">02</span><span>Inclusive sport</span></li><li><span class=\"num\">03</span><span>Education</span></li><li><span class=\"num\">04</span><span>Sensory environments</span></li><li><span class=\"num\">05</span><span>Technology</span></li><li><span class=\"num\">06</span><span>Employment preparation</span></li></ul>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
  {
