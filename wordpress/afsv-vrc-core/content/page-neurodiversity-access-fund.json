     "id": "518a589a",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Potential sources.</h2><p class=\"body-lg muted\">Ten possible sources. None is confirmed, and none implies charitable status.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Corporate sponsorship</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Business contributions</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Individual contributions where legally permitted</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Grants</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Foundations</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Community fundraising</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Events</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Designated commercial revenues</span></div><div class=\"cell\"><span class=\"num\">09</span><span>In-kind services</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Equipment and program sponsorship</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
  {
   "id": "81562382",
   "elType": "container",
   "isInner": false,
   "settings": {
