    {
     "id": "06397e5b",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"page-hero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap page-hero__grid\">\n    <div class=\"page-hero__text\">\n      <p class=\"eyebrow eyebrow-rule\">Neurodiversity Access Fund</p>\n      <h1 class=\"h1 split-words\" aria-label=\"Helping Remove the Cost Barrier\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Helping</span></span> <span class=\"w\"><span style=\"--i:1\">Remove</span></span> <span class=\"w\"><span style=\"--i:2\">the</span></span> <span class=\"w\"><span style=\"--i:3\">Cost</span></span> <span class=\"w\"><span style=\"--i:4\">Barrier</span></span></span></h1>\n      <p class=\"lead\">AFSV VRC intends to develop a funding mechanism helping eligible individuals and families access selected programs and services regardless of financial circumstances.</p>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"#interest\">Express Funding Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"#interest\">Sponsor an Outcome<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/partners/}}\">Request Partnership Information<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n    <div class=\"page-hero__media\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_224023_bbcc82ac-0181-4310-b499-fa36f9a6cdbf.mp4\" data-parallax=\"0.06\"><img src=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20260916_034001_add183b2-54d1-46ef-b05b-ee45a723c9e0.png\" alt=\"A quiet still-life on a long charcoal table: trainers, a notebook and pen, a tablet, a water bottle, a folded towel and keys, evenly spaced in soft side light — everyday things that access makes possible.\" width=\"1344\" height=\"752\" fetchpriority=\"high\"></div></div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
