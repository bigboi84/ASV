   "elements": [
    {
     "id": "e04df9af",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">How the mechanism is intended to work.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Configurable outcomes</h3><p style=\"font-size:15.5px\">Sponsored outcomes and their values are administrator-configurable. Nothing is hardcoded and nothing is published before approval.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">No payment route</h3><p style=\"font-size:15.5px\">There is no Donate button and no payment processing anywhere on this page. Expressions of interest are handled by people, not a gateway.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Eligibility later</h3><p style=\"font-size:15.5px\">Eligibility thresholds, award schedules and application windows follow legal, accounting and privacy sign-off.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Reported in aggregate</h3><p style=\"font-size:15.5px\">Awards are recorded for governance and reported in aggregate. No identifying participant information is published.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
