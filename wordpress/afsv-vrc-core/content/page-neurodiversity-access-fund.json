    {
     "id": "f938c87e",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Express funding interest.</h2>\n      <p class=\"body-lg\">For sponsors, businesses and contributors. This starts a conversation — it does not transfer any funds.</p>\n      <p class=\"small muted\">This is an expression of interest, not a donation. No receipt, deductibility or funding commitment follows from it.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:neurodiversity-access-fund}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f165\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f165\" name=\"name\" aria-describedby=\"f165-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f165-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f166\">Organization <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f166\" name=\"organization\" aria-describedby=\"f166-err\" placeholder=\"Organization, if applicable\">\n  \n  <span class=\"field__error\" id=\"f166-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f167\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f167\" name=\"email\" aria-describedby=\"f167-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f167-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f168\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f168\" name=\"phone\" aria-describedby=\"f168-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f168-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f169\">Contribution type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f169\" name=\"contribution-type\" aria-describedby=\"f169-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Corporate sponsorship\">Corporate sponsorship</option><option value=\"Business contribution\">Business contribution</option><option value=\"Individual contribution\">Individual contribution</option><option value=\"Grant or foundation\">Grant or foundation</option><option value=\"Community fundraising\">Community fundraising</option><option value=\"Event\">Event</option><option value=\"In-kind services\">In-kind services</option><option value=\"Equipment\">Equipment</option><option value=\"Program sponsorship\">Program sponsorship</option></select>\n  \n  <span class=\"field__error\" id=\"f169-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f170\">Outcome interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f170\" name=\"outcome-interest\" aria-describedby=\"f170-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Participant and family access\">Participant and family access</option><option value=\"Inclusive sport\">Inclusive sport</option><option value=\"Education\">Education</option><option value=\"Sensory environments\">Sensory environments</option><option value=\"Technology\">Technology</option><option value=\"Employment preparation\">Employment preparation</option><option value=\"No preference\">No preference</option></select>\n  \n  <span class=\"field__error\" id=\"f170-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f171\">Proposed value range <span class=\"opt\">(optional)</span></label>\n  <select id=\"f171\" name=\"proposed-value-range\" aria-describedby=\"f171-err\"><option value=\"\">Please select</option><option value=\"Prefer to discuss\">Prefer to discuss</option><option value=\"Under $5,000\">Under $5,000</option><option value=\"$5,000–$25,000\">$5,000–$25,000</option><option value=\"$25,000–$100,000\">$25,000–$100,000</option><option value=\"Over $100,000\">Over $100,000</option></select>\n  \n  <span class=\"field__error\" id=\"f171-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f172\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f172\" name=\"region\" aria-describedby=\"f172-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f172-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f173\">Message <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f173\" name=\"message\" aria-describedby=\"f173-err\" rows=\"4\" placeholder=\"What you would like to support\"></textarea>\n  \n  <span class=\"field__error\" id=\"f173-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f164\"><input type=\"checkbox\" id=\"f164\" name=\"consent\" required aria-describedby=\"f164-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f164-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
