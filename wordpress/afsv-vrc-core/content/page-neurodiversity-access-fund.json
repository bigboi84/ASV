     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">AFSV VRC is not a charity. No donation receipt, tax deductibility, eligibility, funding availability or free service is promised. Contribution and payment functionality remains disabled until legal structure, accounting, privacy, eligibility and fund-administration rules are approved. The form below is an expression of interest, not a donation.</p></section>"
     },
     "elements": []
    }
   ]
