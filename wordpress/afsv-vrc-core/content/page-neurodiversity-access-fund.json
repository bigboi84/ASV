{"slug":"neurodiversity-access-fund","parent":"","title":"Neurodiversity Access Fund","description":"AFSV VRC intends to develop a funding mechanism helping eligible individuals and families access selected programs and services regardless of financial circumstances.","chrome":"default","front":false,"elements":[{"id":"f52cfa07","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"8b3baff0","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Neurodiversity</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Neurodiversity Access Fund</li></ol></nav>"},"elements":[]}]},{"id":"e541f2ed","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"354247e3","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/fund.jpg}}\" alt=\"Concept rendering: families from many backgrounds meeting support coordinators; a mother hugs her son holding an assistive tablet.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Neurodiversity Access Fund</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Helping Remove the Cost Barrier\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Helping</span></span> <span class=\"w\"><span style=\"--i:1\">Remove</span></span> <span class=\"w\"><span style=\"--i:2\">the</span></span> <span class=\"w\"><span style=\"--i:3\">Cost</span></span> <span class=\"w\"><span style=\"--i:4\">Barrier</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC intends to develop a funding mechanism helping eligible individuals and families access selected programs and services regardless of financial circumstances.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Express Funding Interest<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"#interest\">Sponsor an Outcome<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/partners/}}\">Request Partnership Information<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"e3804994","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"c8b603f5","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">AFSV VRC is not a charity. No donation receipt, tax deductibility, eligibility, funding availability or free service is promised. Contribution and payment functionality remains disabled until legal structure, accounting, privacy, eligibility and fund-administration rules are approved. The form below is an expression of interest, not a donation.</p></section>"},"elements":[]}]},{"id":"dd95ac10","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"72b5e6ce","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Potential sources.</h2><p class=\"body-lg muted\">Ten possible sources. None is confirmed, and none implies charitable status.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Corporate sponsorship</span></div><div class=\"cell\"><span class=\"num\">02</span><span>Business contributions</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Individual contributions where legally permitted</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Grants</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Foundations</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Community fundraising</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Events</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Designated commercial revenues</span></div><div class=\"cell\"><span class=\"num\">09</span><span>In-kind services</span></div><div class=\"cell\"><span class=\"num\">10</span><span>Equipment and program sponsorship</span></div></div>\n</section>"},"elements":[]}]},{"id":"7210308c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"dd3b17ed","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">How the mechanism is intended to work.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Configurable outcomes</h3><p style=\"font-size:15.5px\">Sponsored outcomes and their values are administrator-configurable. Nothing is hardcoded and nothing is published before approval.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">No payment route</h3><p style=\"font-size:15.5px\">There is no Donate button and no payment processing anywhere on this page. Expressions of interest are handled by people, not a gateway.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Eligibility later</h3><p style=\"font-size:15.5px\">Eligibility thresholds, award schedules and application windows follow legal, accounting and privacy sign-off.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Reported in aggregate</h3><p style=\"font-size:15.5px\">Awards are recorded for governance and reported in aggregate. No identifying participant information is published.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"8aefb18c","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-secondary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"5181f5b4","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Potential sponsored outcomes.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Framed by what the funding changes, not by a price.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Participant and family access</span></li><li><span class=\"num\">02</span><span>Inclusive sport</span></li><li><span class=\"num\">03</span><span>Education</span></li><li><span class=\"num\">04</span><span>Sensory environments</span></li><li><span class=\"num\">05</span><span>Technology</span></li><li><span class=\"num\">06</span><span>Employment preparation</span></li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"db1889dd","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"nd.edu-cta","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1a3a9d9a","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"nd.edu-cta\" data-el-build=\"elementor\">\n  <a class=\"educta reveal\" href=\"{{url:/education-partnerships/}}\">\n    <span class=\"educta__k\">For schools, colleges &amp; learning organisations</span>\n    <span class=\"educta__t\">Partner with us in education.</span>\n    <span class=\"educta__go\">Become an education partner <span aria-hidden=\"true\">→</span></span>\n  </a>\n</section>"},"elements":[]}]},{"id":"a0756a26","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"dd1cf7a9","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Express funding interest.</h2>\n      <p class=\"body-lg\">For sponsors, businesses and contributors. This starts a conversation — it does not transfer any funds.</p>\n      <p class=\"small muted\">This is an expression of interest, not a donation. No receipt, deductibility or funding commitment follows from it.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f152\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f152\" name=\"name\" aria-describedby=\"f152-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f152-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f153\">Organization <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f153\" name=\"organization\" aria-describedby=\"f153-err\" placeholder=\"Organization, if applicable\">\n  \n  <span class=\"field__error\" id=\"f153-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f154\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f154\" name=\"email\" aria-describedby=\"f154-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f154-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f155\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f155\" name=\"phone\" aria-describedby=\"f155-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f155-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f156\">Contribution type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f156\" name=\"contribution-type\" aria-describedby=\"f156-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Corporate sponsorship\">Corporate sponsorship</option><option value=\"Business contribution\">Business contribution</option><option value=\"Individual contribution\">Individual contribution</option><option value=\"Grant or foundation\">Grant or foundation</option><option value=\"Community fundraising\">Community fundraising</option><option value=\"Event\">Event</option><option value=\"In-kind services\">In-kind services</option><option value=\"Equipment\">Equipment</option><option value=\"Program sponsorship\">Program sponsorship</option></select>\n  \n  <span class=\"field__error\" id=\"f156-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f157\">Outcome interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f157\" name=\"outcome-interest\" aria-describedby=\"f157-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Participant and family access\">Participant and family access</option><option value=\"Inclusive sport\">Inclusive sport</option><option value=\"Education\">Education</option><option value=\"Sensory environments\">Sensory environments</option><option value=\"Technology\">Technology</option><option value=\"Employment preparation\">Employment preparation</option><option value=\"No preference\">No preference</option></select>\n  \n  <span class=\"field__error\" id=\"f157-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f158\">Proposed value range <span class=\"opt\">(optional)</span></label>\n  <select id=\"f158\" name=\"proposed-value-range\" aria-describedby=\"f158-err\"><option value=\"\">Please select</option><option value=\"Prefer to discuss\">Prefer to discuss</option><option value=\"Under $5,000\">Under $5,000</option><option value=\"$5,000–$25,000\">$5,000–$25,000</option><option value=\"$25,000–$100,000\">$25,000–$100,000</option><option value=\"Over $100,000\">Over $100,000</option></select>\n  \n  <span class=\"field__error\" id=\"f158-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f159\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f159\" name=\"region\" aria-describedby=\"f159-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f159-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f160\">Message <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f160\" name=\"message\" aria-describedby=\"f160-err\" rows=\"4\" placeholder=\"What you would like to support\"></textarea>\n  \n  <span class=\"field__error\" id=\"f160-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f151\"><input type=\"checkbox\" id=\"f151\" name=\"consent\" required aria-describedby=\"f151-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f151-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"2b8d7a63","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.pending-inputs","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"5fe485e0","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.pending-inputs\" data-el-build=\"elementor\" style=\"padding-bottom:88px\">\n  <div class=\"pending\"><span class=\"eyebrow\">Pending inputs</span>\n    <p>Page copy follows the approved brief. Still outstanding: final photography, approved logos and partner permissions, mailbox routing, legal policies, operational program data, pricing, dates and a named content owner.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"f838b92b","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"a0deea9f","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Businesses fund access through Business for Inclusion.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/business-for-inclusion/}}\">Business for Inclusion<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}