    {
     "id": "2bff1ba8",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Program pathways.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Eight pathways, each qualified until the service behind it is approved.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Qualified developmental services</span></li><li><span class=\"num\">02</span><span>Inclusive sport</span></li><li><span class=\"num\">03</span><span>Sensory-friendly environments</span></li><li><span class=\"num\">04</span><span>Education and academic success</span></li><li><span class=\"num\">05</span><span>Life skills</span></li><li><span class=\"num\">06</span><span>Esports and technology</span></li><li><span class=\"num\">07</span><span>Employment and entrepreneurship</span></li><li><span class=\"num\">08</span><span>Family resources</span></li></ul>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
