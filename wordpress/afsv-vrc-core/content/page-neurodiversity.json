{"slug":"neurodiversity","parent":"","title":"Neurodiversity Access & Opportunity","description":"AFSV VRC is developing an inclusive ecosystem intended to expand access to sport, education, developmental support, life skills, technology and employment for neurodivergent people. Through qualified professionals, community organizations, businesses, sponsors and employers, the program intends to reduce financial and accessibility barriers.","chrome":"default","front":false,"elements":[{"id":"146fa476","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"d808f467","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li>Neurodiversity</li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Neurodiversity Access &amp; Opportunity</li></ol></nav>"},"elements":[]}]},{"id":"f0d21014","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"16bed3a2","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/nd.jpg}}\" alt=\"Concept rendering: racially diverse kids and teens enjoying an adapted soccer session with patient coaches, one boy wearing ear defenders.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Neurodiversity Access &amp; Opportunity</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Different Minds. Equal Opportunity.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Different</span></span> <span class=\"w\"><span style=\"--i:1\">Minds.</span></span> <span class=\"w\"><span style=\"--i:2\">Equal</span></span> <span class=\"w\"><span style=\"--i:3\">Opportunity.</span></span></span></h1>\n      </div>\n      \n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">AFSV VRC is developing an inclusive ecosystem intended to expand access to sport, education, developmental support, life skills, technology and employment for neurodivergent people. Through qualified professionals, community organizations, businesses, sponsors and employers, the program intends to reduce financial and accessibility barriers.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#interest\">Get Support / Keep Up to Date<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/service-provider-network/}}\">Become a Service Provider<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/business-for-inclusion/}}\">Become a Neuroinclusive Employer<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"{{url:/neurodiversity-access-fund/}}\">Sponsor Access<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"f6fc88a2","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"status.mandatory-note","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"d18b2bd3","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"status.mandatory-note\" data-el-build=\"elementor\" style=\"padding-top:56px\"><p class=\"note\" role=\"note\">AFSV VRC does not provide clinical diagnosis, assessment or therapeutic treatment. Regulated services are delivered only by qualified professionals who are reviewed separately, and the public form does not ask for diagnoses or medical records.</p></section>"},"elements":[]}]},{"id":"446b9b28","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-primary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"4cdc1a1c","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Who it supports.</h2><p class=\"body-lg muted\">Written as the community describes itself. Identity-first and person-first preferences are both respected.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Autism</span></div><div class=\"cell\"><span class=\"num\">02</span><span>ADHD</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Dyslexia and learning differences</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Communication differences</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Intellectual and developmental disabilities</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Executive-function challenges</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Sensory-processing differences</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Other neurodevelopmental needs</span></div></div>\n</section>"},"elements":[]}]},{"id":"28ac2058","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.blocks","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"dd27d784","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">Four routes in, four owners.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Individuals</h3><p style=\"font-size:15.5px\">Ask about programs and support, and hear back from a named contact rather than a general inbox.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Families and carers</h3><p style=\"font-size:15.5px\">Plain-language information, a vetted provider directory, and help working out what is available.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Professionals and providers</h3><p style=\"font-size:15.5px\">Apply to join the Service Provider Network, subject to qualification, insurance and safeguarding review.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Businesses and employers</h3><p style=\"font-size:15.5px\">Join Business for Inclusion as a funding, service, employment, commercial or accessibility partner.</p></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"e0969a70","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.list-secondary","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"22221bc4","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"page.list-secondary\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Program pathways.</h2><p class=\"body-lg\" style=\"color:#E7E4DC;max-width:46ch\">Eight pathways, each qualified until the service behind it is approved.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Qualified developmental services</span></li><li><span class=\"num\">02</span><span>Inclusive sport</span></li><li><span class=\"num\">03</span><span>Sensory-friendly environments</span></li><li><span class=\"num\">04</span><span>Education and academic success</span></li><li><span class=\"num\">05</span><span>Life skills</span></li><li><span class=\"num\">06</span><span>Esports and technology</span></li><li><span class=\"num\">07</span><span>Employment and entrepreneurship</span></li><li><span class=\"num\">08</span><span>Family resources</span></li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"8e8a1f27","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"nd.edu-cta","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"dafb23a9","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"nd.edu-cta\" data-el-build=\"elementor\">\n  <a class=\"educta reveal\" href=\"{{url:/education-partnerships/}}\">\n    <span class=\"educta__k\">For schools, colleges &amp; learning organisations</span>\n    <span class=\"educta__t\">Partner with us in education.</span>\n    <span class=\"educta__go\">Become an education partner <span aria-hidden=\"true\">→</span></span>\n  </a>\n</section>"},"elements":[]}]},{"id":"2a6c77be","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.interest-form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"662b0471","elType":"widget","widgetType":"html","settings":{"html":"<section data-form-id=\"neurodiversity-interest\" class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Get support or keep up to date.</h2>\n      <p class=\"body-lg\">An initial inquiry only. A named contact will respond by your preferred method.</p>\n      <p class=\"small muted\">We do not ask for a diagnosis or medical records. Accommodation information is optional and free-text, and anything sensitive moves to an approved secure process later.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f110\">Participant or caregiver name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f110\" name=\"participant-or-caregiver-name\" aria-describedby=\"f110-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f110-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f111\">Age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f111\" name=\"age-range\" aria-describedby=\"f111-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option><option value=\"Prefer not to say\">Prefer not to say</option></select>\n  \n  <span class=\"field__error\" id=\"f111-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f112\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f112\" name=\"email\" aria-describedby=\"f112-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f112-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f113\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f113\" name=\"phone\" aria-describedby=\"f113-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f113-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f114\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f114\" name=\"region\" aria-describedby=\"f114-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f114-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f115\">Programs of interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f115\" name=\"programs-of-interest\" aria-describedby=\"f115-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Qualified developmental services\">Qualified developmental services</option><option value=\"Inclusive sport\">Inclusive sport</option><option value=\"Sensory-friendly environments\">Sensory-friendly environments</option><option value=\"Education and academic success\">Education and academic success</option><option value=\"Life skills\">Life skills</option><option value=\"Esports and technology\">Esports and technology</option><option value=\"Employment and entrepreneurship\">Employment and entrepreneurship</option><option value=\"Family resources\">Family resources</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f115-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f116\">Preferred contact<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f116\" name=\"preferred-contact\" aria-describedby=\"f116-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Email\">Email</option><option value=\"Phone\">Phone</option></select>\n  \n  <span class=\"field__error\" id=\"f116-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f117\">Accommodation information <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f117\" name=\"accommodation-information\" aria-describedby=\"f117-err\" rows=\"4\" placeholder=\"Optional — anything that would help us communicate well with you\"></textarea>\n  \n  <span class=\"field__error\" id=\"f117-err\" aria-live=\"polite\"></span>\n</div></div>\n  <p class=\"small muted form__privacy\">Please do not include diagnoses, medical records or financial documents in this form. If follow-up needs that information, our team will arrange a secure channel.</p>\n  <label class=\"check\" for=\"f109\"><input type=\"checkbox\" id=\"f109\" name=\"consent\" required aria-describedby=\"f109-err\"><span>I agree to AFSV VRC contacting me about this inquiry.<span class=\"field__error\" id=\"f109-err\"></span></span></label>\n\n  <label class=\"check\" for=\"f109m\"><input type=\"checkbox\" id=\"f109m\" name=\"marketing\" value=\"yes\"><span>Optional: send me occasional updates from AFSV VRC by email. I can unsubscribe at any time.</span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Your details have been received. We will be in touch with updates as plans are approved.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]},{"id":"7c871b14","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"1fb6bd1b","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Cost should not decide who takes part.</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/neurodiversity-access-fund/}}\">Neurodiversity Access Fund<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}