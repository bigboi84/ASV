     "id": "1c0143d8",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section\" data-el=\"page.list-primary\" data-el-build=\"elementor\">\n  <div class=\"section-head reveal\" style=\"align-items:start\"><h2 class=\"h2\">Who it supports.</h2><p class=\"body-lg muted\">Written as the community describes itself. Identity-first and person-first preferences are both respected.</p></div>\n  <div class=\"hairline list-cells\" style=\"--min:255px\" data-stagger ><div class=\"cell\"><span class=\"num\">01</span><span>Autism</span></div><div class=\"cell\"><span class=\"num\">02</span><span>ADHD</span></div><div class=\"cell\"><span class=\"num\">03</span><span>Dyslexia and learning differences</span></div><div class=\"cell\"><span class=\"num\">04</span><span>Communication differences</span></div><div class=\"cell\"><span class=\"num\">05</span><span>Intellectual and developmental disabilities</span></div><div class=\"cell\"><span class=\"num\">06</span><span>Executive-function challenges</span></div><div class=\"cell\"><span class=\"num\">07</span><span>Sensory-processing differences</span></div><div class=\"cell\"><span class=\"num\">08</span><span>Other neurodevelopmental needs</span></div></div>\n</section>"
     },
     "elements": []
    }
   ]
  },
