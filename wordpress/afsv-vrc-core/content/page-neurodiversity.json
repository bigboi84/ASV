    {
     "id": "7108124e",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"interest\" data-el=\"page.interest-form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Get support or register interest.</h2>\n      <p class=\"body-lg\">An initial inquiry only. A named contact will respond by your preferred method.</p>\n      <p class=\"small muted\">We do not ask for a diagnosis or medical records. Accommodation information is optional and free-text, and anything sensitive moves to an approved secure process later.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:neurodiversity}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f122\">Participant or caregiver name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f122\" name=\"participant-or-caregiver-name\" aria-describedby=\"f122-err\" required aria-required=\"true\" placeholder=\"Full name\">\n  \n  <span class=\"field__error\" id=\"f122-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f123\">Age range<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f123\" name=\"age-range\" aria-describedby=\"f123-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Under 8\">Under 8</option><option value=\"8–11\">8–11</option><option value=\"12–14\">12–14</option><option value=\"15–17\">15–17</option><option value=\"18–24\">18–24</option><option value=\"25+\">25+</option><option value=\"Prefer not to say\">Prefer not to say</option></select>\n  \n  <span class=\"field__error\" id=\"f123-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f124\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f124\" name=\"email\" aria-describedby=\"f124-err\" required aria-required=\"true\" placeholder=\"you@example.com\">\n  \n  <span class=\"field__error\" id=\"f124-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f125\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f125\" name=\"phone\" aria-describedby=\"f125-err\" placeholder=\"Optional\">\n  \n  <span class=\"field__error\" id=\"f125-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f126\">Region<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f126\" name=\"region\" aria-describedby=\"f126-err\" required aria-required=\"true\" placeholder=\"City or region\">\n  \n  <span class=\"field__error\" id=\"f126-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f127\">Programs of interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f127\" name=\"programs-of-interest\" aria-describedby=\"f127-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Qualified developmental services\">Qualified developmental services</option><option value=\"Inclusive sport\">Inclusive sport</option><option value=\"Sensory-friendly environments\">Sensory-friendly environments</option><option value=\"Education and academic success\">Education and academic success</option><option value=\"Life skills\">Life skills</option><option value=\"Esports and technology\">Esports and technology</option><option value=\"Employment and entrepreneurship\">Employment and entrepreneurship</option><option value=\"Family resources\">Family resources</option><option value=\"Not sure yet\">Not sure yet</option></select>\n  \n  <span class=\"field__error\" id=\"f127-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f128\">Preferred contact<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f128\" name=\"preferred-contact\" aria-describedby=\"f128-err\" required aria-required=\"true\"><option value=\"\">Please select</option><option value=\"Email\">Email</option><option value=\"Phone\">Phone</option></select>\n  \n  <span class=\"field__error\" id=\"f128-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f129\">Accommodation information <span class=\"opt\">(optional)</span></label>\n  <textarea id=\"f129\" name=\"accommodation-information\" aria-describedby=\"f129-err\" rows=\"4\" placeholder=\"Optional — anything that would help us communicate well with you\"></textarea>\n  \n  <span class=\"field__error\" id=\"f129-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f121\"><input type=\"checkbox\" id=\"f121\" name=\"consent\" required aria-describedby=\"f121-err\"><span>I agree to be contacted about this inquiry and to receive occasional updates from AFSV VRC. You can unsubscribe at any time.<span class=\"field__error\" id=\"f121-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. On the live site it routes to a named owner and sends an automatic confirmation.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
