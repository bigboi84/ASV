    {
     "id": "1be27064",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--cream\" data-el=\"page.blocks\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <h2 class=\"h2 mb-l reveal\" style=\"max-width:26ch\">Four routes in, four owners.</h2>\n    <div class=\"hairline\" style=\"--min:260px\" data-stagger>\n      <div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">01</span><h3 class=\"h3\">Individuals</h3><p style=\"font-size:15.5px\">Register interest in programs and support, and hear back from a named contact rather than a general inbox.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">02</span><h3 class=\"h3\">Families and carers</h3><p style=\"font-size:15.5px\">Plain-language information, a vetted provider directory, and help working out what is available.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">03</span><h3 class=\"h3\">Professionals and providers</h3><p style=\"font-size:15.5px\">Apply to join the Service Provider Network, subject to qualification, insurance and safeguarding review.</p></div><div class=\"cell\" style=\"min-height:240px;padding:34px 28px 38px\"><span class=\"num\">04</span><h3 class=\"h3\">Businesses and employers</h3><p style=\"font-size:15.5px\">Join Business for Inclusion as a funding, service, employment, commercial or accessibility partner.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
  },
