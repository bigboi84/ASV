     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"band--navy\" data-el=\"partners.routes\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Audience routes.</h2><p class=\"body-lg\">Each route reaches a different team. Investor inquiries are handled by restricted recipients.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Corporate sponsor</span></li><li><span class=\"num\">02</span><span>Education and community</span></li><li><span class=\"num\">03</span><span>Technology</span></li><li><span class=\"num\">04</span><span>Service and in-kind</span></li><li><span class=\"num\">05</span><span>Development and infrastructure</span></li><li><span class=\"num\">06</span><span>Investor inquiry</span></li></ul>\n  </div>\n</section>"
