    {
     "id": "4ff00a6b",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap section \" id=\"partner-form\" data-el=\"partners.form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Request materials.</h2>\n      <p class=\"body-lg\">Tell us how your organisation would work with AFSV VRC and we will route your inquiry to the right team.</p>\n      <p class=\"small muted\">Investor inquiries are directed to restricted internal recipients. No offering documents are distributed from this form.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form data-endpoint=\"{{form:partners}}\">\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f58\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f58\" name=\"name\" autocomplete=\"name\" aria-describedby=\"f58-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f58-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f59\">Organisation<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f59\" name=\"organisation\" autocomplete=\"organization\" aria-describedby=\"f59-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f59-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f60\">Title<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f60\" name=\"title\" autocomplete=\"organization-title\" aria-describedby=\"f60-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f60-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f61\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f61\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f61-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f61-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f62\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f62\" name=\"phone\" autocomplete=\"tel\" aria-describedby=\"f62-err\">\n  \n  <span class=\"field__error\" id=\"f62-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f63\">Country<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f63\" name=\"country\" autocomplete=\"country-name\" aria-describedby=\"f63-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f63-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"partner-type\">Inquiry type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"partner-type\" name=\"inquiry-type\" aria-describedby=\"partner-type-err\" required aria-required=\"true\"><option value=\"\">Select a type</option><option value=\"Corporate sponsor\">Corporate sponsor</option><option value=\"Education and community\">Education and community</option><option value=\"Technology\">Technology</option><option value=\"Service and in-kind\">Service and in-kind</option><option value=\"Development and infrastructure\">Development and infrastructure</option><option value=\"Investor inquiry\">Investor inquiry</option></select>\n  \n  <span class=\"field__error\" id=\"partner-type-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f64\">Sector <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f64\" name=\"sector\" aria-describedby=\"f64-err\">\n  \n  <span class=\"field__error\" id=\"f64-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f65\">Budget range <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f65\" name=\"budget-range\" aria-describedby=\"f65-err\">\n  \n  <span class=\"field__error\" id=\"f65-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f66\">Contribution or interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f66\" name=\"contribution-or-interest\" aria-describedby=\"f66-err\" required aria-required=\"true\" rows=\"2\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f66-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f67\">Message<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f67\" name=\"message\" aria-describedby=\"f67-err\" required aria-required=\"true\" rows=\"4\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f67-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f57\"><input type=\"checkbox\" id=\"f57\" name=\"consent\" required aria-describedby=\"f57-err\"><span>I agree to AFSV VRC contacting me about this inquiry.<span class=\"field__error\" id=\"f57-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Inquiries will route by type once owners and mailbox routing are confirmed; investor inquiries route to restricted recipients.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
