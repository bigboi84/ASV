{"slug":"partners","parent":"","title":"Partners, Sponsors & Investors","description":"Build the future with AFSV VRC — partnership routes for municipalities, education, sport, inclusion, technology, corporate sponsorship, community development and capital.","chrome":"default","front":false,"elements":[{"id":"0af922c9","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"20307cd8","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Partners, Sponsors &amp; Investors</li></ol></nav>"},"elements":[]}]},{"id":"d99511ba","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"5e6d6219","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap page-head\" data-el=\"partners.hero\" data-el-build=\"elementor\">\n  <p class=\"eyebrow\">Partners, sponsors &amp; investors</p>\n  <h1 class=\"h1 split-words\" style=\"max-width:20ch\" aria-label=\"Build the future with AFSV VRC.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Build</span></span> <span class=\"w\"><span style=\"--i:1\">the</span></span> <span class=\"w\"><span style=\"--i:2\">future</span></span> <span class=\"w\"><span style=\"--i:3\">with</span></span> <span class=\"w\"><span style=\"--i:4\">AFSV</span></span> <span class=\"w\"><span style=\"--i:5\">VRC.</span></span></span></h1>\n  <p class=\"lead mb-l\" style=\"max-width:66ch\">AFSV VRC’s model depends on aligned partners across municipalities, education, sport, inclusion, technology, corporate sponsorship, community development and capital.</p>\n  <div class=\"btn-row btn-row--stack mb-l\">\n    <a class=\"btn btn--navy\" href=\"#partner-form\">Become a Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    <a class=\"btn btn--line-dark\" href=\"#partner-form\" data-preselect=\"partner-type=Corporate sponsor\">Request Sponsorship Information<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    <a class=\"btn btn--line-dark\" href=\"#partner-form\" data-preselect=\"partner-type=Development and infrastructure\">Request Project Brief<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    <a class=\"btn btn--line-dark\" href=\"#partner-form\" data-preselect=\"partner-type=Investor inquiry\">Investor Inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n  </div>\n  <figure class=\"figure figure--21x9 figure--motion wipe\" data-video-scope><div class=\"pmedia\" data-parallax=\"0.08\"><img src=\"{{asset:img/life/suite.jpg}}\" alt=\"Concept rendering: racially diverse partners shaking hands in a glass suite overlooking a packed pitch on match night.\" width=\"1344\" height=\"752\" loading=\"lazy\"></div></figure>\n</section>"},"elements":[]}]},{"id":"7393d506","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.sections","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"323a9049","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"partners.sections\" data-el-build=\"elementor\">\n  <div class=\"hairline\" style=\"--min:300px\" data-stagger>\n    <div class=\"cell\"><span class=\"num\">01</span><h2 class=\"h3\">Why partner</h2><p>AFSV VRC’s model depends on aligned partners across municipalities, education, sport, inclusion, technology, corporate sponsorship, community development and capital.</p></div><div class=\"cell\"><span class=\"num\">02</span><h2 class=\"h3\">Partnership categories</h2><p>Six audience routes cover sponsorship, education and community, technology, service and in-kind contribution, development and infrastructure, and investor inquiry.</p></div><div class=\"cell\"><span class=\"num\">03</span><h2 class=\"h3\">Outcome sponsorship</h2><p>Sponsorship structured around measurable participation, learning and inclusion outcomes. Values and packages are administrator-configurable and not published until approved.</p></div><div class=\"cell\"><span class=\"num\">04</span><h2 class=\"h3\">Development partnerships</h2><p>Site, design, construction, technology and operating partnerships connected to the proposed Whitby pilot.</p></div>\n  </div>\n</section>"},"elements":[]}]},{"id":"e4bb6bed","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.routes","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"6b8da64f","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"partners.routes\" data-el-build=\"elementor\">\n  <div class=\"wrap section split\">\n    <div class=\"reveal\"><h2 class=\"h2 mb-m\">Audience routes.</h2><p class=\"body-lg\">Each route reaches a different team. Investor inquiries are handled by restricted recipients.</p></div>\n    <ul class=\"rows\" data-stagger><li><span class=\"num\">01</span><span>Corporate sponsor</span></li><li><span class=\"num\">02</span><span>Education and community</span></li><li><span class=\"num\">03</span><span>Technology</span></li><li><span class=\"num\">04</span><span>Service and in-kind</span></li><li><span class=\"num\">05</span><span>Development and infrastructure</span></li><li><span class=\"num\">06</span><span>Investor inquiry</span></li></ul>\n  </div>\n</section>"},"elements":[]}]},{"id":"220985b7","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.logos","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"9a808304","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"partners.logos\" data-el-build=\"elementor\">\n  \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">Our partners</p>\n    <h2 class=\"h2\">Building it together.</h2>\n    \n  </div>\n  <ul class=\"plogos\" data-stagger>\n    <li class=\"plogo\"><img src=\"{{asset:img/partners/charrans-bookstores.jpg}}\" alt=\"Charran’s Bookstores — Building the Nation, Book by Book.\" width=\"900\" height=\"284\" loading=\"lazy\"></li>\n    <li class=\"plogo plogo--dark\"><img src=\"{{asset:img/partners/gaisb-ai-world-summit-2027.svg}}\" alt=\"GAISB AI World Summit 2027\" loading=\"lazy\"></li>\n  </ul>\n</section>"},"elements":[]}]},{"id":"cdee8467","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.pathways","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"346e68de","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"partners.pathways\" data-el-build=\"elementor\">\n  \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">Who we partner with</p>\n    <h2 class=\"h2\">Partnership pathways.</h2>\n    \n  </div>\n  \n  <div class=\"kgrid kgrid--3\" data-stagger>\n    <article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 20.4h16\"/><rect x=\"6\" y=\"4\" width=\"12\" height=\"16.4\" rx=\".8\"/><path d=\"M9 7.6h2M13 7.6h2M9 11h2M13 11h2M9 14.4h2M13 14.4h2M10.6 20.4v-3h2.8v3\"/></svg></span>\n      <h3>Municipal &amp; Government</h3>\n      <p>Public-private partnership opportunities with municipalities, school boards and government agencies across Canada.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 6.6C9.8 5 6.6 4.6 3.4 5v13.4c3.2-.4 6.4 0 8.6 1.6 2.2-1.6 5.4-2 8.6-1.6V5c-3.2-.4-6.4 0-8.6 1.6z\"/><path d=\"M12 6.6v13.4\"/><path d=\"M15.8 10.4c.6-1 2.4-.8 2.4.6 0 1.2-2.4 2.6-2.4 2.6s-2.4-1.4-2.4-2.6c0-1.4 1.8-1.6 2.4-.6z\"/></svg></span>\n      <h3>Academic &amp; Institutional</h3>\n      <p>Colleges, universities and research institutions interested in sports science, education and community development.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.6 12.4l3.6-4.2 3.6 1.4 2.4-1.4 3.2.4 3.8 3.6\"/><path d=\"M2.6 12.4l3.4 3.2M21.4 12.2l-3.2 3.4\"/><path d=\"M8.6 14.6l1.6 1.6a1.2 1.2 0 0 0 1.7 0l.2-.2M11 13.4l2.4 2.4a1.2 1.2 0 0 0 1.7 0l.6-.6-3.6-3.8\"/></svg></span>\n      <h3>Corporate Sponsors</h3>\n      <p>Financial services, sports brands, technology, healthcare and food &amp; beverage brands aligned with youth development.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M12 8.2l3.2 2.3-1.2 3.8h-4l-1.2-3.8z\"/><path d=\"M12 3.4v4.8M15.2 10.5l4.3-1.6M14 14.3l2.7 3.8M10 14.3l-2.7 3.8M8.8 10.5L4.5 8.9\"/></svg></span>\n      <h3>Sports Clubs &amp; Academies</h3>\n      <p>Existing clubs, academies and sports organizations across Canada — through the Affiliate Academy Network.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"7\" y=\"2.8\" width=\"10\" height=\"18.4\" rx=\"2.2\"/><path d=\"M10.6 18h2.8\"/></svg></span>\n      <h3>Technology Partners</h3>\n      <p>Digital platform, athlete management, esports and sports technology companies interested in co-development.</p>\n      \n    </article><article class=\"kcard\">\n      <span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M3.4 12h17.2\"/><path d=\"M12 3.4c2.4 2.4 3.6 5.2 3.6 8.6s-1.2 6.2-3.6 8.6c-2.4-2.4-3.6-5.2-3.6-8.6s1.2-6.2 3.6-8.6z\"/></svg></span>\n      <h3>Community Organizations</h3>\n      <p>Diaspora groups, cultural organizations and non-profits aligned with youth development and inclusion.</p>\n      \n    </article>\n  </div>\n</section>"},"elements":[]}]},{"id":"b3b3fe0f","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.sponsorship","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"7902853c","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"partners.sponsorship\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">Corporate expressions of interest</p>\n    <h2 class=\"h2\">Support youth development. Explore brand alignment.</h2>\n    <p class=\"body-lg muted\">Sponsorship packages are in development — early interest helps demonstrate ecosystem viability and community confidence.</p>\n  </div>\n    <div class=\"spons\" data-stagger>\n      <article class=\"spon\"><span class=\"spon__n\">01</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.6 18.6h18.8\"/><path d=\"M4 18.6C4 12 7.6 7.4 12 7.4S20 12 20 18.6\"/><path d=\"M8.2 18.6c0-4.8 1.7-8.6 3.8-11.2M15.8 18.6c0-4.8-1.7-8.6-3.8-11.2\"/><path d=\"M4.8 14.2h14.4\"/><path d=\"M10.4 18.6v-2.8h3.2v2.8\"/></svg></span><h3>Facility naming rights</h3><p>Premium branding on proposed sports infrastructure — subject to development.</p></article><article class=\"spon\"><span class=\"spon__n\">02</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8.6 3.6L4 6l1.6 4.2 2-.8V20.4h8.8V9.4l2 .8L20 6l-4.6-2.4a3.4 3.4 0 0 1-6.8 0z\"/></svg></span><h3>Athlete kit branding</h3><p>Your brand on athlete training apparel and gear as programs launch.</p></article><article class=\"spon\"><span class=\"spon__n\">03</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 6.6C9.8 5 6.6 4.6 3.4 5v13.4c3.2-.4 6.4 0 8.6 1.6 2.2-1.6 5.4-2 8.6-1.6V5c-3.2-.4-6.4 0-8.6 1.6z\"/><path d=\"M12 6.6v13.4\"/><path d=\"M15.8 10.4c.6-1 2.4-.8 2.4.6 0 1.2-2.4 2.6-2.4 2.6s-2.4-1.4-2.4-2.6c0-1.4 1.8-1.6 2.4-.6z\"/></svg></span><h3>Education program support</h3><p>Align ESG goals with proposed neurodivergent education and mentorship programs.</p></article><article class=\"spon\"><span class=\"spon__n\">04</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6.6 7.6h10.8a3.6 3.6 0 0 1 3.5 2.8l1 4.6a2.4 2.4 0 0 1-4 2.2l-2.1-2.2H8.2L6.1 17.2a2.4 2.4 0 0 1-4-2.2l1-4.6a3.6 3.6 0 0 1 3.5-2.8z\"/><path d=\"M7.4 10.2v3M5.9 11.7h3\"/><circle cx=\"15.6\" cy=\"11\" r=\".9\"/><circle cx=\"17.6\" cy=\"12.8\" r=\".9\"/></svg></span><h3>Esports &amp; digital visibility</h3><p>Digital exposure across planned esports tournaments, streaming and fan engagement.</p></article><article class=\"spon\"><span class=\"spon__n\">05</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M3.4 12h17.2\"/><path d=\"M12 3.4c2.4 2.4 3.6 5.2 3.6 8.6s-1.2 6.2-3.6 8.6c-2.4-2.4-3.6-5.2-3.6-8.6s1.2-6.2 3.6-8.6z\"/></svg></span><h3>Diaspora network alignment</h3><p>Connect with a growing global diaspora community through shared values.</p></article><article class=\"spon\"><span class=\"spon__n\">06</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3.4l2.6 5.4 5.8.8-4.2 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z\"/></svg></span><h3>Title association</h3><p>Explore alignment with a national sports development initiative at the ground level.</p></article>\n    </div>\n    <p class=\"aff__fine aff__fine--dark\">Expressions of interest do not constitute a binding commitment. Formal sponsorship agreements will be finalized through proper legal channels. No funds are being solicited at this stage.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"0cafca2d","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.affiliate","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"9ad23f43","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--navy\" data-el=\"page.affiliate\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow mb-s\">Affiliate Academy Network</p>\n      <h2 class=\"h2\">Partnering with existing clubs &amp; academies.</h2>\n      <p class=\"body-lg\">AFSVHCL™ is not a competitor to existing clubs — it is the infrastructure and services layer that makes every club, academy and institution better.</p>\n    </div>\n    <div class=\"aff\" data-stagger>\n      <article class=\"aff__card\"><h3>Community Affiliate</h3><p>Dome access and basic programming.</p><a class=\"aff__go\" href=\"{{url:/become-a-member/?interest=partnership}}\">Keep up to date &rarr;</a></article><article class=\"aff__card aff__card--hot\"><h3>Performance Affiliate</h3><p>Full sports science, media and neurodivergent support.</p><a class=\"aff__go\" href=\"{{url:/become-a-member/?interest=partnership}}\">Keep up to date &rarr;</a></article><article class=\"aff__card\"><h3>Elite Academy Partner</h3><p>Co-branded programs, recruitment and sponsorship.</p><a class=\"aff__go\" href=\"{{url:/become-a-member/?interest=partnership}}\">Keep up to date &rarr;</a></article>\n    </div>\n    <p class=\"aff__fine\">Affiliate details will be shared with clubs and academies as the network opens. Expressions of interest do not constitute binding commitments.</p>\n  </div>\n</section>"},"elements":[]}]},{"id":"bb6ced0d","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.directory","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"ae3544fa","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" data-el=\"partners.directory\" data-el-build=\"elementor\">\n  <h2 class=\"h2 mb-s reveal\">Approved partners</h2>\n  <p class=\"body-lg mb-l\" style=\"max-width:70ch\">No organisation is listed as a partner without written authorization. Further logos will appear here as permissions are confirmed.</p>\n  <ul class=\"logo-wall\" data-stagger>\n    <li class=\"logo-wall__item logo-wall__item--dark\"><a href=\"{{url:/gaisb-ai/}}\"><img src=\"{{asset:img/partners/gaisb-ai-world-summit-2027.svg}}\" alt=\"GAISB AI World Summit 2027\" width=\"576\" height=\"120\" loading=\"lazy\"></a></li>\n    <li class=\"logo-wall__item logo-wall__item--pending\"><span>More partners to be announced</span></li>\n  </ul>\n</section>"},"elements":[]}]},{"id":"fb6a6996","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.disclaimer","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"2f78aabd","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap\" data-el=\"partners.disclaimer\" data-el-build=\"elementor\">\n  <div class=\"callout\" role=\"note\"><span class=\"eyebrow\">Investor information</span><p style=\"font-size:15.5px;line-height:1.66\">All investment information is high level and informational. AFSV VRC does not publish returns, offering terms, securities availability, valuations or solicitations. Nothing on this page constitutes an offer to sell or a solicitation to buy securities in any jurisdiction.</p></div>\n</section>"},"elements":[]}]},{"id":"3f81c29e","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"partners.form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"a8e9d478","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section \" id=\"partner-form\" data-el=\"partners.form\" data-el-build=\"plugin\">\n  <div class=\"split split--form\">\n    <div class=\"form-intro reveal\">\n      <h2 class=\"h2\">Become a partner.</h2>\n      <p class=\"body-lg\">Tell us how your organisation would work with AFSV VRC and we will route your inquiry to the right team.</p>\n      <p class=\"small muted\">Investor inquiries are directed to restricted internal recipients. No offering documents are distributed from this form.</p>\n    </div>\n    \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f50\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f50\" name=\"name\" autocomplete=\"name\" aria-describedby=\"f50-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f50-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f51\">Organisation<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f51\" name=\"organisation\" autocomplete=\"organization\" aria-describedby=\"f51-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f51-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f52\">Title<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f52\" name=\"title\" autocomplete=\"organization-title\" aria-describedby=\"f52-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f52-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f53\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f53\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f53-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f53-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f54\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f54\" name=\"phone\" autocomplete=\"tel\" aria-describedby=\"f54-err\">\n  \n  <span class=\"field__error\" id=\"f54-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f55\">Country<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f55\" name=\"country\" autocomplete=\"country-name\" aria-describedby=\"f55-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f55-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"partner-type\">Inquiry type<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"partner-type\" name=\"inquiry-type\" aria-describedby=\"partner-type-err\" required aria-required=\"true\"><option value=\"\">Select a type</option><option value=\"Corporate sponsor\">Corporate sponsor</option><option value=\"Education and community\">Education and community</option><option value=\"Technology\">Technology</option><option value=\"Service and in-kind\">Service and in-kind</option><option value=\"Development and infrastructure\">Development and infrastructure</option><option value=\"Investor inquiry\">Investor inquiry</option></select>\n  \n  <span class=\"field__error\" id=\"partner-type-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f56\">Sector <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f56\" name=\"sector\" aria-describedby=\"f56-err\">\n  \n  <span class=\"field__error\" id=\"f56-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f57\">Budget range <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f57\" name=\"budget-range\" aria-describedby=\"f57-err\">\n  \n  <span class=\"field__error\" id=\"f57-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f58\">Contribution or interest<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f58\" name=\"contribution-or-interest\" aria-describedby=\"f58-err\" required aria-required=\"true\" rows=\"2\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f58-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f59\">Message<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f59\" name=\"message\" aria-describedby=\"f59-err\" required aria-required=\"true\" rows=\"4\" placeholder=\"\"></textarea>\n  \n  <span class=\"field__error\" id=\"f59-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f49\"><input type=\"checkbox\" id=\"f49\" name=\"consent\" required aria-describedby=\"f49-err\"><span>I agree to AFSV VRC contacting me about this inquiry.<span class=\"field__error\" id=\"f49-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you.</strong>Development preview — this form is not connected yet. Inquiries will route by type once owners and mailbox routing are confirmed; investor inquiries route to restricted recipients.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Submit inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n  </div>\n</section>"},"elements":[]}]}]}