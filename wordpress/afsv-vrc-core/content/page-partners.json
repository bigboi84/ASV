     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap page-head\" data-el=\"partners.hero\" data-el-build=\"elementor\">\n  <p class=\"eyebrow\">Partners, sponsors &amp; investors</p>\n  <h1 class=\"h1 split-words\" style=\"max-width:20ch\" aria-label=\"Build the future with AFSV VRC.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Build</span></span> <span class=\"w\"><span style=\"--i:1\">the</span></span> <span class=\"w\"><span style=\"--i:2\">future</span></span> <span class=\"w\"><span style=\"--i:3\">with</span></span> <span class=\"w\"><span style=\"--i:4\">AFSV</span></span> <span class=\"w\"><span style=\"--i:5\">VRC.</span></span></span></h1>\n  <p class=\"lead mb-l\" style=\"max-width:66ch\">AFSV VRC’s model depends on aligned partners across municipalities, education, sport, inclusion, technology, corporate sponsorship, community development and capital.</p>\n  <div class=\"btn-row btn-row--stack mb-l\">\n    <a class=\"btn btn--navy\" href=\"#partner-form\">Become a Partner<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    <a class=\"btn btn--line-dark\" href=\"#partner-form\" data-preselect=\"partner-type=Corporate sponsor\">Request Sponsorship Information<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    <a class=\"btn btn--line-dark\" href=\"#partner-form\" data-preselect=\"partner-type=Development and infrastructure\">Request Project Brief<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n    <a class=\"btn btn--line-dark\" href=\"#partner-form\" data-preselect=\"partner-type=Investor inquiry\">Investor Inquiry<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a>\n  </div>\n  <figure class=\"figure figure--21x9 figure--motion wipe\" data-video-scope><div class=\"pmedia\" data-video=\"https://d8j0ntlcm91z4.cloudfront.net/user_3JOGRzagxf8GC6k15VlPoOU7fkd/hf_20261001_223920_e63eea28-de26-4295-92d5-0db4e7620a6c.mp4\" data-parallax=\"0.08\"><img src=\"{{asset:img/partners-boardroom.jpg}}\" alt=\"Five adults in business attire in discussion around a dark boardroom table with printed plans and a site model, a large window behind them.\" width=\"1344\" height=\"752\" loading=\"lazy\"></div></figure>\n</section>"
     },
