     "id": "7ba3fc34",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"wrap\" data-el=\"partners.disclaimer\" data-el-build=\"elementor\">\n  <div class=\"callout\" role=\"note\"><span class=\"eyebrow\">Investor information</span><p style=\"font-size:15.5px;line-height:1.66\">All investment information is high level and informational. AFSV VRC does not publish returns, offering terms, securities availability, valuations or solicitations. Nothing on this page constitutes an offer to sell or a solicitation to buy securities in any jurisdiction.</p></div>\n</section>"
     },
