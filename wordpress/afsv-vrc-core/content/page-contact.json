{"slug":"contact","parent":"","title":"Contact Us","description":"Contact AFSVHCL™ — partners, sponsors, community stakeholders, athletes, families, media and supporters.","chrome":"default","front":false,"elements":[{"id":"14c6010a","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 1","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"8f418778","elType":"widget","widgetType":"html","settings":{"html":"<nav class=\"breadcrumb wrap\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{url:/}}\">Home</a></li><li aria-hidden=\"true\">/</li><li aria-current=\"page\">Contact Us</li></ol></nav>"},"elements":[]}]},{"id":"0c074adc","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"page.hero","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"bd856274","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"xhero\" data-el=\"page.hero\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"xhero__frame\">\n      <img src=\"{{asset:img/life/welcome.jpg}}\" alt=\"Concept rendering: a racially diverse welcome team greeting families, a teen athlete and a child in a wheelchair at the curved front desk of the village concourse at dusk.\" width=\"1600\" height=\"900\" fetchpriority=\"high\">\n      <span class=\"xhero__shade\" aria-hidden=\"true\"></span>\n      <div class=\"xhero__copy\">\n        <p class=\"xhero__kick\">Contact us</p>\n        <h1 class=\"xhero__title split-words\" aria-label=\"Let’s build what comes next.\"><span aria-hidden=\"true\"><span class=\"w\"><span style=\"--i:0\">Let’s</span></span> <span class=\"w\"><span style=\"--i:1\">build</span></span> <span class=\"w\"><span style=\"--i:2\">what</span></span> <span class=\"w\"><span style=\"--i:3\">comes</span></span> <span class=\"w\"><span style=\"--i:4\">next.</span></span></span></h1>\n      </div>\n      <span class=\"xhero__badge\">No memberships, programs or services are currently available for purchase</span>\n    </div>\n    <div class=\"xhero__under\">\n      <p class=\"lead\">We welcome exploratory conversations with potential partners, sponsors, community stakeholders and supporters of the AFSVHCL™ vision.</p>\n      <div class=\"btn-row\"><a class=\"btn btn--navy\" href=\"#contact-form\">Send a message<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-dark\" href=\"mailto:info@afsvhcl.com\">Email us<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"671b3b4a","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"contact.form","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"142c2e43","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section\" id=\"contact-form\" data-el=\"contact.form\" data-el-build=\"plugin\">\n  <div class=\"cgrid\">\n    <div class=\"cgrid__form\">\n      <p class=\"eyebrow mb-s\">Send us a message</p>\n      <h2 class=\"h2 mb-s\">We reply within 2–3 business days.</h2>\n      <p class=\"muted mb-m\">All inquiries are exploratory and non-binding.</p>\n      \n<form class=\"form\" data-preview-form>\n  <p class=\"small muted\">Fields marked <span aria-hidden=\"true\" style=\"color:var(--danger)\">*</span><span class=\"sr-only\">with an asterisk</span> are required.</p>\n  <div class=\"form__grid\">\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f41\">Name<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f41\" name=\"name\" autocomplete=\"name\" aria-describedby=\"f41-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f41-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f42\">Organisation <span class=\"opt\">(optional)</span></label>\n  <input type=\"text\" id=\"f42\" name=\"organisation\" autocomplete=\"organization\" aria-describedby=\"f42-err\">\n  \n  <span class=\"field__error\" id=\"f42-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f43\">Email<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"email\" id=\"f43\" name=\"email\" autocomplete=\"email\" aria-describedby=\"f43-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f43-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f44\">Phone <span class=\"opt\">(optional)</span></label>\n  <input type=\"tel\" id=\"f44\" name=\"phone\" autocomplete=\"tel\" aria-describedby=\"f44-err\">\n  \n  <span class=\"field__error\" id=\"f44-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f45\">City and country<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <input type=\"text\" id=\"f45\" name=\"city-and-country\" aria-describedby=\"f45-err\" required aria-required=\"true\">\n  \n  <span class=\"field__error\" id=\"f45-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field\">\n  <label class=\"field__label\" for=\"f46\">Preferred response method<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f46\" name=\"preferred-response-method\" aria-describedby=\"f46-err\" required aria-required=\"true\"><option value=\"\">Select a method</option><option value=\"Email\">Email</option><option value=\"Phone call\">Phone call</option></select>\n  \n  <span class=\"field__error\" id=\"f46-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f47\">Inquiry category<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <select id=\"f47\" name=\"inquiry-category\" aria-describedby=\"f47-err\" required aria-required=\"true\"><option value=\"\">Select a category</option><option value=\"General\">General</option><option value=\"Membership\">Membership</option><option value=\"Programs\">Programs</option><option value=\"Whitby Smart Sports Village\">Whitby Smart Sports Village</option><option value=\"Education and inclusion\">Education and inclusion</option><option value=\"Sponsorship and investment\">Sponsorship and investment</option><option value=\"Marketplace / vendors\">Marketplace / vendors</option><option value=\"Media / speaking\">Media / speaking</option><option value=\"Technical support\">Technical support</option></select>\n  \n  <span class=\"field__error\" id=\"f47-err\" aria-live=\"polite\"></span>\n</div>\n<div class=\"field field--full\">\n  <label class=\"field__label\" for=\"f48\">Message<span class=\"req\" aria-hidden=\"true\">*</span></label>\n  <textarea id=\"f48\" name=\"message\" aria-describedby=\"f48-hint f48-err\" required aria-required=\"true\" rows=\"5\" placeholder=\"\"></textarea>\n  <span class=\"field__hint\" id=\"f48-hint\">Please do not include health records or diagnoses.</span>\n  <span class=\"field__error\" id=\"f48-err\" aria-live=\"polite\"></span>\n</div></div>\n  <label class=\"check\" for=\"f40\"><input type=\"checkbox\" id=\"f40\" name=\"consent\" required aria-describedby=\"f40-err\"><span>I agree to AFSVHCL contacting me about this inquiry.<span class=\"field__error\" id=\"f40-err\"></span></span></label>\n  <div class=\"form-status\" role=\"status\" tabindex=\"-1\" hidden><strong>Thank you for reaching out.</strong>Your inquiry has been received and will be directed to the appropriate team member.</div>\n  <div><button type=\"submit\" class=\"btn btn--navy\">Send message<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></button></div>\n</form>\n    </div>\n    <aside class=\"cgrid__side\">\n      <div class=\"cside\">\n        <p class=\"eyebrow\">Contact information</p>\n        <ul class=\"cside__list\">\n          <li><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6.4 2.8h7.8l4.4 4.4v14H6.4z\"/><path d=\"M14.2 2.8v4.4h4.4M9.4 12h6M9.4 15.2h6M9.4 18.4h3.6\"/></svg></span><div><small>Email</small><a href=\"mailto:info@afsvhcl.com\">info@afsvhcl.com</a></div></li>\n          <li><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.6 18.6h18.8\"/><path d=\"M4 18.6C4 12 7.6 7.4 12 7.4S20 12 20 18.6\"/><path d=\"M8.2 18.6c0-4.8 1.7-8.6 3.8-11.2M15.8 18.6c0-4.8-1.7-8.6-3.8-11.2\"/><path d=\"M4.8 14.2h14.4\"/><path d=\"M10.4 18.6v-2.8h3.2v2.8\"/></svg></span><div><small>Location</small><b>Whitby, Ontario, Canada</b></div></li>\n          <li><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"8.4\" cy=\"6.2\" r=\"2.6\"/><circle cx=\"16.6\" cy=\"9.4\" r=\"2\"/><path d=\"M3.6 20.4v-3.2a4.8 4.8 0 0 1 9.6 0v3.2\"/><path d=\"M13 15.2a3.6 3.6 0 0 1 7.2 1.2v4\"/><path d=\"M11.2 12.4l2.6.8\"/></svg></span><div><small>Primary contact</small><b>Martin Lashley</b><em>Chairman &amp; CEO, AFSVHCL™</em></div></li>\n        </ul>\n        <p class=\"eyebrow\">What to expect</p>\n        <ul class=\"check-list\"><li>A reply within 2–3 business days</li><li>Exploratory, non-binding conversations</li><li>No sales pressure — we’re building relationships</li><li>All discussions are confidential</li></ul>\n      </div>\n      <div class=\"cside cside--light\">\n        <p class=\"eyebrow\">Looking for something specific?</p>\n        <ul class=\"cside__links\">\n          <li><a href=\"{{url:/partners/#partner-form}}\">Partnership &amp; sponsorship <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></li>\n          <li><a href=\"{{url:/membership/#membership-form}}\">Membership interest <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></li>\n          <li><a href=\"{{url:/marketplace/#vendor-form}}\">Become a marketplace vendor <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></li>\n          <li><a href=\"{{url:/service-provider-network/#interest}}\">Service provider network <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></li>\n          <li><a href=\"{{url:/ambassadors/#ambassador-form}}\">Ambassador program <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></li>\n          <li><a href=\"{{url:/accessibility/}}\">Accessibility feedback <span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></li>\n        </ul>\n      </div>\n    </aside>\n  </div>\n</section>"},"elements":[]}]},{"id":"bfae6f13","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"contact.types","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"954e3cd8","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"band--cream\" data-el=\"contact.types\" data-el-build=\"elementor\">\n  <div class=\"wrap section\">\n    \n  <div class=\"section-head reveal \">\n    <p class=\"eyebrow mb-s\">Types of inquiries</p>\n    <h2 class=\"h2\">Who we talk to.</h2>\n    \n  </div>\n    <div class=\"ctypes\" data-stagger>\n      <article class=\"ctype\"><span class=\"ctype__n\">01</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.6 12.4l3.6-4.2 3.6 1.4 2.4-1.4 3.2.4 3.8 3.6\"/><path d=\"M2.6 12.4l3.4 3.2M21.4 12.2l-3.2 3.4\"/><path d=\"M8.6 14.6l1.6 1.6a1.2 1.2 0 0 0 1.7 0l.2-.2M11 13.4l2.4 2.4a1.2 1.2 0 0 0 1.7 0l.6-.6-3.6-3.8\"/></svg></span><h3>Partnership &amp; sponsorship</h3><p>Exploratory discussions about corporate partnerships and institutional collaborations.</p></article><article class=\"ctype\"><span class=\"ctype__n\">02</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 20.4h16\"/><rect x=\"6\" y=\"4\" width=\"12\" height=\"16.4\" rx=\".8\"/><path d=\"M9 7.6h2M13 7.6h2M9 11h2M13 11h2M9 14.4h2M13 14.4h2M10.6 20.4v-3h2.8v3\"/></svg></span><h3>Community &amp; municipal stakeholders</h3><p>Conversations with municipalities, school boards and community organizations.</p></article><article class=\"ctype\"><span class=\"ctype__n\">03</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M12 8.2l3.2 2.3-1.2 3.8h-4l-1.2-3.8z\"/><path d=\"M12 3.4v4.8M15.2 10.5l4.3-1.6M14 14.3l2.7 3.8M10 14.3l-2.7 3.8M8.8 10.5L4.5 8.9\"/></svg></span><h3>Athlete &amp; program interest</h3><p>Keep up to date on proposed future athlete development programs.</p></article><article class=\"ctype\"><span class=\"ctype__n\">04</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"/><path d=\"M3.4 12h17.2\"/><path d=\"M12 3.4c2.4 2.4 3.6 5.2 3.6 8.6s-1.2 6.2-3.6 8.6c-2.4-2.4-3.6-5.2-3.6-8.6s1.2-6.2 3.6-8.6z\"/></svg></span><h3>Diaspora network interest</h3><p>Express interest in the proposed Global Diaspora Network.</p></article><article class=\"ctype\"><span class=\"ctype__n\">05</span><span class=\"kcard__ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"1.8\"/><path d=\"M8.2 15.8a5.4 5.4 0 0 1 0-7.6M15.8 8.2a5.4 5.4 0 0 1 0 7.6M5.4 18.6a9.4 9.4 0 0 1 0-13.2M18.6 5.4a9.4 9.4 0 0 1 0 13.2\"/></svg></span><h3>Media &amp; press</h3><p>Media organizations seeking information about AFSVHCL™.</p></article>\n    </div>\n  </div>\n</section>"},"elements":[]}]},{"id":"89d3ba75","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"Section 