x","size":0,"column":"0","row":"0"}},"elements":[{"id":"ac3dc5e4","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"wrap section section--flush-top\" data-el=\"events.list\" data-el-build=\"custom-widget\">\n  <div class=\"event-list\">\n<article class=\"event event--gaisb\" data-el=\"events.card\" data-el-build=\"custom-widget\">\n  <div class=\"event__date\" aria-hidden=\"true\">\n    <span class=\"event__day\">29</span>\n    <span class=\"event__month\">Apr</span>\n    <span class=\"event__end\">– 1 May 2027</span>\n  </div>\n  <div class=\"event__main\">\n    <p class=\"event__wordmark\"><small>Port of Spain, Trinidad &amp; Tobago · April 29 – May 1, 2027</small></p>\n    <h3 class=\"event__title\"><a href=\"https://gaisb.ai/port-of-spain.html\" target=\"_blank\" rel=\"noopener noreferrer\">GAISB AI World Summit 2027<span class=\"sr-only\"> (opens the summit website in a new tab)</span></a></h3>\n    <p class=\"event__headline\"><span>AI is moving money.</span> The rules are being written now.</p>\n    <ul class=\"event__themes\"><li>Work</li><li>Wealth</li><li>Security</li><li>Nations</li><li>Humanity</li></ul>\n    <p class=\"event__summary\">AI is joining the workforce. Money is going digital. AI agents now connect the two. Three days in Port of Spain for the people shaping what comes next: CEOs and executives, governments and regulators, financial professionals, investors and builders.</p>\n    <p class=\"event__where\"><strong>April 29 – May 1, 2027</strong> · Hyatt Regency Trinidad, Port of Spain, Trinidad &amp; Tobago</p>\n    <div class=\"btn-row btn-row--stack\">\n      <a class=\"btn btn--gold event__cta\" href=\"https://gaisb.ai/port-of-spain.html\" target=\"_blank\" rel=\"noopener noreferrer\">Secure your place<span class=\"sr-only\"> (opens the summit website in a new tab)</span><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></a>\n      <a class=\"btn btn--line-light event__cta2\" href=\"https://gaisb.ai/port-of-spain.html\" target=\"_blank\" rel=\"noopener noreferrer\">See the agenda<span class=\"sr-only\"> (opens in a new tab)</span><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></a>\n    </div>\n    <p class=\"event__host\">Hosted in the Caribbean by AFSV VRC Global Development Group Ltd., Canada.</p>\n  </div>\n  <aside class=\"event__side\">\n    <p class=\"event__side-label\">Summit opens in</p>\n    <div class=\"countdown\" data-countdown=\"2027-04-29T09:00:00-04:00\" role=\"timer\" aria-label=\"Countdown to GAISB AI World Summit 2027\">\n      <div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"days\">--</span><span class=\"countdown__label\">Days</span></div><div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"hours\">--</span><span class=\"countdown__label\">Hours</span></div><div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"mins\">--</span><span class=\"countdown__label\">Minutes</span></div><div class=\"countdown__cell\"><span class=\"countdown__num\" data-unit=\"secs\">--</span><span class=\"countdown__label\">Seconds</span></div>\n    </div>\n    <dl class=\"event__facts\"><div><dt>3 days</dt><dd>of keynotes, roundtables and sessions</dd></div><div><dt>50+</dt><dd>countries expected among delegates</dd></div><div><dt>Jan 31, 2027</dt><dd>speaker submissions close</dd></div></dl>\n  </aside>\n</article></div>\n  <div class=\"pending mt-l\"><span class=\"eyebrow\">More events</span><p>Further events will be listed here as they are confirmed, including program showcases, partner sessions and Whitby Smart Sports Village milestones.</p></div>\n</section>"},"elements":[]}]},{"id":"e877414e","elType":"container","isInner":false,"settings":{"content_width":"full","_title":"cta.band","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"05b39ad6","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"cta-band\" data-el=\"cta.band\" data-el-build=\"elementor\">\n  <div class=\"wrap\">\n    <div class=\"cta-band__inner band--navy\">\n      <span class=\"cta-band__glow\" aria-hidden=\"true\"></span>\n      <h2 class=\"reveal\">Want to host or sponsor an event with us?</h2>\n      <div class=\"btn-row btn-row--stack\"><a class=\"btn btn--gold\" href=\"{{url:/partners/}}\">Talk to the partnerships team<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a><a class=\"btn btn--line-light\" href=\"{{url:/contact/}}\">Contact us<span class=\"arrow\" aria-hidden=\"true\"><svg class=\"icon \" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg></span></a></div>\n    </div>\n  </div>\n</section>"},"elements":[]}]}]}